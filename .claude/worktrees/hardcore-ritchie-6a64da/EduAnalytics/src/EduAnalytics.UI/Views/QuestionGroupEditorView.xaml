<UserControl x:Class="EduAnalytics.UI.Views.QuestionGroupEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:EduAnalytics.UI.ViewModels"
             xmlns:enums="clr-namespace:EduAnalytics.Core.Enums;assembly=EduAnalytics.Core"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             d:DataContext="{d:DesignInstance Type=vm:QuestionGroupEditorViewModel}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006">

    <UserControl.Resources>
        <ObjectDataProvider x:Key="QuestionTypeValues" MethodName="GetValues" ObjectType="{x:Type sys:Enum}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="enums:QuestionType"/>
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Başlık -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="🔗 İlişkili Soru (Common-Stem) Editörü" Style="{StaticResource HeadingStyle}"/>
            <TextBlock TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}">
                Tek bir gövde (tablo, paragraf, vaka, şema) yazın → bu gövdeye bağlı 2 veya daha fazla alt soru ekleyin.
                Sorular soru bankasına bu grup altında kaydedilir; sınav oluştururken birlikte seçilebilir.
            </TextBlock>
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,0,8,0">
            <StackPanel>
                <!-- Ders + Gövde -->
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="1) Ders ve Gövde" Style="{StaticResource SubheadingStyle}"/>

                        <TextBlock Text="Ders" FontWeight="SemiBold" Margin="0,8,0,4"/>
                        <ComboBox ItemsSource="{Binding Courses}"
                                  SelectedItem="{Binding SelectedCourse}"
                                  DisplayMemberPath="Name"
                                  Padding="8,6"
                                  Margin="0,0,0,12"/>

                        <TextBlock Text="Gövde Metni (paragraf / tablo / vaka açıklaması)"
                                   FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding StemText, UpdateSourceTrigger=PropertyChanged}"
                                 AcceptsReturn="True" TextWrapping="Wrap"
                                 MinHeight="120" Padding="8,6" FontFamily="Consolas" FontSize="13"/>

                        <TextBlock Text="Görsel / Şema (opsiyonel)" FontWeight="SemiBold" Margin="0,12,0,4"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0"
                                     Text="{Binding MediaPath}"
                                     IsReadOnly="True"
                                     Padding="8,6"
                                     Background="#F9FAFB"/>
                            <Button Grid.Column="1"
                                    Content="📁 Seç"
                                    Command="{Binding BrowseMediaCommand}"
                                    Padding="14,6" Margin="8,0,0,0"
                                    Background="{StaticResource PrimaryBrush}"
                                    Foreground="White"
                                    BorderThickness="0" Cursor="Hand"/>
                            <Button Grid.Column="2"
                                    Content="✕"
                                    Command="{Binding ClearMediaCommand}"
                                    Padding="10,6" Margin="4,0,0,0"
                                    Background="Transparent"
                                    Foreground="{StaticResource DangerBrush}"
                                    BorderBrush="{StaticResource DangerBrush}"
                                    BorderThickness="1" Cursor="Hand"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Alt sorular -->
                <Border Style="{StaticResource CardStyle}" Margin="0,16,0,0">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="2) Alt Sorular" Style="{StaticResource SubheadingStyle}"/>
                            <Button Grid.Column="1"
                                    Content="+ Alt Soru Ekle"
                                    Command="{Binding AddSubQuestionCommand}"
                                    Background="{StaticResource SuccessBrush}"
                                    Foreground="White"
                                    Padding="14,6"
                                    BorderThickness="0"
                                    Cursor="Hand"
                                    FontWeight="SemiBold"/>
                        </Grid>

                        <Border Background="#FEF3C7" CornerRadius="4" Padding="10,6" Margin="0,8,0,12"
                                Visibility="{Binding SubQuestions.Count, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}">
                            <TextBlock Foreground="#92400E" FontSize="12">
                                ℹ Alt soru eklemek için yukarıdaki butona tıklayın. En az 2 alt soru gerekli.
                            </TextBlock>
                        </Border>

                        <ItemsControl ItemsSource="{Binding SubQuestions}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                            CornerRadius="6" Padding="14" Margin="0,0,0,12"
                                            Background="#FAFAFA">
                                        <StackPanel>
                                            <Grid Margin="0,0,0,8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="16"/>
                                                    <ColumnDefinition Width="120"/>
                                                    <ColumnDefinition Width="16"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" VerticalAlignment="Center" FontWeight="Bold"
                                                           Foreground="{StaticResource PrimaryBrush}">
                                                    <Run Text="Alt Soru"/>
                                                    <Run Text="{Binding QuestionNumber}"/>
                                                </TextBlock>

                                                <ComboBox Grid.Column="2"
                                                          ItemsSource="{Binding Source={StaticResource QuestionTypeValues}}"
                                                          SelectedItem="{Binding Type}"
                                                          Padding="6,4"/>

                                                <TextBox Grid.Column="4"
                                                         Text="{Binding MaxPoints, UpdateSourceTrigger=PropertyChanged}"
                                                         Padding="6,4"
                                                         Width="60"
                                                         HorizontalAlignment="Left"/>

                                                <Button Grid.Column="5"
                                                        Content="✕"
                                                        Command="{Binding DataContext.RemoveSubQuestionCommand,
                                                                  RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"
                                                        Background="Transparent"
                                                        Foreground="{StaticResource DangerBrush}"
                                                        BorderBrush="{StaticResource DangerBrush}"
                                                        BorderThickness="1"
                                                        Padding="10,3" Cursor="Hand"/>
                                            </Grid>

                                            <TextBlock Text="Soru Metni" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                            <TextBox Text="{Binding QuestionText, UpdateSourceTrigger=PropertyChanged}"
                                                     AcceptsReturn="True" TextWrapping="Wrap"
                                                     MinHeight="50" Padding="6,4"/>

                                            <!-- Test ise şıklar -->
                                            <StackPanel Visibility="{Binding IsMultipleChoice, Converter={StaticResource BoolToVisibility}}">
                                                <TextBlock Text="Şıklar" FontWeight="SemiBold" Margin="0,8,0,4"/>
                                                <Grid Margin="0,0,0,4">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="20"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="8"/>
                                                        <ColumnDefinition Width="20"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="A" FontWeight="Bold" VerticalAlignment="Center"/>
                                                    <TextBox Grid.Column="1" Text="{Binding OptionA, UpdateSourceTrigger=PropertyChanged}" Padding="4,3"/>
                                                    <TextBlock Grid.Column="3" Text="B" FontWeight="Bold" VerticalAlignment="Center"/>
                                                    <TextBox Grid.Column="4" Text="{Binding OptionB, UpdateSourceTrigger=PropertyChanged}" Padding="4,3"/>
                                                </Grid>
                                                <Grid Margin="0,4,0,4">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="20"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="8"/>
                                                        <ColumnDefinition Width="20"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="C" FontWeight="Bold" VerticalAlignment="Center"/>
                                                    <TextBox Grid.Column="1" Text="{Binding OptionC, UpdateSourceTrigger=PropertyChanged}" Padding="4,3"/>
                                                    <TextBlock Grid.Column="3" Text="D" FontWeight="Bold" VerticalAlignment="Center"/>
                                                    <TextBox Grid.Column="4" Text="{Binding OptionD, UpdateSourceTrigger=PropertyChanged}" Padding="4,3"/>
                                                </Grid>
                                                <Grid Margin="0,0,0,8">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="20"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="E" FontWeight="Bold" VerticalAlignment="Center"/>
                                                    <TextBox Grid.Column="1" Text="{Binding OptionE, UpdateSourceTrigger=PropertyChanged}" Padding="4,3"/>
                                                </Grid>

                                                <TextBlock Text="Doğru Şık" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                                <StackPanel Orientation="Horizontal">
                                                    <RadioButton Content="A" Margin="0,0,12,0" FontWeight="Bold"
                                                                 IsChecked="{Binding CorrectOption, Converter={StaticResource EnumEquals}, ConverterParameter=A}"/>
                                                    <RadioButton Content="B" Margin="0,0,12,0" FontWeight="Bold"
                                                                 IsChecked="{Binding CorrectOption, Converter={StaticResource EnumEquals}, ConverterParameter=B}"/>
                                                    <RadioButton Content="C" Margin="0,0,12,0" FontWeight="Bold"
                                                                 IsChecked="{Binding CorrectOption, Converter={StaticResource EnumEquals}, ConverterParameter=C}"/>
                                                    <RadioButton Content="D" Margin="0,0,12,0" FontWeight="Bold"
                                                                 IsChecked="{Binding CorrectOption, Converter={StaticResource EnumEquals}, ConverterParameter=D}"/>
                                                    <RadioButton Content="E" Margin="0,0,12,0" FontWeight="Bold"
                                                                 IsChecked="{Binding CorrectOption, Converter={StaticResource EnumEquals}, ConverterParameter=E}"/>
                                                </StackPanel>
                                            </StackPanel>

                                            <!-- Klasik ise cevap anahtarı -->
                                            <StackPanel Visibility="{Binding IsOpenEnded, Converter={StaticResource BoolToVisibility}}">
                                                <TextBlock Text="Cevap Anahtarı / Notlandırma" FontWeight="SemiBold" Margin="0,8,0,4"/>
                                                <TextBox Text="{Binding AnswerKey, UpdateSourceTrigger=PropertyChanged}"
                                                         AcceptsReturn="True" TextWrapping="Wrap"
                                                         MinHeight="50" Padding="6,4"/>
                                            </StackPanel>

                                            <!-- Konu seçimi (Validate'in en az 1 konu beklemesi için) -->
                                            <TextBlock Text="Konu" FontWeight="SemiBold" Margin="0,8,0,4"/>
                                            <Grid Margin="0,0,0,4">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <ComboBox Grid.Column="0"
                                                          ItemsSource="{Binding AvailableTopics}"
                                                          SelectedItem="{Binding TopicToAdd}"
                                                          Padding="6,4">
                                                    <ComboBox.ItemTemplate>
                                                        <DataTemplate>
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock Text="H"/>
                                                                <TextBlock Text="{Binding WeekNumber}"/>
                                                                <TextBlock Text=" — "/>
                                                                <TextBlock Text="{Binding Title}"/>
                                                            </StackPanel>
                                                        </DataTemplate>
                                                    </ComboBox.ItemTemplate>
                                                </ComboBox>
                                                <Button Grid.Column="1"
                                                        Content="+ Ekle"
                                                        Command="{Binding AddTopicCommand}"
                                                        Background="{StaticResource SuccessBrush}"
                                                        Foreground="White"
                                                        Padding="10,4" Margin="6,0,0,0"
                                                        BorderThickness="0" Cursor="Hand" FontSize="11"/>
                                            </Grid>
                                            <ItemsControl ItemsSource="{Binding SelectedTopics}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <WrapPanel/>
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Background="#DBEAFE" CornerRadius="4"
                                                                Padding="6,3" Margin="0,0,4,4">
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock Foreground="#1E3A8A" FontSize="11">
                                                                    <Run Text="H"/>
                                                                    <Run Text="{Binding WeekNumber}"/>
                                                                    <Run Text=" "/>
                                                                    <Run Text="{Binding Title}"/>
                                                                </TextBlock>
                                                                <Button Content="×"
                                                                        Command="{Binding DataContext.RemoveTopicCommand,
                                                                                  RelativeSource={RelativeSource AncestorType=Border, AncestorLevel=2}}"
                                                                        CommandParameter="{Binding}"
                                                                        Background="Transparent"
                                                                        BorderThickness="0"
                                                                        Foreground="#1E3A8A"
                                                                        Margin="4,0,0,0"
                                                                        Padding="2,0"
                                                                        Cursor="Hand"/>
                                                            </StackPanel>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Alt çubuk: hata + kaydet -->
        <Border Grid.Row="2" Background="White" BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,1,0,0" Padding="0,12,0,0" Margin="0,12,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <Border Background="#FEE2E2" BorderBrush="{StaticResource DangerBrush}" BorderThickness="1"
                            CornerRadius="4" Padding="12,8"
                            Visibility="{Binding ErrorMessage, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="{Binding ErrorMessage}" Foreground="#991B1B" TextWrapping="Wrap"/>
                    </Border>
                    <Border Background="#D1FAE5" BorderBrush="{StaticResource SuccessBrush}" BorderThickness="1"
                            CornerRadius="4" Padding="12,8"
                            Visibility="{Binding SuccessMessage, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="{Binding SuccessMessage}" Foreground="#064E3B" TextWrapping="Wrap"/>
                    </Border>
                </StackPanel>

                <Button Grid.Column="1"
                        Content="💾 Common-Stem Grubu Kaydet"
                        Command="{Binding SaveCommand}"
                        Background="{StaticResource PrimaryBrush}"
                        Foreground="White"
                        Padding="24,12"
                        FontSize="14" FontWeight="SemiBold"
                        BorderThickness="0"
                        Cursor="Hand"
                        Margin="16,0,0,0"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
