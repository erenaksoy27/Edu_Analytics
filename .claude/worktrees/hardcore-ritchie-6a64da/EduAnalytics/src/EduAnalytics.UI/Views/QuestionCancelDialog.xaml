<Window x:Class="EduAnalytics.UI.Views.QuestionCancelDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Soruyu İptal Et"
        Height="280" Width="500"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{StaticResource PageBgBrush}">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="🚫 Soruyu İptal Et"
                   FontSize="20" FontWeight="Bold"
                   Foreground="{StaticResource DangerBrush}"
                   Margin="0,0,0,8"/>

        <TextBlock Grid.Row="1"
                   x:Name="QuestionInfoText"
                   TextWrapping="Wrap"
                   Foreground="{StaticResource TextSecondaryBrush}"
                   Margin="0,0,0,12"/>

        <StackPanel Grid.Row="2">
            <TextBlock Text="İptal Sebebi (opsiyonel)" FontWeight="SemiBold" Margin="0,0,0,4"/>
            <TextBox x:Name="ReasonBox"
                     AcceptsReturn="True" TextWrapping="Wrap"
                     Padding="8,6" MinHeight="60"
                     VerticalContentAlignment="Top"/>
            <TextBlock Margin="0,8,0,0" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap">
                ℹ İptal edilen soru analizden hariç tutulur. Tüm öğrencilerin bu sorudaki cevabı puanlamaya dahil edilmez.
            </TextBlock>
        </StackPanel>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Vazgeç"
                    Click="OnCancelClick"
                    Background="#F3F4F6"
                    Foreground="{StaticResource TextSecondaryBrush}"
                    Padding="20,8"
                    BorderThickness="0"
                    Margin="0,0,8,0"
                    Cursor="Hand"/>
            <Button Content="🚫 Soruyu İptal Et"
                    Click="OnConfirmClick"
                    Background="{StaticResource DangerBrush}"
                    Foreground="White"
                    Padding="20,8"
                    BorderThickness="0"
                    Cursor="Hand"
                    FontWeight="SemiBold"
                    IsDefault="True"/>
        </StackPanel>
    </Grid>
</Window>
