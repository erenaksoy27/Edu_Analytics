<UserControl x:Class="EduAnalytics.UI.Views.AnswerEntryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:EduAnalytics.UI.ViewModels"
             d:DataContext="{d:DesignInstance Type=vm:AnswerEntryViewModel}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- BAŞLIK -->
        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Cevap Girişi" Style="{StaticResource HeadingStyle}"/>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding ExamTitle}"
                                   FontWeight="SemiBold" FontSize="15"
                                   Foreground="{StaticResource PrimaryBrush}"/>
                        <TextBlock Text=" · " Foreground="{StaticResource TextSecondaryBrush}"/>
                        <TextBlock Text="{Binding CourseName}"
                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="💾 Excel İndir"
                            Command="{Binding DownloadExcelCommand}"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Margin="0,0,8,0"
                            ToolTip="Boş cevap şablonunu Excel olarak indir"/>
                    <Button Content="📤 Excel Yükle"
                            Command="{Binding ImportExcelCommand}"
                            Style="{StaticResource PrimaryButtonStyle}"
                            ToolTip="Doldurulmuş Excel dosyasını sisteme yükle"/>
                </StackPanel>
            </Grid>
        </StackPanel>

        <!-- BİLGİ BANDı -->
        <Border Grid.Row="1" Background="#DBEAFE" CornerRadius="6" Padding="12,8" Margin="0,0,0,12">
            <TextBlock Foreground="#1E3A8A" FontSize="12">
                <Run Text="💡 İpuçları:"/>
                <Run FontWeight="Bold" Text=" Tab"/>
                <Run Text="→ sağa,"/>
                <Run FontWeight="Bold" Text="Enter"/>
                <Run Text="→ alta geçer. Test: A/B/C/D/Boş,"/>
                <Run Text="Klasik: 0 ile MaxPuan arası sayı girin."/>
                <Run Text="Bitince"/>
                <Run FontWeight="Bold" Text="💾 Kaydet"/>
                <Run Text="butonuna basın."/>
            </TextBlock>
        </Border>

        <!-- DATAGRID (kolonlar dinamik) -->
        <Border Grid.Row="2" Style="{StaticResource CardStyle}" Margin="0" Padding="0">
            <DataGrid x:Name="AnswersGrid"
                      ItemsSource="{Binding StudentRows}"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      GridLinesVisibility="All"
                      HeadersVisibility="Column"
                      RowHeight="36"
                      FrozenColumnCount="2"
                      HorizontalGridLinesBrush="{StaticResource BorderBrush}"
                      VerticalGridLinesBrush="{StaticResource BorderBrush}"
                      Background="Transparent"
                      BorderThickness="0"
                      EnableRowVirtualization="True"
                      EnableColumnVirtualization="True"/>
        </Border>

        <!-- ALT BAR: MESAJLAR + KAYDET -->
        <Border Grid.Row="3" Padding="0,12,0,0" Margin="0,12,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="#FEE2E2"
                        BorderBrush="{StaticResource DangerBrush}" BorderThickness="1"
                        CornerRadius="4" Padding="12,8" VerticalAlignment="Center"
                        Visibility="{Binding ErrorMessage, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="{Binding ErrorMessage}" Foreground="#991B1B" TextWrapping="Wrap"/>
                </Border>

                <Border Grid.Column="0" Background="#D1FAE5"
                        BorderBrush="{StaticResource SuccessBrush}" BorderThickness="1"
                        CornerRadius="4" Padding="12,8" VerticalAlignment="Center"
                        Visibility="{Binding SuccessMessage, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="{Binding SuccessMessage}" Foreground="#064E3B" TextWrapping="Wrap"/>
                </Border>

                <Button Grid.Column="1"
                        Content="💾 Kaydet"
                        Command="{Binding SaveCommand}"
                        Background="{StaticResource PrimaryBrush}"
                        Foreground="White"
                        Padding="24,12"
                        FontSize="14" FontWeight="SemiBold"
                        BorderThickness="0"
                        Cursor="Hand"
                        Margin="16,0,0,0"/>
            </Grid>
        </Border>

        <!-- Yükleme overlay -->
        <Border Grid.Row="0" Grid.RowSpan="4"
                Background="#80FFFFFF"
                Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}">
            <TextBlock Text="Yükleniyor..." HorizontalAlignment="Center" VerticalAlignment="Center"
                       FontSize="18" Foreground="{StaticResource PrimaryBrush}"/>
        </Border>
    </Grid>
</UserControl>
