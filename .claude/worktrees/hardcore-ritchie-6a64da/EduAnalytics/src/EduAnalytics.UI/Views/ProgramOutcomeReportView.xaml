<UserControl x:Class="EduAnalytics.UI.Views.ProgramOutcomeReportView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:EduAnalytics.UI.ViewModels"
             d:DataContext="{d:DesignInstance Type=vm:ProgramOutcomeReportViewModel}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="Program Çıktısı Başarı Raporu" Style="{StaticResource HeadingStyle}"/>
            <TextBlock Text="PÇ → ÖÇ → Soru hiyerarşisinde sınavlardaki başarı oranları."
                       Foreground="{StaticResource TextSecondaryBrush}"/>
        </StackPanel>

        <Border Grid.Row="1" Style="{StaticResource CardStyle}" Padding="16">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Program:" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,8,0"/>
                <ComboBox ItemsSource="{Binding Programs}"
                          SelectedItem="{Binding SelectedProgram}"
                          DisplayMemberPath="Name"
                          Width="280" Padding="8,6"/>
                <Button Content="🔄 Raporu Yenile"
                        Command="{Binding GenerateReportCommand}"
                        Background="{StaticResource PrimaryBrush}"
                        Foreground="White"
                        Padding="14,6"
                        BorderThickness="0"
                        Margin="12,0,0,0"
                        Cursor="Hand"
                        FontWeight="SemiBold"/>
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Reports}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource CardStyle}" Padding="20">
                            <StackPanel>
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="100"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0" Background="#FCE7F3" CornerRadius="6" Padding="10,6"
                                            HorizontalAlignment="Left">
                                        <TextBlock Text="{Binding ProgramOutcomeCode}"
                                                   Foreground="#831843" FontWeight="Bold" FontSize="16"/>
                                    </Border>

                                    <TextBlock Grid.Column="1"
                                               Text="{Binding ProgramOutcomeDescription}"
                                               TextWrapping="Wrap"
                                               VerticalAlignment="Center"
                                               Margin="12,0"
                                               FontSize="14" FontWeight="SemiBold"/>

                                    <StackPanel Grid.Column="2" HorizontalAlignment="Right">
                                        <TextBlock Style="{StaticResource MetricValueStyle}"
                                                   Foreground="{StaticResource SuccessBrush}"
                                                   HorizontalAlignment="Right">
                                            <Run Text="%"/>
                                            <Run Text="{Binding OverallSuccessRate}"/>
                                        </TextBlock>
                                        <TextBlock Style="{StaticResource MetricLabelStyle}"
                                                   Text="GENEL BAŞARI"
                                                   HorizontalAlignment="Right"/>
                                    </StackPanel>
                                </Grid>

                                <Border Background="#F9FAFB" CornerRadius="6" Padding="12">
                                    <StackPanel>
                                        <TextBlock Text="Bağlı Ders Çıktıları (ÖÇ)" FontWeight="SemiBold" Margin="0,0,0,8"/>

                                        <ItemsControl ItemsSource="{Binding LinkedLearningOutcomes}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border BorderBrush="{StaticResource BorderBrush}"
                                                            BorderThickness="0,0,0,1"
                                                            Padding="0,8">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="80"/>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="80"/>
                                                                <ColumnDefinition Width="60"/>
                                                                <ColumnDefinition Width="80"/>
                                                            </Grid.ColumnDefinitions>

                                                            <Border Grid.Column="0" Background="#DBEAFE" CornerRadius="4" Padding="6,2"
                                                                    HorizontalAlignment="Left">
                                                                <TextBlock Text="{Binding Code}" Foreground="#1E3A8A" FontWeight="SemiBold" FontSize="11"/>
                                                            </Border>

                                                            <StackPanel Grid.Column="1" Margin="8,0">
                                                                <TextBlock Text="{Binding Name}" FontSize="13"/>
                                                                <TextBlock Text="{Binding CourseName}"
                                                                           FontSize="10"
                                                                           Foreground="{StaticResource TextSecondaryBrush}"/>
                                                            </StackPanel>

                                                            <TextBlock Grid.Column="2" FontSize="11"
                                                                       VerticalAlignment="Center"
                                                                       Foreground="{StaticResource TextSecondaryBrush}">
                                                                <Run Text="Katkı:"/>
                                                                <Run Text="{Binding ContributionLevel}"/>
                                                                <Run Text="/5"/>
                                                            </TextBlock>

                                                            <TextBlock Grid.Column="3" FontSize="11"
                                                                       VerticalAlignment="Center"
                                                                       Foreground="{StaticResource TextSecondaryBrush}">
                                                                <Run Text="{Binding QuestionCount}"/>
                                                                <Run Text="soru"/>
                                                            </TextBlock>

                                                            <TextBlock Grid.Column="4" VerticalAlignment="Center"
                                                                       FontWeight="Bold" FontSize="14"
                                                                       Foreground="{StaticResource SuccessBrush}"
                                                                       HorizontalAlignment="Right">
                                                                <Run Text="%"/>
                                                                <Run Text="{Binding SuccessRate}"/>
                                                            </TextBlock>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <Border Grid.RowSpan="3" Background="#80FFFFFF"
                Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}">
            <TextBlock Text="Rapor üretiliyor..." HorizontalAlignment="Center" VerticalAlignment="Center"
                       FontSize="18" Foreground="{StaticResource PrimaryBrush}"/>
        </Border>
    </Grid>
</UserControl>
