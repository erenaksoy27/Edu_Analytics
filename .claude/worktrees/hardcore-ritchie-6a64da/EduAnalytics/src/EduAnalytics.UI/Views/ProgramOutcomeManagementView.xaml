<UserControl x:Class="EduAnalytics.UI.Views.ProgramOutcomeManagementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:EduAnalytics.UI.ViewModels"
             d:DataContext="{d:DesignInstance Type=vm:ProgramOutcomeManagementViewModel}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="Program Çıktısı (PÇ) Yönetimi" Style="{StaticResource HeadingStyle}"/>
            <TextBlock Text="Programınızın mezunundan beklenen yetkinlikleri tanımlayın. ÖÇ'ler bu PÇ'lere katkı sağlar."
                       Foreground="{StaticResource TextSecondaryBrush}"/>
        </StackPanel>

        <Border Grid.Row="1" Style="{StaticResource CardStyle}">
            <StackPanel>
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Program" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <ComboBox ItemsSource="{Binding Programs}"
                                  SelectedItem="{Binding SelectedProgram}"
                                  DisplayMemberPath="Name"
                                  Padding="8,6"/>
                    </StackPanel>
                    <Button Grid.Column="1"
                            Content="+ Yeni PÇ"
                            Command="{Binding StartNewCommand}"
                            Background="{StaticResource PrimaryBrush}"
                            Foreground="White"
                            Padding="16,8"
                            BorderThickness="0"
                            VerticalAlignment="Bottom"
                            Margin="12,0,0,0"
                            Cursor="Hand"
                            FontWeight="SemiBold"/>
                </Grid>

                <Border Background="#F9FAFB" CornerRadius="6" Padding="16">
                    <StackPanel>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Kod (örn. PÇ-1)" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                <TextBox Text="{Binding FormCode, UpdateSourceTrigger=PropertyChanged}" Padding="8,6"/>
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="Açıklama" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding FormDescription, UpdateSourceTrigger=PropertyChanged}"
                                 AcceptsReturn="True" TextWrapping="Wrap"
                                 MinHeight="60" Padding="8,6"/>

                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0" HorizontalAlignment="Right">
                            <Button Content="İptal"
                                    Command="{Binding StartNewCommand}"
                                    Background="#F3F4F6"
                                    Foreground="{StaticResource TextSecondaryBrush}"
                                    Padding="16,8"
                                    BorderThickness="0"
                                    Margin="0,0,8,0"
                                    Cursor="Hand"/>
                            <Button Content="💾 Kaydet"
                                    Command="{Binding SaveCommand}"
                                    Background="{StaticResource SuccessBrush}"
                                    Foreground="White"
                                    Padding="20,8"
                                    BorderThickness="0"
                                    Cursor="Hand"
                                    FontWeight="SemiBold"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Background="#FEE2E2" BorderBrush="{StaticResource DangerBrush}" BorderThickness="1"
                        CornerRadius="4" Padding="12,8" Margin="0,12,0,0"
                        Visibility="{Binding ErrorMessage, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="{Binding ErrorMessage}" Foreground="#991B1B" TextWrapping="Wrap"/>
                </Border>
                <Border Background="#D1FAE5" BorderBrush="{StaticResource SuccessBrush}" BorderThickness="1"
                        CornerRadius="4" Padding="12,8" Margin="0,12,0,0"
                        Visibility="{Binding SuccessMessage, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="{Binding SuccessMessage}" Foreground="#064E3B" TextWrapping="Wrap"/>
                </Border>
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding ProgramOutcomes}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource CardStyle}" Padding="16">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="80"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" Background="#FCE7F3" CornerRadius="6" Padding="8,6"
                                        VerticalAlignment="Top" HorizontalAlignment="Left">
                                    <TextBlock Text="{Binding Code}" Foreground="#831843"
                                               FontWeight="Bold" FontSize="14"/>
                                </Border>

                                <StackPanel Grid.Column="1" Margin="12,0">
                                    <TextBlock Text="{Binding Description}" TextWrapping="Wrap" FontSize="14"/>
                                    <TextBlock Margin="0,6,0,0" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}">
                                        <Run Text="🔗"/>
                                        <Run Text="{Binding LearningOutcomeCount}"/>
                                        <Run Text="ÖÇ ile eşlenmiş"/>
                                    </TextBlock>
                                </StackPanel>

                                <Button Grid.Column="2"
                                        Content="✏ Düzenle"
                                        Command="{Binding DataContext.StartEditCommand,
                                                  RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}"
                                        Background="#F3F4F6"
                                        Foreground="{StaticResource PrimaryBrush}"
                                        Padding="12,6"
                                        BorderBrush="{StaticResource PrimaryBrush}"
                                        BorderThickness="1"
                                        Margin="0,0,6,0"
                                        Cursor="Hand"
                                        FontWeight="SemiBold"/>

                                <Button Grid.Column="3"
                                        Content="🗑"
                                        Command="{Binding DataContext.DeleteCommand,
                                                  RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}"
                                        Background="Transparent"
                                        BorderBrush="{StaticResource DangerBrush}"
                                        BorderThickness="1"
                                        Foreground="{StaticResource DangerBrush}"
                                        Padding="10,6"
                                        Cursor="Hand"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <Border Grid.RowSpan="3" Background="#80FFFFFF"
                Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}">
            <TextBlock Text="Yükleniyor..." HorizontalAlignment="Center" VerticalAlignment="Center"
                       FontSize="18" Foreground="{StaticResource PrimaryBrush}"/>
        </Border>
    </Grid>
</UserControl>
