<Window x:Class="EduAnalytics.UI.Views.RubricGradeDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:EduAnalytics.UI.ViewModels"
        d:DataContext="{d:DesignInstance Type=vm:RubricGradeDialogViewModel}"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        mc:Ignorable="d"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        Title="Klasik Soru — Detaylı Puanlama"
        Height="600" Width="780"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource PageBgBrush}">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="📋 Detaylı Puanlama (Rubric)"
                       FontSize="20" FontWeight="Bold"
                       Foreground="{StaticResource PrimaryBrush}"/>
            <TextBlock Text="{Binding StudentTitle}"
                       FontSize="13"
                       Foreground="{StaticResource TextSecondaryBrush}"
                       Margin="0,4,0,0"/>
            <TextBlock Text="{Binding QuestionTitle}"
                       FontSize="12"
                       Foreground="{StaticResource TextSecondaryBrush}"
                       TextWrapping="Wrap"
                       Margin="0,2,0,0"/>
        </StackPanel>

        <Border Grid.Row="1" Background="#F0F9FF" BorderBrush="#0EA5E9" BorderThickness="1"
                CornerRadius="6" Padding="14" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="TOPLAM PUAN" Style="{StaticResource MetricLabelStyle}"/>
                    <TextBlock Style="{StaticResource MetricValueStyle}" Foreground="#0C4A6E">
                        <Run Text="{Binding TotalScore, Mode=OneWay}"/>
                        <Run Text=" / "/>
                        <Run Text="{Binding MaxTotalScore, Mode=OneWay}"/>
                    </TextBlock>
                </StackPanel>
                <TextBlock Grid.Column="1" VerticalAlignment="Center" Margin="20,0,0,0"
                           Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap">
                    Her kritere ayrı puan girin. Toplam otomatik hesaplanır ve öğrencinin Score'una yansır.
                </TextBlock>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Rows}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource CardStyle}" Padding="14" Margin="0,0,0,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="120"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0"
                                           Text="{Binding Title}"
                                           FontSize="14" FontWeight="SemiBold"/>

                                <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                                    <TextBox Text="{Binding Score, UpdateSourceTrigger=PropertyChanged, StringFormat=N1}"
                                             Width="60" Padding="6,4"
                                             FontWeight="SemiBold" FontSize="14"
                                             HorizontalContentAlignment="Center"
                                             VerticalContentAlignment="Center"/>
                                    <TextBlock VerticalAlignment="Center" Margin="6,0,0,0"
                                               Foreground="{StaticResource TextSecondaryBrush}" FontSize="13">
                                        <Run Text="/ "/>
                                        <Run Text="{Binding MaxPoints}"/>
                                    </TextBlock>
                                </StackPanel>

                                <TextBox Grid.Row="1" Grid.ColumnSpan="2"
                                         Text="{Binding Comment, UpdateSourceTrigger=PropertyChanged}"
                                         AcceptsReturn="True" TextWrapping="Wrap"
                                         MinHeight="40"
                                         Padding="6,4" Margin="0,8,0,0"
                                         Background="#F9FAFB"
                                         FontSize="12">
                                    <TextBox.Style>
                                        <Style TargetType="TextBox">
                                            <Setter Property="VerticalContentAlignment" Value="Top"/>
                                        </Style>
                                    </TextBox.Style>
                                </TextBox>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <StackPanel Grid.Row="3" Margin="0,8,0,0">
            <Border Background="#FEE2E2" BorderBrush="{StaticResource DangerBrush}" BorderThickness="1"
                    CornerRadius="4" Padding="10,6"
                    Visibility="{Binding ErrorMessage, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="{Binding ErrorMessage}" Foreground="#991B1B" TextWrapping="Wrap"/>
            </Border>
            <Border Background="#D1FAE5" BorderBrush="{StaticResource SuccessBrush}" BorderThickness="1"
                    CornerRadius="4" Padding="10,6"
                    Visibility="{Binding SuccessMessage, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="{Binding SuccessMessage}" Foreground="#064E3B" TextWrapping="Wrap"/>
            </Border>
        </StackPanel>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Kapat"
                    Click="OnCloseClick"
                    Background="#F3F4F6"
                    Foreground="{StaticResource TextSecondaryBrush}"
                    Padding="20,8"
                    BorderThickness="0"
                    Margin="0,0,8,0"
                    Cursor="Hand"/>
            <Button Content="💾 Kaydet"
                    Command="{Binding SaveCommand}"
                    Background="{StaticResource PrimaryBrush}"
                    Foreground="White"
                    Padding="24,8"
                    BorderThickness="0"
                    Cursor="Hand"
                    FontWeight="SemiBold"
                    IsDefault="True"/>
        </StackPanel>
    </Grid>
</Window>
