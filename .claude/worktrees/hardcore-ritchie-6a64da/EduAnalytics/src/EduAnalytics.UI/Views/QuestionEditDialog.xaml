<Window x:Class="EduAnalytics.UI.Views.QuestionEditDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:EduAnalytics.UI.ViewModels"
        xmlns:enums="clr-namespace:EduAnalytics.Core.Enums;assembly=EduAnalytics.Core"
        d:DataContext="{d:DesignInstance Type=vm:QuestionEditDialogViewModel}"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        mc:Ignorable="d"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        Title="Soruyu Düzenle"
        Height="640" Width="640"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource PageBgBrush}"
        ResizeMode="CanResize">

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20">
        <StackPanel>

            <TextBlock Text="Soruyu Düzenle"
                       FontSize="20" FontWeight="Bold"
                       Foreground="{StaticResource TextPrimaryBrush}"
                       Margin="0,0,0,16"/>

            <!-- Tür + Puan -->
            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="120"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="Tür" FontWeight="SemiBold" Margin="0,0,0,4"/>
                    <ComboBox SelectedItem="{Binding Type}" Padding="8,6">
                        <ComboBox.Items>
                            <x:Static Member="enums:QuestionType.MultipleChoice"/>
                            <x:Static Member="enums:QuestionType.OpenEnded"/>
                        </ComboBox.Items>
                    </ComboBox>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="Puan" FontWeight="SemiBold" Margin="0,0,0,4"/>
                    <TextBox Text="{Binding MaxPoints, UpdateSourceTrigger=PropertyChanged}" Padding="8,6"/>
                </StackPanel>
            </Grid>

            <!-- Soru metni -->
            <TextBlock Text="Soru Metni" FontWeight="SemiBold" Margin="0,0,0,4"/>
            <TextBox Text="{Binding QuestionText, UpdateSourceTrigger=PropertyChanged}"
                     Padding="8,6" Margin="0,0,0,12"
                     AcceptsReturn="True"
                     TextWrapping="Wrap"
                     MinHeight="80" VerticalScrollBarVisibility="Auto"/>

            <!-- Test bölümü -->
            <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0"
                    Margin="0,8,0,12" Padding="0,12,0,0"
                    Visibility="{Binding IsMultipleChoice, Converter={StaticResource BoolToVisibility}}">
                <StackPanel>
                    <TextBlock Text="Şıklar" FontWeight="SemiBold" Margin="0,0,0,8"/>

                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="40"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="A" FontWeight="Bold" VerticalAlignment="Center"/>
                        <TextBox Grid.Column="1" Text="{Binding OptionA, UpdateSourceTrigger=PropertyChanged}" Padding="8,6"/>
                    </Grid>
                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="40"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="B" FontWeight="Bold" VerticalAlignment="Center"/>
                        <TextBox Grid.Column="1" Text="{Binding OptionB, UpdateSourceTrigger=PropertyChanged}" Padding="8,6"/>
                    </Grid>
                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="40"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="C" FontWeight="Bold" VerticalAlignment="Center"/>
                        <TextBox Grid.Column="1" Text="{Binding OptionC, UpdateSourceTrigger=PropertyChanged}" Padding="8,6"/>
                    </Grid>
                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="40"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="D" FontWeight="Bold" VerticalAlignment="Center"/>
                        <TextBox Grid.Column="1" Text="{Binding OptionD, UpdateSourceTrigger=PropertyChanged}" Padding="8,6"/>
                    </Grid>
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="40"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="E" FontWeight="Bold" VerticalAlignment="Center"/>
                        <TextBox Grid.Column="1" Text="{Binding OptionE, UpdateSourceTrigger=PropertyChanged}" Padding="8,6"/>
                    </Grid>

                    <TextBlock Text="Doğru Şık" FontWeight="SemiBold" Margin="0,0,0,4"/>
                    <ComboBox ItemsSource="{Binding AvailableOptions}"
                              SelectedItem="{Binding CorrectOption}"
                              Padding="8,6"/>
                </StackPanel>
            </Border>

            <!-- Klasik bölümü -->
            <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0"
                    Margin="0,8,0,12" Padding="0,12,0,0"
                    Visibility="{Binding IsOpenEnded, Converter={StaticResource BoolToVisibility}}">
                <StackPanel>
                    <TextBlock Text="Cevap Anahtarı / Notlandırma Rehberi" FontWeight="SemiBold" Margin="0,0,0,4"/>
                    <TextBox Text="{Binding AnswerKey, UpdateSourceTrigger=PropertyChanged}"
                             AcceptsReturn="True" TextWrapping="Wrap"
                             MinHeight="80" Padding="8,6"
                             VerticalScrollBarVisibility="Auto"/>
                </StackPanel>
            </Border>

            <!-- Aktif / Favori -->
            <StackPanel Orientation="Horizontal" Margin="0,8,0,16">
                <CheckBox Content="Aktif" IsChecked="{Binding IsActive}" Margin="0,0,16,0"/>
                <CheckBox Content="Favori" IsChecked="{Binding IsFavorite}"/>
            </StackPanel>

            <!-- Hata -->
            <Border Background="#FEE2E2" BorderBrush="{StaticResource DangerBrush}" BorderThickness="1"
                    CornerRadius="4" Padding="12,8" Margin="0,0,0,12"
                    Visibility="{Binding ErrorMessage, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="{Binding ErrorMessage}" Foreground="#991B1B" TextWrapping="Wrap"/>
            </Border>

            <!-- Butonlar -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="İptal"
                        Command="{Binding CancelCommand}"
                        Background="#F3F4F6"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        Padding="16,8"
                        Cursor="Hand"
                        Margin="0,0,8,0"/>
                <Button Content="💾 Kaydet"
                        Command="{Binding SaveCommand}"
                        Background="{StaticResource PrimaryBrush}"
                        Foreground="White"
                        BorderThickness="0"
                        Padding="20,8"
                        FontWeight="SemiBold"
                        Cursor="Hand"/>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Window>
