<Window x:Class="EduAnalytics.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:EduAnalytics.UI.ViewModels"
        xmlns:views="clr-namespace:EduAnalytics.UI.Views"
        xmlns:mi="clr-namespace:Material.Icons.WPF;assembly=Material.Icons.WPF"
        Title="EduAnalytics"
        MinHeight="720" MinWidth="1200"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResize"
        Background="{StaticResource PageBgBrush}">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="40"
                      ResizeBorderThickness="6"
                      GlassFrameThickness="0"
                      UseAeroCaptionButtons="False"
                      CornerRadius="0"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:DashboardViewModel}">
            <views:DashboardView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ExamAnalysisViewModel}">
            <views:ExamAnalysisView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:AnswerEntryViewModel}">
            <views:AnswerEntryView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:QuestionBankViewModel}">
            <views:QuestionBankView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:LearningOutcomeManagementViewModel}">
            <views:LearningOutcomeManagementView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ProgramOutcomeManagementViewModel}">
            <views:ProgramOutcomeManagementView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ProgramOutcomeReportViewModel}">
            <views:ProgramOutcomeReportView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:QuestionGroupEditorViewModel}">
            <views:QuestionGroupEditorView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ExamFromBankViewModel}">
            <views:ExamFromBankView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ExamManagementViewModel}">
            <views:ExamManagementView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SingleQuestionCreateViewModel}">
            <views:SingleQuestionCreateView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ProgramOutcomeMappingViewModel}">
            <views:ProgramOutcomeMappingView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:StudentManagementViewModel}">
            <views:StudentManagementView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:AcademicStructureViewModel}">
            <views:AcademicStructureView/>
        </DataTemplate>
    </Window.Resources>

    <Window.InputBindings>
        <KeyBinding Key="D1" Modifiers="Ctrl" Command="{Binding NavigateToDashboardCommand}"/>
        <KeyBinding Key="D2" Modifiers="Ctrl" Command="{Binding NavigateToExamManagementCommand}"/>
        <KeyBinding Key="D3" Modifiers="Ctrl" Command="{Binding NavigateToQuestionBankCommand}"/>
        <KeyBinding Key="D4" Modifiers="Ctrl" Command="{Binding NavigateToStudentsCommand}"/>
        <KeyBinding Key="D5" Modifiers="Ctrl" Command="{Binding NavigateToLearningOutcomesCommand}"/>
        <KeyBinding Key="D6" Modifiers="Ctrl" Command="{Binding NavigateToProgramOutcomesCommand}"/>
    </Window.InputBindings>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="40"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ═══ TITLE BAR ═══ -->
        <Border Grid.Row="0" Background="{StaticResource SidebarBgBrush}">
            <Grid Margin="14,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <mi:MaterialIcon Kind="SchoolOutline" Width="18" Height="18"
                                     Foreground="{StaticResource PrimaryBrush}"
                                     VerticalAlignment="Center"/>
                    <TextBlock Text="EduAnalytics"
                               Foreground="{StaticResource SidebarTextBrush}"
                               FontSize="14" FontWeight="SemiBold"
                               Margin="8,0,0,0" VerticalAlignment="Center"/>
                    <TextBlock Text="Ölçme değerlendirme paneli"
                               Foreground="{StaticResource SidebarMutedBrush}"
                               FontSize="11" Margin="12,0,0,0"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="ThemeToggleBtn"
                            Click="ToggleTheme_Click"
                            Style="{StaticResource TitleBarButtonStyle}"
                            ToolTip="Tema: Açık">
                        <mi:MaterialIcon x:Name="ThemeIcon" Kind="WeatherSunny" Width="14" Height="14"/>
                    </Button>
                    <Button Click="MinimizeWindow"
                            Style="{StaticResource TitleBarButtonStyle}"
                            ToolTip="Küçült">
                        <mi:MaterialIcon Kind="WindowMinimize" Width="14" Height="14"/>
                    </Button>
                    <Button Click="ToggleMaximizeWindow"
                            Style="{StaticResource TitleBarButtonStyle}"
                            ToolTip="Büyüt / Küçült">
                        <mi:MaterialIcon Kind="WindowMaximize" Width="14" Height="14"/>
                    </Button>
                    <Button Click="CloseWindow"
                            Style="{StaticResource TitleBarCloseButtonStyle}"
                            ToolTip="Kapat">
                        <mi:MaterialIcon Kind="WindowClose" Width="14" Height="14"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ═══ BODY ═══ -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="248"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

        <!-- ═══ SOL MENÜ ═══ -->
        <Border Grid.Column="0" Background="{StaticResource SidebarBgBrush}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel TextElement.Foreground="#E2E8F0">

                    <!-- GENEL -->
                    <TextBlock Text="GENEL" Style="{StaticResource SidebarSectionTitleStyle}"/>

                    <Button Tag="Dashboard"
                            Command="{Binding NavigateToDashboardCommand}"
                            Style="{StaticResource SidebarButtonStyle}"
                            ToolTip="Dashboard (Ctrl+1)">
                        <StackPanel Orientation="Horizontal">
                            <mi:MaterialIcon Kind="ViewDashboard" Width="18" Height="18" VerticalAlignment="Center"/>
                            <TextBlock Text="Dashboard" Margin="12,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button Tag="AcademicStructure"
                            Command="{Binding NavigateToAcademicStructureCommand}"
                            Style="{StaticResource SidebarButtonStyle}">
                        <StackPanel Orientation="Horizontal">
                            <mi:MaterialIcon Kind="School" Width="18" Height="18" VerticalAlignment="Center"/>
                            <TextBlock Text="Akademik Yapı" Margin="12,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- SORU YÖNETİMİ -->
                    <TextBlock Text="SORU YÖNETİMİ" Style="{StaticResource SidebarSectionTitleStyle}"/>

                    <Button Tag="QuestionBank"
                            Command="{Binding NavigateToQuestionBankCommand}"
                            Style="{StaticResource SidebarButtonStyle}"
                            ToolTip="Soru Bankası (Ctrl+3)">
                        <StackPanel Orientation="Horizontal">
                            <mi:MaterialIcon Kind="HelpBoxMultipleOutline" Width="18" Height="18" VerticalAlignment="Center"/>
                            <TextBlock Text="Soru Bankası" Margin="12,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button Tag="ExamFromBank"
                            Command="{Binding NavigateToExamFromBankCommand}"
                            Style="{StaticResource SidebarButtonStyle}">
                        <StackPanel Orientation="Horizontal">
                            <mi:MaterialIcon Kind="ClipboardListOutline" Width="18" Height="18" VerticalAlignment="Center"/>
                            <TextBlock Text="Bankadan Sınav" Margin="12,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button Tag="ExamManagement"
                            Command="{Binding NavigateToExamManagementCommand}"
                            Style="{StaticResource SidebarButtonStyle}"
                            ToolTip="Sınav Yönetimi (Ctrl+2)">
                        <StackPanel Orientation="Horizontal">
                            <mi:MaterialIcon Kind="FileDocumentMultipleOutline" Width="18" Height="18" VerticalAlignment="Center"/>
                            <TextBlock Text="Sınav Yönetimi" Margin="12,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- ÇIKTI YÖNETİMİ -->
                    <TextBlock Text="ÇIKTI YÖNETİMİ" Style="{StaticResource SidebarSectionTitleStyle}"/>

                    <Button Tag="LearningOutcomes"
                            Command="{Binding NavigateToLearningOutcomesCommand}"
                            Style="{StaticResource SidebarButtonStyle}"
                            ToolTip="Öğrenim Çıktıları (Ctrl+5)">
                        <StackPanel Orientation="Horizontal">
                            <mi:MaterialIcon Kind="Target" Width="18" Height="18" VerticalAlignment="Center"/>
                            <TextBlock Text="Öğrenim Çıktıları" Margin="12,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button Tag="ProgramOutcomes"
                            Command="{Binding NavigateToProgramOutcomesCommand}"
                            Style="{StaticResource SidebarButtonStyle}"
                            ToolTip="Program Çıktıları (Ctrl+6)">
                        <StackPanel Orientation="Horizontal">
                            <mi:MaterialIcon Kind="ChartBar" Width="18" Height="18" VerticalAlignment="Center"/>
                            <TextBlock Text="Program Çıktıları" Margin="12,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button Tag="ProgramOutcomeMapping"
                            Command="{Binding NavigateToProgramOutcomeMappingCommand}"
                            Style="{StaticResource SidebarButtonStyle}">
                        <StackPanel Orientation="Horizontal">
                            <mi:MaterialIcon Kind="SwapHorizontal" Width="18" Height="18" VerticalAlignment="Center"/>
                            <TextBlock Text="PÇ - ÖÇ Eşleştirme" Margin="12,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button Tag="ProgramOutcomeReport"
                            Command="{Binding NavigateToProgramOutcomeReportCommand}"
                            Style="{StaticResource SidebarButtonStyle}">
                        <StackPanel Orientation="Horizontal">
                            <mi:MaterialIcon Kind="ChartLineVariant" Width="18" Height="18" VerticalAlignment="Center"/>
                            <TextBlock Text="PÇ Başarı Raporu" Margin="12,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- ÖĞRENCİ YÖNETİMİ -->
                    <TextBlock Text="ÖĞRENCİ YÖNETİMİ" Style="{StaticResource SidebarSectionTitleStyle}"/>

                    <Button Tag="Students"
                            Command="{Binding NavigateToStudentsCommand}"
                            Style="{StaticResource SidebarButtonStyle}"
                            ToolTip="Öğrenciler (Ctrl+4)">
                        <StackPanel Orientation="Horizontal">
                            <mi:MaterialIcon Kind="AccountGroup" Width="18" Height="18" VerticalAlignment="Center"/>
                            <TextBlock Text="Öğrenciler" Margin="12,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Border Height="20"/>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- ═══ ANA İÇERİK ═══ -->
        <ContentControl Grid.Column="1"
                        Content="{Binding CurrentView}"
                        Margin="30,26"/>

        </Grid><!-- /BODY -->

        <!-- ═══ TOAST BİLDİRİMLERİ ═══ -->
        <ItemsControl Grid.RowSpan="2"
                      ItemsSource="{Binding Toasts.Toasts}"
                      HorizontalAlignment="Right"
                      VerticalAlignment="Bottom"
                      Margin="0,0,24,24"
                      Panel.ZIndex="999"
                      IsHitTestVisible="False">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Width="320" Margin="0,8,0,0"
                            Background="{StaticResource CardBgBrush}"
                            BorderThickness="0,0,0,3"
                            CornerRadius="8" Padding="14,11">
                        <Border.RenderTransform>
                            <TranslateTransform x:Name="SlideX" X="340"/>
                        </Border.RenderTransform>
                        <Border.Triggers>
                            <EventTrigger RoutedEvent="Loaded">
                                <!-- Slide in -->
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="SlideX"
                                                         Storyboard.TargetProperty="X"
                                                         To="0" Duration="0:0:0.25">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut"/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                                <!-- Slide out after 3s (service removes at 3.5s) -->
                                <BeginStoryboard>
                                    <Storyboard BeginTime="0:0:3">
                                        <DoubleAnimation Storyboard.TargetName="SlideX"
                                                         Storyboard.TargetProperty="X"
                                                         To="340" Duration="0:0:0.25"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </Border.Triggers>
                        <Border.Effect>
                            <DropShadowEffect Color="#0F172A" Direction="270"
                                              ShadowDepth="2" BlurRadius="12" Opacity="0.12"/>
                        </Border.Effect>
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="BorderBrush" Value="{StaticResource InfoBrush}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Severity}" Value="Success">
                                        <Setter Property="BorderBrush" Value="{StaticResource SuccessBrush}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Severity}" Value="Error">
                                        <Setter Property="BorderBrush" Value="{StaticResource DangerBrush}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Severity}" Value="Warning">
                                        <Setter Property="BorderBrush" Value="{StaticResource WarningBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel Orientation="Horizontal">
                            <mi:MaterialIcon Width="18" Height="18"
                                             VerticalAlignment="Top"
                                             Margin="0,1,10,0">
                                <mi:MaterialIcon.Style>
                                    <Style TargetType="mi:MaterialIcon">
                                        <Setter Property="Kind" Value="InformationOutline"/>
                                        <Setter Property="Foreground" Value="{StaticResource InfoBrush}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Severity}" Value="Success">
                                                <Setter Property="Kind" Value="CheckCircleOutline"/>
                                                <Setter Property="Foreground" Value="{StaticResource SuccessBrush}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Severity}" Value="Error">
                                                <Setter Property="Kind" Value="AlertCircleOutline"/>
                                                <Setter Property="Foreground" Value="{StaticResource DangerBrush}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Severity}" Value="Warning">
                                                <Setter Property="Kind" Value="AlertOutline"/>
                                                <Setter Property="Foreground" Value="{StaticResource WarningBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </mi:MaterialIcon.Style>
                            </mi:MaterialIcon>
                            <StackPanel>
                                <TextBlock Text="{Binding Title}"
                                           FontWeight="SemiBold" FontSize="13"
                                           Foreground="{StaticResource TextPrimaryBrush}"/>
                                <TextBlock Text="{Binding Message}"
                                           TextWrapping="Wrap"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           FontSize="11" Margin="0,2,0,0"
                                           Visibility="{Binding Message, Converter={StaticResource BoolToVisibility}}"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </Grid>
</Window>
