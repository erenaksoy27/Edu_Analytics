<Window x:Class="EduAnalytics.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:EduAnalytics.UI.ViewModels"
        xmlns:views="clr-namespace:EduAnalytics.UI.Views"
        Title="EduAnalytics"
        Height="820" Width="1320"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource PageBgBrush}">

    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:DashboardViewModel}">
            <views:DashboardView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ExamAnalysisViewModel}">
            <views:ExamAnalysisView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ExamCreateViewModel}">
            <views:ExamCreateView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:AnswerEntryViewModel}">
            <views:AnswerEntryView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:QuestionBankViewModel}">
            <views:QuestionBankView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:LearningOutcomeManagementViewModel}">
            <views:LearningOutcomeManagementView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ProgramOutcomeManagementViewModel}">
            <views:ProgramOutcomeManagementView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ProgramOutcomeReportViewModel}">
            <views:ProgramOutcomeReportView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:QuestionGroupEditorViewModel}">
            <views:QuestionGroupEditorView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ExamFromBankViewModel}">
            <views:ExamFromBankView/>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ═══ SOL MENÜ ═══ -->
        <Border Grid.Column="0" Background="{StaticResource SidebarBgBrush}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel TextElement.Foreground="#E2E8F0">
                    <!-- Logo -->
                    <StackPanel Orientation="Horizontal" Margin="20,24,20,20">
                        <Border Width="30" Height="30"
                                Background="{StaticResource PrimaryBrush}"
                                CornerRadius="7" VerticalAlignment="Center">
                            <TextBlock Text="E"
                                       Foreground="White"
                                       FontWeight="Bold" FontSize="16"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="EduAnalytics"
                                   Foreground="White"
                                   FontSize="15" FontWeight="SemiBold"
                                   VerticalAlignment="Center"
                                   Margin="10,0,0,0"/>
                    </StackPanel>

                    <!-- GENEL -->
                    <TextBlock Text="GENEL" Style="{StaticResource SidebarSectionTitleStyle}"/>

                    <Button Tag="Dashboard"
                            Command="{Binding NavigateToDashboardCommand}"
                            Style="{StaticResource SidebarButtonStyle}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🏠" Width="22" FontSize="13"
                                       VerticalAlignment="Center" TextAlignment="Center"/>
                            <TextBlock Text="Dashboard" Margin="10,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- SORU YÖNETİMİ -->
                    <TextBlock Text="SORU YÖNETİMİ" Style="{StaticResource SidebarSectionTitleStyle}"/>

                    <Button Tag="QuestionBank"
                            Command="{Binding NavigateToQuestionBankCommand}"
                            Style="{StaticResource SidebarButtonStyle}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📚" Width="22" FontSize="13"
                                       VerticalAlignment="Center" TextAlignment="Center"/>
                            <TextBlock Text="Soru Bankası" Margin="10,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button Tag="CommonStem"
                            Command="{Binding NavigateToCommonStemCommand}"
                            Style="{StaticResource SidebarButtonStyle}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🔗" Width="22" FontSize="13"
                                       VerticalAlignment="Center" TextAlignment="Center"/>
                            <TextBlock Text="İlişkili Soru" Margin="10,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button Tag="CreateExam"
                            Command="{Binding NavigateToCreateExamCommand}"
                            Style="{StaticResource SidebarButtonStyle}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📝" Width="22" FontSize="13"
                                       VerticalAlignment="Center" TextAlignment="Center"/>
                            <TextBlock Text="Yeni Sınav Oluştur" Margin="10,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button Tag="ExamFromBank"
                            Command="{Binding NavigateToExamFromBankCommand}"
                            Style="{StaticResource SidebarButtonStyle}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📦" Width="22" FontSize="13"
                                       VerticalAlignment="Center" TextAlignment="Center"/>
                            <TextBlock Text="Bankadan Sınav" Margin="10,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- ÇIKTI YÖNETİMİ -->
                    <TextBlock Text="ÇIKTI YÖNETİMİ" Style="{StaticResource SidebarSectionTitleStyle}"/>

                    <Button Tag="LearningOutcomes"
                            Command="{Binding NavigateToLearningOutcomesCommand}"
                            Style="{StaticResource SidebarButtonStyle}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🎯" Width="22" FontSize="13"
                                       VerticalAlignment="Center" TextAlignment="Center"/>
                            <TextBlock Text="Ders Çıktıları (ÖÇ)" Margin="10,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button Tag="ProgramOutcomes"
                            Command="{Binding NavigateToProgramOutcomesCommand}"
                            Style="{StaticResource SidebarButtonStyle}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🎓" Width="22" FontSize="13"
                                       VerticalAlignment="Center" TextAlignment="Center"/>
                            <TextBlock Text="Program Çıktıları (PÇ)" Margin="10,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button Tag="ProgramOutcomeReport"
                            Command="{Binding NavigateToProgramOutcomeReportCommand}"
                            Style="{StaticResource SidebarButtonStyle}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📈" Width="22" FontSize="13"
                                       VerticalAlignment="Center" TextAlignment="Center"/>
                            <TextBlock Text="PÇ Başarı Raporu" Margin="10,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Border Height="20"/>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- ═══ ANA İÇERİK ═══ -->
        <ContentControl Grid.Column="1"
                        Content="{Binding CurrentView}"
                        Margin="28,24"/>

        <!-- ═══ TOAST BİLDİRİMLERİ ═══ -->
        <ItemsControl Grid.ColumnSpan="2"
                      ItemsSource="{Binding Toasts.Toasts}"
                      HorizontalAlignment="Right"
                      VerticalAlignment="Bottom"
                      Margin="0,0,24,24"
                      Panel.ZIndex="999"
                      IsHitTestVisible="False">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Width="320" Margin="0,8,0,0"
                            Background="{StaticResource CardBgBrush}"
                            BorderThickness="0,0,0,3"
                            CornerRadius="8" Padding="14,11">
                        <Border.Effect>
                            <DropShadowEffect Color="#0F172A" Direction="270"
                                              ShadowDepth="2" BlurRadius="12" Opacity="0.12"/>
                        </Border.Effect>
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="BorderBrush" Value="{StaticResource InfoBrush}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Severity}" Value="Success">
                                        <Setter Property="BorderBrush" Value="{StaticResource SuccessBrush}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Severity}" Value="Error">
                                        <Setter Property="BorderBrush" Value="{StaticResource DangerBrush}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Severity}" Value="Warning">
                                        <Setter Property="BorderBrush" Value="{StaticResource WarningBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel>
                            <TextBlock Text="{Binding Title}"
                                       FontWeight="SemiBold" FontSize="13"
                                       Foreground="{StaticResource TextPrimaryBrush}"/>
                            <TextBlock Text="{Binding Message}"
                                       TextWrapping="Wrap"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       FontSize="11" Margin="0,2,0,0"
                                       Visibility="{Binding Message, Converter={StaticResource BoolToVisibility}}"/>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </Grid>
</Window>
