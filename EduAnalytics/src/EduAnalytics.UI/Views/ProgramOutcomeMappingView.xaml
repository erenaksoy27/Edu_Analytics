<UserControl x:Class="EduAnalytics.UI.Views.ProgramOutcomeMappingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:EduAnalytics.UI.ViewModels"
             xmlns:views="clr-namespace:EduAnalytics.UI.Views"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             d:DataContext="{d:DesignInstance Type=vm:ProgramOutcomeMappingViewModel}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Başlık -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="Program Çıktısı &#x2194; Öğrenim Çıktısı Eşleştirme"
                       Style="{StaticResource HeadingStyle}"/>
            <TextBlock TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}">
                Program Çıktıları (PÇ) ile Öğrenim Çıktılarını (ÖÇ) eşleştirin. Bir ÖÇ birden fazla PÇ'ye katkı sağlayabilir. Katkı seviyesi 1 (düşük) ile 5 (yüksek) arasındadır.
            </TextBlock>
        </StackPanel>

        <!-- Mesaj alanı -->
        <StackPanel Grid.Row="1" Margin="0,0,0,12">
            <Border Style="{StaticResource AlertErrorStyle}"
                    Margin="0,0,0,6"
                    Visibility="{Binding ErrorMessage, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="{Binding ErrorMessage}" Foreground="#991B1B" TextWrapping="Wrap"/>
            </Border>
            <Border Style="{StaticResource AlertSuccessStyle}"
                    Visibility="{Binding SuccessMessage, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="{Binding SuccessMessage}" Foreground="#065F46" TextWrapping="Wrap"/>
            </Border>
        </StackPanel>

        <!-- Ana içerik: 2 kolon -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- SOL: Program ve PÇ Listesi -->
            <Border Grid.Column="0" Style="{StaticResource CardStyle}" Margin="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Program" Style="{StaticResource LabelStyle}"/>
                    <ComboBox Grid.Row="1"
                              ItemsSource="{Binding Programs}"
                              SelectedItem="{Binding SelectedProgram}"
                              DisplayMemberPath="Name"
                              Margin="0,0,0,16"/>

                    <TextBlock Grid.Row="2" Text="Program Çıktıları" Style="{StaticResource LabelStyle}"/>

                    <ListBox Grid.Row="3"
                             ItemsSource="{Binding ProgramOutcomes}"
                             SelectedItem="{Binding SelectedProgramOutcome}"
                             Background="Transparent"
                             BorderThickness="0">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Margin" Value="0,0,0,4"/>
                                <Setter Property="Cursor" Value="Hand"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="bd"
                                                    Background="Transparent"
                                                    BorderBrush="{StaticResource BorderSubtleBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="6"
                                                    Padding="10,8">
                                                <ContentPresenter/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/>
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="bd" Property="Background" Value="{StaticResource PrimaryLightBrush}"/>
                                                    <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <Border Background="{StaticResource PrimaryBrush}"
                                                CornerRadius="4"
                                                Padding="6,2"
                                                Margin="0,0,8,0">
                                            <TextBlock Text="{Binding Code}"
                                                       Foreground="White"
                                                       FontWeight="SemiBold"
                                                       FontSize="11"/>
                                        </Border>
                                        <TextBlock VerticalAlignment="Center"
                                                   FontSize="11"
                                                   Foreground="{StaticResource TextSecondaryBrush}">
                                            <Run Text="{Binding LearningOutcomeCount}"/>
                                            <Run Text=" ÖÇ"/>
                                        </TextBlock>
                                    </StackPanel>
                                    <TextBlock Text="{Binding Description}"
                                               TextWrapping="Wrap"
                                               Margin="0,6,0,0"
                                               FontSize="12"
                                               Foreground="{StaticResource TextPrimaryBrush}"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <Border Grid.Row="4"
                            Style="{StaticResource CardSubtleStyle}"
                            Margin="0,12,0,0"
                            Padding="10,8">
                        <StackPanel>
                            <TextBlock Text="Katkı Düzeyi"
                                       FontWeight="SemiBold"
                                       FontSize="11"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       Margin="0,0,0,4"/>
                            <TextBlock TextWrapping="Wrap"
                                       FontSize="11"
                                       Foreground="{StaticResource TextSecondaryBrush}">
                                <Run Text="1 Çok Düşük"/>
                                <Run Text=" · "/>
                                <Run Text="2 Düşük"/>
                                <Run Text=" · "/>
                                <Run Text="3 Orta"/>
                                <Run Text=" · "/>
                                <Run Text="4 Yüksek"/>
                                <Run Text=" · "/>
                                <Run Text="5 Çok Yüksek"/>
                            </TextBlock>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- SAĞ: Eşleşmeler -->
            <Border Grid.Column="2" Style="{StaticResource CardStyle}" Margin="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,4">
                        <TextBlock Text="Seçili PÇ"
                                   Style="{StaticResource SubheadingStyle}"
                                   Margin="0,0,10,0"/>
                        <Border Background="{StaticResource PrimaryBrush}"
                                CornerRadius="4"
                                Padding="8,3"
                                VerticalAlignment="Center"
                                Margin="0,0,0,12"
                                Visibility="{Binding SelectedProgramOutcome, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="{Binding SelectedProgramOutcome.Code, FallbackValue='—'}"
                                       Foreground="White"
                                       FontWeight="SemiBold"
                                       FontSize="12"/>
                        </Border>
                    </StackPanel>

                    <TextBlock Grid.Row="1"
                               Text="{Binding SelectedProgramOutcome.Description}"
                               TextWrapping="Wrap"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               Margin="0,0,0,14"/>

                    <!-- Yeni eşleştirme ekleme -->
                    <Border Grid.Row="2"
                            Style="{StaticResource CardSubtleStyle}"
                            Margin="0,0,0,16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="14"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="14"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Öğrenim Çıktısı"
                                       Style="{StaticResource LabelStyle}"/>
                            <TextBlock Grid.Row="0" Grid.Column="2" Text="Katkı"
                                       Style="{StaticResource LabelStyle}"/>

                            <ComboBox Grid.Row="1" Grid.Column="0"
                                      ItemsSource="{Binding AvailableOutcomes}"
                                      SelectedItem="{Binding OutcomeToAdd}"
                                      DisplayMemberPath="Name"/>

                            <ComboBox Grid.Row="1" Grid.Column="2"
                                      SelectedItem="{Binding NewContributionLevel}"
                                      Width="80">
                                <ComboBox.Items>
                                    <sys:Int32>1</sys:Int32>
                                    <sys:Int32>2</sys:Int32>
                                    <sys:Int32>3</sys:Int32>
                                    <sys:Int32>4</sys:Int32>
                                    <sys:Int32>5</sys:Int32>
                                </ComboBox.Items>
                            </ComboBox>

                            <Button Grid.Row="1" Grid.Column="4"
                                    Content="Bağla"
                                    Command="{Binding LinkOutcomeCommand}"
                                    Style="{StaticResource PrimaryButtonStyle}"/>
                        </Grid>
                    </Border>

                    <!-- Eşleşmiş ÖÇ Listesi -->
                    <Border Grid.Row="3"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="6">
                        <DataGrid ItemsSource="{Binding MappedOutcomes}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Kod" Binding="{Binding Code}" Width="80" IsReadOnly="True"/>
                                <DataGridTextColumn Header="Öğrenim Çıktısı" Binding="{Binding Name}" Width="*" IsReadOnly="True"/>
                                <DataGridTextColumn Header="Ders" Binding="{Binding CourseName}" Width="180" IsReadOnly="True"/>
                                <DataGridTemplateColumn Header="Katkı" Width="140">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <ComboBox SelectedItem="{Binding ContributionLevel, UpdateSourceTrigger=PropertyChanged}"
                                                          Width="60"
                                                          MinHeight="28">
                                                    <ComboBox.Items>
                                                        <sys:Int32>1</sys:Int32>
                                                        <sys:Int32>2</sys:Int32>
                                                        <sys:Int32>3</sys:Int32>
                                                        <sys:Int32>4</sys:Int32>
                                                        <sys:Int32>5</sys:Int32>
                                                    </ComboBox.Items>
                                                </ComboBox>
                                                <Button Content="Kaydet"
                                                        Command="{Binding DataContext.UpdateContributionCommand,
                                                                  RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"
                                                        Style="{StaticResource PrimaryButtonStyle}"
                                                        Padding="10,4"
                                                        FontSize="11"
                                                        Margin="6,0,0,0"
                                                        ToolTip="Katkı seviyesini kaydet"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="" Width="90">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Content="Kaldır"
                                                    Command="{Binding DataContext.UnlinkOutcomeCommand,
                                                              RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    Style="{StaticResource DangerButtonStyle}"
                                                    Padding="10,4"
                                                    FontSize="11"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>

                    <!-- Matrix Görünümü -->
                    <StackPanel Grid.Row="4" Margin="0,18,0,8">
                        <TextBlock Text="Dersin Program Çıktılarına Katkısı"
                                   Style="{StaticResource SubheadingStyle}"
                                   Margin="0"/>
                        <TextBlock Text="Satırlar öğrenim çıktıları, sütunlar program çıktıları. Hücreler 1–5 arası katkı seviyesini gösterir."
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   FontSize="12"
                                   Margin="0,4,0,0"/>
                    </StackPanel>

                    <Border Grid.Row="5"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="6">
                        <DataGrid ItemsSource="{Binding MatrixRows}"
                                  GridLinesVisibility="All"
                                  HorizontalGridLinesBrush="{StaticResource BorderSubtleBrush}"
                                  VerticalGridLinesBrush="{StaticResource BorderSubtleBrush}"
                                  IsReadOnly="True"
                                  RowHeight="34"
                                  ColumnHeaderHeight="38"
                                  MaxHeight="280"
                                  ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                  ScrollViewer.VerticalScrollBarVisibility="Auto"
                                  AlternationCount="2">
                            <DataGrid.Resources>
                                <Style TargetType="DataGridCell" BasedOn="{StaticResource {x:Type DataGridCell}}">
                                    <Setter Property="Padding" Value="6,4"/>
                                    <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                    <Setter Property="FontSize" Value="12"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="DataGridCell">
                                                <Border Background="{TemplateBinding Background}"
                                                        Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter HorizontalAlignment="Center"
                                                                      VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                                <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
                                    <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                </Style>
                            </DataGrid.Resources>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="ÖÇ" Binding="{Binding RowLabel}" Width="100">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                            <Setter Property="HorizontalAlignment" Value="Left"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="P1" Binding="{Binding P1}" Width="60"/>
                                <DataGridTextColumn Header="P2" Binding="{Binding P2}" Width="60"/>
                                <DataGridTextColumn Header="P3" Binding="{Binding P3}" Width="60"/>
                                <DataGridTextColumn Header="P4" Binding="{Binding P4}" Width="60"/>
                                <DataGridTextColumn Header="P5" Binding="{Binding P5}" Width="60"/>
                                <DataGridTextColumn Header="P6" Binding="{Binding P6}" Width="60"/>
                                <DataGridTextColumn Header="P7" Binding="{Binding P7}" Width="60"/>
                                <DataGridTextColumn Header="P8" Binding="{Binding P8}" Width="60"/>
                                <DataGridTextColumn Header="P9" Binding="{Binding P9}" Width="60"/>
                                <DataGridTextColumn Header="P10" Binding="{Binding P10}" Width="60"/>
                                <DataGridTextColumn Header="P11" Binding="{Binding P11}" Width="60"/>
                                <DataGridTextColumn Header="P12" Binding="{Binding P12}" Width="60"/>
                                <DataGridTextColumn Header="P13" Binding="{Binding P13}" Width="60"/>
                                <DataGridTextColumn Header="P14" Binding="{Binding P14}" Width="60"/>
                                <DataGridTextColumn Header="P15" Binding="{Binding P15}" Width="60"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <views:LoadingOverlay Grid.Row="0" Grid.RowSpan="3"
                              Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}"/>
    </Grid>
</UserControl>
