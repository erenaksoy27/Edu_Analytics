<UserControl x:Class="EduAnalytics.UI.Views.ProgramOutcomeMappingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:EduAnalytics.UI.ViewModels"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             d:DataContext="{d:DesignInstance Type=vm:ProgramOutcomeMappingViewModel}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Başlık -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="\uD83D\uDD17 PÇ ↔ ÖÇ Eşleştirme" Style="{StaticResource HeadingStyle}"/>
            <TextBlock TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}">
                Program Çıktıları (PÇ) ile Ders Çıktılarını (ÖÇ) eşleştirin. Bir ÖÇ birden fazla PÇ'ye katkı sağlayabilir.
                Katkı seviyesi 1 (düşük) — 5 (yüksek) arasındadır.
            </TextBlock>
        </StackPanel>

        <!-- Mesaj alanı -->
        <StackPanel Grid.Row="1" Margin="0,0,0,12">
            <Border Background="#FEE2E2" BorderBrush="{StaticResource DangerBrush}" BorderThickness="1"
                    CornerRadius="4" Padding="12,8" Margin="0,0,0,4"
                    Visibility="{Binding ErrorMessage, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="{Binding ErrorMessage}" Foreground="#991B1B" TextWrapping="Wrap"/>
            </Border>
            <Border Background="#D1FAE5" BorderBrush="{StaticResource SuccessBrush}" BorderThickness="1"
                    CornerRadius="4" Padding="12,8"
                    Visibility="{Binding SuccessMessage, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="{Binding SuccessMessage}" Foreground="#064E3B" TextWrapping="Wrap"/>
            </Border>
        </StackPanel>

        <!-- Ana içerik: 3 kolon -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <!-- Sol panel daraltıldı, sağ panel geniş kalsın -->
                <ColumnDefinition Width="200"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- SOL: Program ve PÇ Listesi -->
            <Border Grid.Column="0" Style="{StaticResource CardStyle}" Margin="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="\uD83C\uDF93 Program" FontWeight="SemiBold" Margin="0,0,0,4"/>
                    <ComboBox Grid.Row="1"
                              ItemsSource="{Binding Programs}"
                              SelectedItem="{Binding SelectedProgram}"
                              DisplayMemberPath="Name"
                              Padding="8,6"
                              Margin="0,0,0,12"/>

                    <Grid Grid.Row="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="\uD83D\uDCCB Program Çıktıları (PÇ)"
                                   FontWeight="SemiBold" Margin="0,0,0,8"/>
                        <ListBox Grid.Row="1"
                                 ItemsSource="{Binding ProgramOutcomes}"
                                 SelectedItem="{Binding SelectedProgramOutcome}"
                                 Background="Transparent"
                                 BorderBrush="{StaticResource BorderBrush}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="8,6" Margin="0,2">
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal">
                                                <Border Background="{StaticResource PrimaryBrush}" CornerRadius="3"
                                                        Padding="6,2" Margin="0,0,6,0">
                                                    <TextBlock Text="{Binding Code}" Foreground="White"
                                                               FontWeight="Bold" FontSize="11"/>
                                                </Border>
                                                <TextBlock VerticalAlignment="Center" FontSize="11"
                                                           Foreground="{StaticResource TextSecondaryBrush}">
                                                    <Run Text="{Binding LearningOutcomeCount}"/>
                                                    <Run Text="ÖÇ"/>
                                                </TextBlock>
                                            </StackPanel>
                                            <TextBlock Text="{Binding Description}"
                                                       TextWrapping="Wrap" Margin="0,4,0,0"
                                                       FontSize="12"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                    <!-- Katkı Düzeyi Açıklaması -->
                    <Border Grid.Row="3" Background="#F8FAFC" BorderBrush="#BAE6FD" BorderThickness="1" CornerRadius="6" Padding="8" Margin="0,8,0,0">
                        <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}">
                            <Run Text="Katkı Düzeyi:" FontWeight="Bold" />
                            <LineBreak />
                            <Run Text="1: Çok Düşük" /> | 
                            <Run Text="2: Düşük" /> | 
                            <Run Text="3: Orta" /> | 
                            <Run Text="4: Yüksek" /> | 
                            <Run Text="5: Çok Yüksek" />
                        </TextBlock>
                    </Border>
                </Grid>
            </Border>

            <!-- SAĞ: Eşleşmeler ve Ekleme -->
            <Border Grid.Column="2" Style="{StaticResource CardStyle}" Margin="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Style="{StaticResource SubheadingStyle}">
                        <Run Text="\uD83D\uDD17 Seçili PÇ:"/>
                        <Run Text="{Binding SelectedProgramOutcome.Code, FallbackValue='—'}" FontWeight="Bold"
                             Foreground="{DynamicResource PrimaryBrush}"/>
                    </TextBlock>

                    <TextBlock Grid.Row="1" Text="{Binding SelectedProgramOutcome.Description}"
                               TextWrapping="Wrap"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               Margin="0,0,0,12"/>

                    <!-- Yeni eşleştirme ekleme -->
                    <Border Grid.Row="2" Background="#F0F9FF" BorderBrush="#0EA5E9" BorderThickness="1"
                            CornerRadius="6" Padding="12" Margin="0,0,0,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="ÖÇ Seç"
                                       FontWeight="SemiBold" FontSize="11" Margin="0,0,0,4"/>
                            <TextBlock Grid.Row="0" Grid.Column="2" Text="Katkı (1-5)"
                                       FontWeight="SemiBold" FontSize="11" Margin="0,0,0,4"/>

                            <ComboBox Grid.Row="1" Grid.Column="0"
                                      ItemsSource="{Binding AvailableOutcomes}"
                                      SelectedItem="{Binding OutcomeToAdd}"
                                      DisplayMemberPath="Name"
                                      Padding="6,4"/>

                            <ComboBox Grid.Row="1" Grid.Column="2"
                                      SelectedItem="{Binding NewContributionLevel}"
                                      Padding="6,4" Width="60">
                                <ComboBox.Items>
                                    <sys:Int32>1</sys:Int32>
                                    <sys:Int32>2</sys:Int32>
                                    <sys:Int32>3</sys:Int32>
                                    <sys:Int32>4</sys:Int32>
                                    <sys:Int32>5</sys:Int32>
                                </ComboBox.Items>
                            </ComboBox>

                            <Button Grid.Row="1" Grid.Column="4"
                                    Content="+ Bağla"
                                    Command="{Binding LinkOutcomeCommand}"
                                    Background="{StaticResource SuccessBrush}"
                                    Foreground="White"
                                    Padding="14,6"
                                    BorderThickness="0"
                                    Cursor="Hand"
                                    FontWeight="SemiBold"/>
                        </Grid>
                    </Border>

                    <!-- Eşleşmiş ÖÇ Listesi -->
                    <Border Grid.Row="3" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="4">
                        <DataGrid ItemsSource="{Binding MappedOutcomes}"
                                  AutoGenerateColumns="False"
                                  HeadersVisibility="Column"
                                  GridLinesVisibility="Horizontal"
                                  Background="Transparent" BorderThickness="0"
                                  RowHeight="40" ColumnHeaderHeight="36"
                                  CanUserAddRows="False" CanUserDeleteRows="False">
                            <DataGrid.Resources>
                                <Style TargetType="DataGridCell">
                                    <Setter Property="Padding" Value="8,4"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                </Style>
                                <Style TargetType="DataGridColumnHeader">
                                    <Setter Property="Padding" Value="10,8"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                </Style>
                            </DataGrid.Resources>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Kod" Binding="{Binding Code}" Width="80" IsReadOnly="True"/>
                                <DataGridTextColumn Header="ÖÇ" Binding="{Binding Name}" Width="*" IsReadOnly="True"/>
                                <DataGridTextColumn Header="Ders" Binding="{Binding CourseName}" Width="160" IsReadOnly="True"/>
                                <DataGridTemplateColumn Header="Katkı" Width="110">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <ComboBox SelectedItem="{Binding ContributionLevel, UpdateSourceTrigger=PropertyChanged}"
                                                          Width="50" Padding="4,2">
                                                    <ComboBox.Items>
                                                        <sys:Int32>1</sys:Int32>
                                                        <sys:Int32>2</sys:Int32>
                                                        <sys:Int32>3</sys:Int32>
                                                        <sys:Int32>4</sys:Int32>
                                                        <sys:Int32>5</sys:Int32>
                                                    </ComboBox.Items>
                                                </ComboBox>
                                                <Button Content="✓"
                                                        Command="{Binding DataContext.UpdateContributionCommand,
                                                                  RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"
                                                        Background="{StaticResource SuccessBrush}"
                                                        Foreground="White"
                                                        Padding="6,2" Margin="4,0,0,0"
                                                        BorderThickness="0" Cursor="Hand"
                                                        ToolTip="Katkı seviyesini kaydet"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="İşlem" Width="72">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Content="✕ Kaldır"
                                                    Command="{Binding DataContext.UnlinkOutcomeCommand,
                                                              RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    Background="Transparent"
                                                    Foreground="{StaticResource DangerBrush}"
                                                    BorderBrush="{StaticResource DangerBrush}"
                                                    BorderThickness="1"
                                                    Padding="6,2" Cursor="Hand" FontSize="11"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>

                    <!-- PÇ ↔ ÖÇ MATRIX GÖRÜNÜMÜ -->
                    <TextBlock Grid.Row="4" Text="Dersin Program Çıktılarına Katkısı" FontWeight="SemiBold" Margin="0,15,0,5" Foreground="{StaticResource PrimaryBrush}" FontSize="13"/>
                    <Border Grid.Row="5" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="4" Margin="0,0,0,10">
                             <DataGrid ItemsSource="{Binding MatrixRows}"
                                       AutoGenerateColumns="False"
                                       HeadersVisibility="Column"
                                       GridLinesVisibility="None"
                                       BorderThickness="0" Background="Transparent"
                                       CanUserAddRows="False" CanUserDeleteRows="False" IsReadOnly="True"
                                       RowHeight="40" ColumnHeaderHeight="40" CanUserResizeColumns="True" HorizontalAlignment="Stretch"
                                       MaxHeight="260"
                                       ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                       ScrollViewer.VerticalScrollBarVisibility="Auto"
                                       AlternationCount="2">
                                <DataGrid.Resources>
                                    <Style TargetType="DataGridCell">
                                         <Setter Property="Padding" Value="6,4"/>
                                         <Setter Property="HorizontalAlignment" Value="Center"/>
                                         <Setter Property="FontSize" Value="12"/>
                                         <Setter Property="FontWeight" Value="Normal"/>
                                    </Style>
                                    <Style TargetType="DataGridColumnHeader">
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                        <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                        <Setter Property="Padding" Value="6,4"/>
                                        <Setter Property="FontSize" Value="12"/>
                                    </Style>
                                    <Style TargetType="DataGridRow">
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Style.Triggers>
                                            <Trigger Property="ItemsControl.AlternationIndex" Value="1">
                                                <Setter Property="Background" Value="#FAFBFC"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </DataGrid.Resources>
                                <DataGrid.Columns>
                                    <!-- ÖÇ etiket sütunu küçültüldü -->
                                    <DataGridTextColumn Header="" Binding="{Binding RowLabel}" FontWeight="Bold" Width="140" />

                                    <!-- P sütunları min genişlik düşürüldü; alan varsa * ile yayılacak -->
                                    <DataGridTextColumn Header="P1" Binding="{Binding P1}" Width="*" MinWidth="56"/>
                                    <DataGridTextColumn Header="P2" Binding="{Binding P2}" Width="*" MinWidth="56"/>
                                    <DataGridTextColumn Header="P3" Binding="{Binding P3}" Width="*" MinWidth="56"/>
                                    <DataGridTextColumn Header="P4" Binding="{Binding P4}" Width="*" MinWidth="56"/>
                                    <DataGridTextColumn Header="P5" Binding="{Binding P5}" Width="*" MinWidth="56"/>
                                    <DataGridTextColumn Header="P6" Binding="{Binding P6}" Width="*" MinWidth="56"/>
                                    <DataGridTextColumn Header="P7" Binding="{Binding P7}" Width="*" MinWidth="56"/>
                                    <DataGridTextColumn Header="P8" Binding="{Binding P8}" Width="*" MinWidth="56"/>
                                    <DataGridTextColumn Header="P9" Binding="{Binding P9}" Width="*" MinWidth="56"/>
                                    <DataGridTextColumn Header="P10" Binding="{Binding P10}" Width="*" MinWidth="56"/>
                                    <DataGridTextColumn Header="P11" Binding="{Binding P11}" Width="*" MinWidth="56"/>
                                    <DataGridTextColumn Header="P12" Binding="{Binding P12}" Width="*" MinWidth="56"/>
                                    <DataGridTextColumn Header="P13" Binding="{Binding P13}" Width="*" MinWidth="56"/>
                                    <DataGridTextColumn Header="P14" Binding="{Binding P14}" Width="*" MinWidth="56"/>
                                    <DataGridTextColumn Header="P15" Binding="{Binding P15}" Width="*" MinWidth="56"/>
                                </DataGrid.Columns>
                             </DataGrid>
                     </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- Loading overlay -->
        <Border Grid.Row="0" Grid.RowSpan="3" Background="#80FFFFFF"
                Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}">
            <TextBlock Text="Yükleniyor..." HorizontalAlignment="Center" VerticalAlignment="Center"
                       FontSize="18" Foreground="{StaticResource PrimaryBrush}"/>
        </Border>
    </Grid>
</UserControl>
