<UserControl x:Class="EduAnalytics.UI.Views.ProgramOutcomeManagementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:EduAnalytics.UI.ViewModels"
             xmlns:views="clr-namespace:EduAnalytics.UI.Views"
             d:DataContext="{d:DesignInstance Type=vm:ProgramOutcomeManagementViewModel}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Program Çıktısı (PÇ) Yönetimi" Style="{StaticResource HeadingStyle}"/>
                <TextBlock Text="Programınızın mezunundan beklenen temel yetkinlikleri kod ve açıklama olarak tanımlayın. Kod alanına yalnızca 1, 2, 3 gibi sıra numarası girmeniz yeterlidir; sistem kayıt sırasında bunları otomatik olarak PÇ-1, PÇ-2, PÇ-3 biçimine çevirir."
                           Foreground="{StaticResource TextSecondaryBrush}"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="Şablon İndir"
                        Command="{Binding DownloadExcelTemplateCommand}"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Margin="0,0,8,0"
                        ToolTip="Kod ve Açıklama kolonlarını içeren boş Excel şablonu indir. Kod alanına 1 yazarsanız sistem PÇ-1 olarak kaydeder."/>
                <Button Content="Excel İçe Aktar"
                        Command="{Binding ImportExcelCommand}"
                        Style="{StaticResource PrimaryButtonStyle}"
                        ToolTip="Excel'deki program çıktılarını ekle veya aynı kod varsa güncelle"/>
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" Style="{StaticResource CardStyle}">
            <StackPanel>
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Program" Style="{StaticResource LabelStyle}"/>
                        <ComboBox ItemsSource="{Binding Programs}"
                                  SelectedItem="{Binding SelectedProgram}"
                                  DisplayMemberPath="Name"/>
                    </StackPanel>
                    <Button Grid.Column="1"
                            Content="Yeni Çıktı"
                            Command="{Binding StartNewCommand}"
                            Style="{StaticResource PrimaryButtonStyle}"
                            VerticalAlignment="Bottom"
                            Margin="12,0,0,0"/>
                </Grid>

                <Border Style="{StaticResource CardSubtleStyle}">
                    <StackPanel>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Kod (örn. 1)" Style="{StaticResource LabelStyle}"/>
                                <TextBox Text="{Binding FormCode, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="Bu alana yalnızca sıra numarasını yazmanız yeterlidir. Örneğin 1 girildiğinde kayıt PÇ-1, 2 girildiğinde PÇ-2 olarak oluşturulur; Excel içe aktarmada da aynı kural uygulanır."/>
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="Açıklama" Style="{StaticResource LabelStyle}"/>
                        <TextBox Text="{Binding FormDescription, UpdateSourceTrigger=PropertyChanged}"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 MinHeight="64"
                                 VerticalContentAlignment="Top"/>

                        <StackPanel Orientation="Horizontal" Margin="0,14,0,0" HorizontalAlignment="Right">
                            <Button Content="İptal"
                                    Command="{Binding StartNewCommand}"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Margin="0,0,8,0"/>
                            <Button Content="Kaydet"
                                    Command="{Binding SaveCommand}"
                                    Style="{StaticResource PrimaryButtonStyle}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource AlertErrorStyle}"
                        Margin="0,12,0,0"
                        Visibility="{Binding ErrorMessage, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="{Binding ErrorMessage}" Foreground="#991B1B" TextWrapping="Wrap"/>
                </Border>
                <Border Style="{StaticResource AlertSuccessStyle}"
                        Margin="0,12,0,0"
                        Visibility="{Binding SuccessMessage, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="{Binding SuccessMessage}" Foreground="#064E3B" TextWrapping="Wrap"/>
                </Border>
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding ProgramOutcomes}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource CardStyle}" Padding="16">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="80"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" Background="{StaticResource PrimaryLightBrush}" CornerRadius="6" Padding="8,6"
                                        VerticalAlignment="Top" HorizontalAlignment="Left">
                                    <TextBlock Text="{Binding Code}" Foreground="{StaticResource PrimaryBrush}"
                                               FontWeight="Bold" FontSize="14"/>
                                </Border>

                                <StackPanel Grid.Column="1" Margin="14,0">
                                    <TextBlock Text="{Binding Description}"
                                               TextWrapping="Wrap"
                                               FontWeight="SemiBold"
                                               FontSize="14"
                                               Margin="0,4,0,0"/>
                                    <TextBlock Margin="0,6,0,0" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}">
                                        <Run Text="{Binding LearningOutcomeCount}"/>
                                        <Run Text=" ÖÇ ile eşlenmiş"/>
                                    </TextBlock>
                                </StackPanel>

                                <Button Grid.Column="2"
                                        Content="Düzenle"
                                        Command="{Binding DataContext.StartEditCommand,
                                                  RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Padding="12,6"
                                        Margin="0,0,6,0"
                                        FontWeight="SemiBold"/>

                                <Button Grid.Column="3"
                                        Content="Sil"
                                        Command="{Binding DataContext.DeleteCommand,
                                                  RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}"
                                        Style="{StaticResource DangerButtonStyle}"
                                        Padding="10,6"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <views:LoadingOverlay Grid.RowSpan="3"
                              Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}"/>
    </Grid>
</UserControl>
