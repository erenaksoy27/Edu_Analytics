<UserControl x:Class="EduAnalytics.UI.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:EduAnalytics.UI.ViewModels"
             xmlns:views="clr-namespace:EduAnalytics.UI.Views"
             xmlns:mi="clr-namespace:Material.Icons.WPF;assembly=Material.Icons.WPF"
             d:DataContext="{d:DesignInstance Type=vm:DashboardViewModel}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006">

    <UserControl.Resources>
        <Style x:Key="DashboardSectionLabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style x:Key="DashboardSmallMetricStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel>
                <TextBlock Text="Dashboard" Style="{StaticResource HeadingStyle}"/>
                <TextBlock Text="Sınav performansı, güvenilirlik ve öğrenim çıktısı risklerini tek ekranda izleyin."
                           Foreground="{StaticResource TextSecondaryBrush}"/>
            </StackPanel>

            <Border Grid.Column="1"
                    Style="{StaticResource CardSubtleStyle}"
                    Padding="12,8"
                    VerticalAlignment="Top">
                <StackPanel Orientation="Horizontal">
                    <Ellipse Width="8" Height="8" Fill="{StaticResource SuccessBrush}" VerticalAlignment="Center"/>
                    <TextBlock Text="Güncel veriler"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               FontWeight="SemiBold"
                               Margin="8,0,0,0"/>
                </StackPanel>
            </Border>
        </Grid>

        <UniformGrid Grid.Row="1" Rows="1" Columns="4" Margin="0,0,0,18">

            <Border Style="{StaticResource MetricCardStyle}" Margin="0,0,10,0">
                <StackPanel>
                    <mi:MaterialIcon Kind="FileDocumentMultipleOutline"
                                     Width="22" Height="22"
                                     Foreground="{StaticResource PrimaryBrush}"
                                     HorizontalAlignment="Left"
                                     Margin="0,0,0,10"/>
                    <TextBlock Text="{Binding Exams.Count}"
                               Style="{StaticResource MetricValueStyle}"/>
                    <TextBlock Text="Sınav"
                               Style="{StaticResource MetricLabelStyle}"
                               Margin="0,4,0,0"/>
                    <TextBlock Text="analize hazır"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               FontSize="12" Margin="0,2,0,0"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource MetricCardStyle}" Margin="4,0,8,0">
                <StackPanel>
                    <mi:MaterialIcon Kind="AccountGroup"
                                     Width="22" Height="22"
                                     Foreground="{StaticResource SuccessBrush}"
                                     HorizontalAlignment="Left"
                                     Margin="0,0,0,10"/>
                    <TextBlock Text="{Binding StudentCount}"
                               Style="{StaticResource MetricValueStyle}"/>
                    <TextBlock Text="Öğrenci"
                               Style="{StaticResource MetricLabelStyle}"
                               Margin="0,4,0,0"/>
                    <TextBlock Text="kayıtlı öğrenci"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               FontSize="12" Margin="0,2,0,0"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource MetricCardStyle}" Margin="8,0,4,0">
                <StackPanel>
                    <mi:MaterialIcon Kind="ChartLineVariant"
                                     Width="22" Height="22"
                                     Foreground="{StaticResource WarningBrush}"
                                     HorizontalAlignment="Left"
                                     Margin="0,0,0,10"/>
                    <TextBlock Text="{Binding OverallAverageSuccessRate, StringFormat={}{0:N1}%}"
                               Style="{StaticResource MetricValueStyle}"/>
                    <TextBlock Text="Ort. Başarı"
                               Style="{StaticResource MetricLabelStyle}"
                               Margin="0,4,0,0"/>
                    <TextBlock Text="tüm sınavlarda"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               FontSize="12" Margin="0,2,0,0"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource MetricCardStyle}" Margin="10,0,0,0">
                <StackPanel>
                    <mi:MaterialIcon Kind="CalendarClock"
                                     Width="22" Height="22"
                                     Foreground="{StaticResource InfoBrush}"
                                     HorizontalAlignment="Left"
                                     Margin="0,0,0,10"/>
                    <TextBlock Text="{Binding LastActivityDate}"
                               Style="{StaticResource MetricValueStyle}"
                               FontSize="18"/>
                    <TextBlock Text="Son Aktivite"
                               Style="{StaticResource MetricLabelStyle}"
                               Margin="0,4,0,0"/>
                    <TextBlock Text="en güncel sınav"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               FontSize="12" Margin="0,2,0,0"/>
                </StackPanel>
            </Border>

        </UniformGrid>

        <Grid Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Sınav Performans Listesi"
                           Style="{StaticResource SubheadingStyle}"
                           Margin="0"/>
                <TextBlock Grid.Column="1"
                           Text="Kartlara tıklayarak detaylı analize geçin"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           FontSize="12"
                           VerticalAlignment="Center"/>
            </Grid>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Exams}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border>
                                <Border.InputBindings>
                                    <MouseBinding MouseAction="LeftClick"
                                                  Command="{Binding DataContext.OpenAnalysisCommand,
                                                              RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                  CommandParameter="{Binding}"/>
                                </Border.InputBindings>
                                <Border.Style>
                                    <Style TargetType="Border" BasedOn="{StaticResource CardStyle}">
                                        <Setter Property="Cursor" Value="Hand"/>
                                        <Setter Property="Padding" Value="18"/>
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/>
                                                <Setter Property="Background" Value="#FCFDFF"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>

                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <Grid Grid.Row="0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" Margin="0,0,18,0">
                                            <TextBlock Text="{Binding ExamTitle}"
                                                       FontSize="17"
                                                       FontWeight="SemiBold"
                                                       Foreground="{StaticResource TextPrimaryBrush}"/>
                                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                                <TextBlock Text="{Binding CourseName}"
                                                           Foreground="{StaticResource TextSecondaryBrush}"/>
                                                <TextBlock Text="  /  " Foreground="{StaticResource SubtleBrush}"/>
                                                <TextBlock Text="{Binding ExamDate, StringFormat='{}{0:dd.MM.yyyy}'}"
                                                           Foreground="{StaticResource TextSecondaryBrush}"/>
                                            </StackPanel>
                                        </StackPanel>

                                        <StackPanel Grid.Column="1"
                                                    Width="112"
                                                    ToolTip="Bu sınava cevap giren öğrenci sayısıdır. Sınıf büyüklüğünü anlamak için kullanılır.">
                                            <TextBlock Text="{Binding TotalStudents}"
                                                       Style="{StaticResource DashboardSmallMetricStyle}"
                                                       HorizontalAlignment="Center"/>
                                            <TextBlock Text="Öğrenci"
                                                       Style="{StaticResource MetricLabelStyle}"
                                                       HorizontalAlignment="Center"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="2"
                                                    Width="112"
                                                    ToolTip="Sınavdaki aktif soru sayısıdır. İptal edilen sorular analizden çıkarılır.">
                                            <TextBlock Text="{Binding TotalQuestions}"
                                                       Style="{StaticResource DashboardSmallMetricStyle}"
                                                       HorizontalAlignment="Center"/>
                                            <TextBlock Text="Soru"
                                                       Style="{StaticResource MetricLabelStyle}"
                                                       HorizontalAlignment="Center"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="3"
                                                    Width="134"
                                                    ToolTip="Ortalama başarı = öğrencilerin ortalama puanı / sınav tam puanı x 100. Sınıfın genel düzeyini gösterir.">
                                            <TextBlock HorizontalAlignment="Center"
                                                       Foreground="{StaticResource SuccessBrush}"
                                                       FontSize="20"
                                                       FontWeight="Bold">
                                                <Run Text="%"/>
                                                <Run Text="{Binding AverageSuccessRate}"/>
                                            </TextBlock>
                                            <TextBlock Text="Ortalama Başarı"
                                                       Style="{StaticResource MetricLabelStyle}"
                                                       HorizontalAlignment="Center"/>
                                        </StackPanel>

                                        <Border Grid.Column="4"
                                                Background="{StaticResource PrimaryLightBrush}"
                                                CornerRadius="8"
                                                Padding="10,8"
                                                VerticalAlignment="Center">
                                            <TextBlock Text="Detay"
                                                       Foreground="{StaticResource PrimaryBrush}"
                                                       FontWeight="SemiBold"/>
                                        </Border>
                                    </Grid>

                                    <Border Grid.Row="1"
                                            Background="{StaticResource PageBgBrush}"
                                            BorderBrush="{StaticResource BorderSubtleBrush}"
                                            BorderThickness="1"
                                            CornerRadius="8"
                                            Padding="14"
                                            Margin="0,16,0,0">
                                        <UniformGrid Rows="1" Columns="5">
                                            <StackPanel ToolTip="Ortanca, puanlar sıralandığında tam ortada kalan değerdir. Aşırı düşük veya yüksek puanlardan ortalamaya göre daha az etkilenir.">
                                                <TextBlock Text="{Binding MedianScore, StringFormat={}{0:N2}}"
                                                           Style="{StaticResource DashboardSmallMetricStyle}"/>
                                                <TextBlock Text="Ortanca" Style="{StaticResource MetricLabelStyle}"/>
                                            </StackPanel>
                                            <StackPanel ToolTip="Cronbach alfa, testin iç tutarlılığını gösterir. 0.70 ve üzeri genelde kabul edilebilir, 0.80 üzeri güçlü kabul edilir.">
                                                <TextBlock Text="{Binding CronbachAlpha, StringFormat={}{0:N3}}"
                                                           Style="{StaticResource DashboardSmallMetricStyle}"
                                                           Foreground="{StaticResource PrimaryBrush}"/>
                                                <TextBlock Text="Cronbach α" Style="{StaticResource MetricLabelStyle}"/>
                                            </StackPanel>
                                            <StackPanel ToolTip="Geçme oranı = geçme eşiğini aşan öğrenci sayısı / tüm öğrenciler x 100.">
                                                <TextBlock Foreground="{StaticResource SuccessBrush}"
                                                           FontSize="18"
                                                           FontWeight="Bold">
                                                    <Run Text="%"/>
                                                    <Run Text="{Binding PassRate, StringFormat={}{0:N1}}"/>
                                                </TextBlock>
                                                <TextBlock Text="Geçme Oranı" Style="{StaticResource MetricLabelStyle}"/>
                                            </StackPanel>
                                            <StackPanel ToolTip="Ortalama güçlük p, test sorularında doğru cevap oranıdır. 0'a yaklaştıkça soru zor, 1'e yaklaştıkça soru kolaydır.">
                                                <TextBlock Text="{Binding AverageDifficultyIndex, StringFormat={}{0:N3}}"
                                                           Style="{StaticResource DashboardSmallMetricStyle}"
                                                           Foreground="#B45309"/>
                                                <TextBlock Text="Ort. Güçlük" Style="{StaticResource MetricLabelStyle}"/>
                                            </StackPanel>
                                            <StackPanel ToolTip="En düşük ÖÇ, öğrenim çıktıları içinde öğrencilerin en zorlandığı çıktıdır. Müdahale veya tekrar planı için ilk sinyaldir.">
                                                <TextBlock Foreground="{StaticResource DangerBrush}"
                                                           FontSize="18"
                                                           FontWeight="Bold">
                                                    <Run Text="%"/>
                                                    <Run Text="{Binding LowestLearningOutcomeSuccessRate, StringFormat={}{0:N1}}"/>
                                                </TextBlock>
                                                <TextBlock Text="En Düşük ÖÇ" Style="{StaticResource MetricLabelStyle}"/>
                                            </StackPanel>
                                        </UniformGrid>
                                    </Border>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>

        <views:LoadingOverlay Grid.Row="0" Grid.RowSpan="3"
                              Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}"/>
    </Grid>
</UserControl>
