<UserControl x:Class="EduAnalytics.UI.Views.ExamAnalysisView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:EduAnalytics.UI.ViewModels"
             xmlns:views="clr-namespace:EduAnalytics.UI.Views"
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
             d:DataContext="{d:DesignInstance Type=vm:ExamAnalysisViewModel}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006">

    <UserControl.Resources>
        <Style x:Key="StatValueStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="22"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="StatCaptionStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,4,0,0"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Üst Şerit: Başlık + Eylemler -->
        <Grid Grid.Row="0" Margin="0,0,0,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="{Binding Summary.ExamTitle, FallbackValue='Sınav Analizi'}"
                           Style="{StaticResource HeadingStyle}"/>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding Summary.CourseName}"
                               Foreground="{StaticResource TextSecondaryBrush}"/>
                    <TextBlock Text=" · " Foreground="{StaticResource SubtleBrush}"/>
                    <TextBlock Text="{Binding Summary.ExamDate, StringFormat='{}{0:dd.MM.yyyy}'}"
                               Foreground="{StaticResource TextSecondaryBrush}"/>
                </StackPanel>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                <Button Content="Rapor Çıktısı (PDF)"
                        Command="{Binding ExportReportCommand}"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Margin="0,0,8,0"/>
                <Button Content="Cevap Girişi"
                        Command="{Binding OpenAnswerEntryCommand}"
                        Style="{StaticResource PrimaryButtonStyle}"/>
            </StackPanel>
        </Grid>

        <!-- Sekmeler -->
        <TabControl Grid.Row="1">

            <!-- ═══ SEKME 1: ÖZET ═══ -->
            <TabItem Header="Özet">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,16,0,0">
                    <StackPanel>
                        <UniformGrid Rows="1" Columns="4" Margin="0,0,0,4">
                            <Border Style="{StaticResource MetricCardStyle}" Margin="0,0,8,0">
                                <StackPanel>
                                    <TextBlock Text="ÖĞRENCİ SAYISI" Style="{StaticResource MetricLabelStyle}"/>
                                    <TextBlock Text="{Binding Summary.TotalStudents}"
                                               Style="{StaticResource MetricValueStyle}"
                                               Margin="0,8,0,0"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource MetricCardStyle}" Margin="4,0">
                                <StackPanel>
                                    <TextBlock Text="ORTALAMA PUAN" Style="{StaticResource MetricLabelStyle}"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                        <TextBlock Text="{Binding Summary.AverageScore, StringFormat='{}{0:0.00}'}"
                                                   Style="{StaticResource MetricValueStyle}"/>
                                        <TextBlock Text=" / "
                                                   Style="{StaticResource MetricValueStyle}"
                                                   Foreground="{StaticResource SubtleBrush}"/>
                                        <TextBlock Text="{Binding Summary.MaxPossibleScore, StringFormat='{}{0:0.#}'}"
                                                   Style="{StaticResource MetricValueStyle}"
                                                   Foreground="{StaticResource SubtleBrush}"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource MetricCardStyle}" Margin="4,0">
                                <StackPanel>
                                    <TextBlock Text="BAŞARI ORANI" Style="{StaticResource MetricLabelStyle}"/>
                                    <TextBlock Style="{StaticResource MetricValueStyle}"
                                               Foreground="{StaticResource SuccessBrush}"
                                               Margin="0,8,0,0">
                                        <Run Text="%"/>
                                        <Run Text="{Binding Summary.AverageSuccessRate}"/>
                                    </TextBlock>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource MetricCardStyle}" Margin="8,0,0,0">
                                <StackPanel>
                                    <TextBlock Text="EN YÜKSEK / EN DÜŞÜK" Style="{StaticResource MetricLabelStyle}"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                        <TextBlock Text="{Binding Summary.HighestScore}"
                                                   Style="{StaticResource MetricValueStyle}"
                                                   Foreground="{StaticResource SuccessBrush}"/>
                                        <TextBlock Text=" / "
                                                   Style="{StaticResource MetricValueStyle}"
                                                   Foreground="{StaticResource SubtleBrush}"/>
                                        <TextBlock Text="{Binding Summary.LowestScore}"
                                                   Style="{StaticResource MetricValueStyle}"
                                                   Foreground="{StaticResource DangerBrush}"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </UniformGrid>

                        <Grid Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="1*"/>
                            </Grid.ColumnDefinitions>

                            <Border Style="{StaticResource CardStyle}" Grid.Column="0" Margin="0,0,8,14">
                                <StackPanel>
                                    <TextBlock Text="Sınıf Puan Dağılımı"
                                               Style="{StaticResource SubheadingStyle}"/>
                                    <TextBlock Text="Öğrenci sayısının puan aralıklarına göre dağılımı"
                                               Style="{StaticResource CaptionStyle}"
                                               Margin="0,-8,0,12"/>
                                    <lvc:CartesianChart Height="250"
                                                        Series="{Binding ScoreDistributionSeries}"
                                                        XAxes="{Binding ScoreDistributionXAxes}"/>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource CardStyle}" Grid.Column="1" Margin="8,0,0,14">
                                <StackPanel>
                                    <TextBlock Text="Genel Doğru Oranı"
                                               Style="{StaticResource SubheadingStyle}"/>
                                    <TextBlock Text="Tüm sorularda doğru / yanlış / boş payı"
                                               Style="{StaticResource CaptionStyle}"
                                               Margin="0,-8,0,12"/>
                                    <lvc:PieChart Height="250"
                                                  Series="{Binding SuccessRateDoughnutSeries}"
                                                  LegendPosition="Bottom"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <TextBlock Text="Soru Bazlı Başarı Oranları"
                                           Style="{StaticResource SubheadingStyle}"/>
                                <lvc:CartesianChart Height="280"
                                                    Series="{Binding QuestionSuccessSeries}"
                                                    XAxes="{Binding QuestionXAxes}"
                                                    YAxes="{Binding QuestionYAxes}"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ═══ SEKME 2: ÖĞRENİM ÇIKTILARI ═══ -->
            <TabItem Header="Öğrenim Çıktıları">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,16,0,0">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border Style="{StaticResource CardStyle}" Grid.Column="0" Margin="0,0,8,14">
                                <StackPanel>
                                    <TextBlock Text="Çıktı Kapsam Yüzeyi"
                                               Style="{StaticResource SubheadingStyle}"
                                               ToolTip="Her öğrenim çıktısında sınıfın ortalama başarısını gösterir. Düşük kalan alanlar tekrar veya destek gerektirebilir."/>
                                    <lvc:PolarChart Height="280"
                                                    Series="{Binding RadarSeries}"
                                                    AngleAxes="{Binding RadarAxes}"/>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource CardStyle}" Grid.Column="1" Margin="8,0,0,14">
                                <StackPanel>
                                    <TextBlock Text="Çıktı Başarı Dağılımı"
                                               Style="{StaticResource SubheadingStyle}"
                                               ToolTip="Başarı oranı = ilgili öğrenim çıktısındaki kazanılan puan / alınabilecek puan x 100."/>
                                    <lvc:CartesianChart Height="280"
                                                        Series="{Binding LearningOutcomeChartSeries}"
                                                        XAxes="{Binding LearningOutcomeChartXAxes}"
                                                        YAxes="{Binding LearningOutcomeChartYAxes}"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <TextBlock Text="Detaylı Çıktı Performansı"
                                           Style="{StaticResource SubheadingStyle}"
                                           ToolTip="ÖÇ, ders sonunda öğrencinin kazanması beklenen bilgi veya beceridir. Bu tablo her ÖÇ için kaç soru sorulduğunu ve sınıf başarısını gösterir."/>
                                <DataGrid ItemsSource="{Binding LearningOutcomes}">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Çıktı" Binding="{Binding OutcomeName}" Width="*"/>
                                        <DataGridTextColumn Header="Açıklama" Binding="{Binding Description}" Width="2*"/>
                                        <DataGridTextColumn Header="Soru" Binding="{Binding RelatedQuestionCount}" Width="80"/>
                                        <DataGridTextColumn Header="Başarı %" Binding="{Binding SuccessRate, StringFormat=N1}" Width="100"/>
                                        <DataGridTemplateColumn Header="Seviye" Width="120">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Border Style="{StaticResource BadgeStyle}"
                                                            Background="{Binding PerformanceLevel, Converter={StaticResource LevelToBrush}}"
                                                            VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding PerformanceLevel}"
                                                                   Foreground="White"
                                                                   FontSize="11"
                                                                   FontWeight="SemiBold"/>
                                                    </Border>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ═══ SEKME 3: SORULAR (Çeldirici + Sınav Soruları birleşik) ═══ -->
            <TabItem Header="Sorular">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,16,0,0">
                    <StackPanel>
                        <!-- Sınav Soruları (yönetim — iptal) -->
                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <TextBlock Text="Sınav Soruları"
                                           Style="{StaticResource SubheadingStyle}"/>
                                <DataGrid ItemsSource="{Binding Questions}" RowHeight="44">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="No" Binding="{Binding QuestionNumber}" Width="60"/>
                                        <DataGridTextColumn Header="Soru Metni" Binding="{Binding QuestionText}" Width="*"/>
                                        <DataGridTextColumn Header="Tür" Binding="{Binding QuestionType}" Width="110"/>
                                        <DataGridTextColumn Header="Puan" Binding="{Binding MaxPoints, StringFormat=N1}" Width="70"/>
                                        <DataGridTextColumn Header="Cevap" Binding="{Binding CorrectOption}" Width="70"/>
                                        <DataGridTemplateColumn Header="" Width="90">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Button Content="İptal"
                                                            Command="{Binding DataContext.CancelQuestionCommand,
                                                                      RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}"
                                                            Style="{StaticResource DangerButtonStyle}"
                                                            Padding="10,4"
                                                            FontSize="11"
                                                            HorizontalAlignment="Center"
                                                            ToolTip="Bu soru iptal edilirse analizlerde puan ve başarı hesaplarına dahil edilmez."/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </StackPanel>
                        </Border>

                        <!-- Çeldirici Uyarı Kutusu -->
                        <Border Style="{StaticResource CardStyle}"
                                Background="#FFFBEB"
                                BorderBrush="#FCD34D"
                                Visibility="{Binding StrongDistractors.Count, Converter={StaticResource BoolToVisibility}}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                    <Border Width="8" Height="8" CornerRadius="4"
                                            Background="{StaticResource WarningBrush}"
                                            VerticalAlignment="Center"/>
                                    <TextBlock Text="Güçlü Çeldirici Tespit Edilen Sorular"
                                               FontSize="15" FontWeight="SemiBold"
                                               Foreground="#92400E"
                                               Margin="10,0,0,0"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock Text="Yanlış yapan öğrencilerin %50'sinden fazlasının aynı şıkkı seçtiği sorular."
                                           Foreground="#78350F"
                                           Margin="0,2,0,12"/>
                                <ItemsControl ItemsSource="{Binding StrongDistractors}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{StaticResource CardBgBrush}"
                                                    BorderBrush="{StaticResource BorderSubtleBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="6"
                                                    Padding="12,9"
                                                    Margin="0,0,0,6">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock FontWeight="SemiBold"
                                                               Foreground="{StaticResource TextPrimaryBrush}">
                                                        <Run Text="Soru "/>
                                                        <Run Text="{Binding QuestionNumber}"/>
                                                    </TextBlock>
                                                    <TextBlock Text="  ·  Doğru: "
                                                               Foreground="{StaticResource TextSecondaryBrush}"/>
                                                    <TextBlock Text="{Binding CorrectOption}"
                                                               FontWeight="SemiBold"
                                                               Foreground="{StaticResource SuccessBrush}"/>
                                                    <TextBlock Text="  ·  Çeldirici: "
                                                               Foreground="{StaticResource TextSecondaryBrush}"/>
                                                    <TextBlock Text="{Binding StrongestDistractorOption}"
                                                               FontWeight="SemiBold"
                                                               Foreground="{StaticResource DangerBrush}"/>
                                                    <TextBlock Foreground="{StaticResource TextSecondaryBrush}">
                                                        <Run Text="  ("/>
                                                        <Run Text="{Binding StrongestDistractorCount}"/>
                                                        <Run Text=" kişi · %"/>
                                                        <Run Text="{Binding StrongestDistractorRate}"/>
                                                        <Run Text=")"/>
                                                    </TextBlock>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <!-- Şık Dağılımı Tablosu -->
                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <TextBlock Text="Tüm Soruların Şık Dağılımı"
                                           Style="{StaticResource SubheadingStyle}"/>
                                <DataGrid ItemsSource="{Binding Questions}" RowHeight="36">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Soru" Binding="{Binding QuestionNumber}" Width="55"/>
                                        <DataGridTextColumn Header="Tür" Binding="{Binding QuestionType}" Width="100"/>
                                        <DataGridTextColumn Header="Puan" Binding="{Binding MaxPoints, StringFormat=N1}" Width="60"/>
                                        <DataGridTextColumn Header="Doğru" Binding="{Binding CorrectOption}" Width="60"/>
                                        <DataGridTextColumn Header="Başarı %" Binding="{Binding SuccessRate, StringFormat=N1}" Width="80"/>
                                        <DataGridTextColumn Header="A" Binding="{Binding OptionACount}" Width="45"/>
                                        <DataGridTextColumn Header="B" Binding="{Binding OptionBCount}" Width="45"/>
                                        <DataGridTextColumn Header="C" Binding="{Binding OptionCCount}" Width="45"/>
                                        <DataGridTextColumn Header="D" Binding="{Binding OptionDCount}" Width="45"/>
                                        <DataGridTextColumn Header="E" Binding="{Binding OptionECount}" Width="45"/>
                                        <DataGridTextColumn Header="Çeldirici" Binding="{Binding StrongestDistractorOption}" Width="90"/>
                                        <DataGridTextColumn Header="Çeld. %" Binding="{Binding StrongestDistractorRate, StringFormat=N1}" Width="80"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ═══ SEKME 5: SINAV DENGESİ ═══ -->
            <TabItem Header="Sınav Dengesi">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,16,0,0">
                    <StackPanel>
                        <Border Style="{StaticResource CardStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Margin="0,0,32,0">
                                    <TextBlock Text="DENGE SKORU" Style="{StaticResource MetricLabelStyle}"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                        <TextBlock Text="{Binding BalanceReport.BalanceScore, FallbackValue='—'}"
                                                   Style="{StaticResource MetricValueStyle}"
                                                   Foreground="{StaticResource SuccessBrush}"/>
                                        <TextBlock Text="/100"
                                                   FontSize="18"
                                                   Foreground="{StaticResource SubtleBrush}"
                                                   VerticalAlignment="Bottom"
                                                   Margin="2,0,0,4"/>
                                    </StackPanel>
                                </StackPanel>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="Soruların öğrenim çıktıları arasında ne kadar dengeli dağıldığını gösterir."
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               TextWrapping="Wrap"/>
                                    <TextBlock Margin="0,6,0,0"
                                               Style="{StaticResource CaptionStyle}">
                                        <Run Text="80–100 Mükemmel"/>
                                        <Run Text="  ·  "/>
                                        <Run Text="60–80 İyi"/>
                                        <Run Text="  ·  "/>
                                        <Run Text="40–60 Orta"/>
                                        <Run Text="  ·  "/>
                                        <Run Text="0–40 Dengesiz"/>
                                    </TextBlock>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource CardStyle}"
                                Visibility="{Binding BalanceReport.Warnings.Count, Converter={StaticResource BoolToVisibility}}">
                            <StackPanel>
                                <TextBlock Text="Uyarılar" Style="{StaticResource SubheadingStyle}"/>
                                <ItemsControl ItemsSource="{Binding BalanceReport.Warnings}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border CornerRadius="6"
                                                    Padding="12,10"
                                                    Margin="0,0,0,8"
                                                    BorderThickness="1,1,1,3">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="#FFFBEB"/>
                                                        <Setter Property="BorderBrush" Value="{StaticResource WarningBrush}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Severity}" Value="Critical">
                                                                <Setter Property="Background" Value="#FEF2F2"/>
                                                                <Setter Property="BorderBrush" Value="{StaticResource DangerBrush}"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Severity}" Value="Info">
                                                                <Setter Property="Background" Value="{StaticResource PrimaryLightBrush}"/>
                                                                <Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Severity}"
                                                               FontWeight="SemiBold"
                                                               FontSize="11"
                                                               Foreground="{StaticResource TextSecondaryBrush}"/>
                                                    <TextBlock Text="{Binding Message}"
                                                               TextWrapping="Wrap"
                                                               Margin="0,3,0,0"
                                                               Foreground="{StaticResource TextPrimaryBrush}"/>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource AlertSuccessStyle}"
                                Margin="0,0,0,14"
                                Visibility="{Binding BalanceReport.Warnings.Count, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}">
                            <StackPanel>
                                <TextBlock Text="Sınav dengeli görünüyor"
                                           FontWeight="SemiBold"
                                           Foreground="#065F46"/>
                                <TextBlock Text="Soru dağılımı öğrenim çıktıları arasında makul biçimde yayılmış."
                                           Foreground="#047857"
                                           Margin="0,3,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <TextBlock Text="Öğrenim Çıktısı Kapsamı"
                                           Style="{StaticResource SubheadingStyle}"
                                           ToolTip="Bu tablo her öğrenim çıktısına kaç soru bağlandığını ve sınav içindeki yüzdesini gösterir."/>
                                <DataGrid ItemsSource="{Binding BalanceReport.LearningOutcomeCoverage}">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Kod" Binding="{Binding Code}" Width="80"/>
                                        <DataGridTextColumn Header="Öğrenim Çıktısı" Binding="{Binding Name}" Width="*"/>
                                        <DataGridTextColumn Header="Soru" Binding="{Binding QuestionCount}" Width="70"/>
                                        <DataGridTextColumn Header="Yüzde" Binding="{Binding Percentage, StringFormat={}{0:N1}%}" Width="90"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ═══ SEKME 6: İSTATİSTİKLER (Sınav istatistikleri + Madde analizi) ═══ -->
            <TabItem Header="İstatistikler">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,16,0,0">
                    <StackPanel>
                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <TextBlock Text="Sınav Betimsel İstatistikleri"
                                           Style="{StaticResource SubheadingStyle}"/>
                                <TextBlock Text="Merkezi eğilim, dağılım, şekil ve iç tutarlılık ölçüleri."
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           Margin="0,-8,0,14"/>

                                <Border Background="{StaticResource PageBgBrush}"
                                        BorderBrush="{StaticResource BorderSubtleBrush}"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        Padding="14,10">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="Geçme Eşiği (%)"
                                                   VerticalAlignment="Center"
                                                   FontWeight="SemiBold"/>
                                        <TextBox Width="80"
                                                 Text="{Binding AcceptabilityIndex, UpdateSourceTrigger=LostFocus}"
                                                 Margin="12,0,0,0"/>
                                        <TextBlock Text="Geçme Notu:"
                                                   VerticalAlignment="Center"
                                                   Margin="24,0,8,0"
                                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                                        <TextBlock Text="{Binding Statistics.PassingScore, StringFormat={}{0:N2}, FallbackValue='—'}"
                                                   VerticalAlignment="Center"
                                                   FontWeight="Bold"
                                                   FontSize="15"
                                                   Foreground="{StaticResource PrimaryBrush}"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>

                        <UniformGrid Rows="1" Columns="4" Margin="0,0,0,14">
                            <Border Style="{StaticResource MetricCardStyle}" Margin="0,0,4,0">
                                <StackPanel ToolTip="Aritmetik ortalama, tüm öğrencilerin aldığı puanların toplamının öğrenci sayısına bölünmesiyle hesaplanır. Sınıfın sınavdaki genel performans düzeyini hızlıca okumak için kullanılır. Ancak çok düşük veya çok yüksek birkaç puan varsa ortalama bu uç değerlerden etkilenebilir; bu yüzden ortanca ve standart sapma ile birlikte yorumlanmalıdır.">
                                    <TextBlock Text="ARİTMETİK ORTALAMA" Style="{StaticResource MetricLabelStyle}"/>
                                    <TextBlock Text="{Binding Statistics.Mean, StringFormat={}{0:N2}, FallbackValue='—'}"
                                               Style="{StaticResource MetricValueStyle}"
                                               Margin="0,8,0,0"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource MetricCardStyle}" Margin="4,0">
                                <StackPanel ToolTip="Ortanca, puanlar küçükten büyüğe sıralandığında tam ortada kalan değerdir. Öğrencilerin yarısı bu puanın altında, yarısı üstünde yer alır. Uç değerlerden aritmetik ortalamaya göre daha az etkilendiği için özellikle sınıfta birkaç çok düşük veya çok yüksek puan olduğunda daha dengeli bir merkez bilgisi verir.">
                                    <TextBlock Text="ORTANCA" Style="{StaticResource MetricLabelStyle}"/>
                                    <TextBlock Text="{Binding Statistics.Median, StringFormat={}{0:N2}, FallbackValue='—'}"
                                               Style="{StaticResource MetricValueStyle}"
                                               Margin="0,8,0,0"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource MetricCardStyle}" Margin="4,0">
                                <StackPanel ToolTip="Tepe değer, sınıfta en sık tekrar eden puandır. Öğrencilerin hangi puan çevresinde yoğunlaştığını ve sınav sonucunda en tipik puan davranışının nerede oluştuğunu gösterir.">
                                    <TextBlock Text="TEPE DEĞER" Style="{StaticResource MetricLabelStyle}"/>
                                    <TextBlock Text="{Binding Statistics.Mode, StringFormat={}{0:N2}, FallbackValue='—'}"
                                               Style="{StaticResource MetricValueStyle}"
                                               Margin="0,8,0,0"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource MetricCardStyle}" Margin="4,0,0,0">
                                <StackPanel ToolTip="Ranj, en yüksek puandan en düşük puanın çıkarılmasıyla bulunur. Sınavdaki en başarılı öğrenci ile en düşük performans arasındaki toplam mesafeyi gösterir.">
                                    <TextBlock Text="RANJ" Style="{StaticResource MetricLabelStyle}"/>
                                    <TextBlock Text="{Binding Statistics.Range, StringFormat={}{0:N2}, FallbackValue='—'}"
                                               Style="{StaticResource MetricValueStyle}"
                                               Margin="0,8,0,0"/>
                                </StackPanel>
                            </Border>
                        </UniformGrid>

                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <TextBlock Text="Konum Ölçüleri (Çeyrekler)"
                                           Style="{StaticResource SubheadingStyle}"/>
                                <UniformGrid Rows="1" Columns="5" Margin="0,8,0,0">
                                    <StackPanel ToolTip="Q1 birinci çeyrektir. Puanlar küçükten büyüğe sıralandığında öğrencilerin yaklaşık yüzde 25'i bu değerin altında, yüzde 75'i üstünde kalır.">
                                        <TextBlock Text="{Binding Statistics.Q1, StringFormat={}{0:N2}, FallbackValue='—'}"
                                                   Style="{StaticResource StatValueStyle}"/>
                                        <TextBlock Text="Q1" Style="{StaticResource StatCaptionStyle}"/>
                                    </StackPanel>
                                    <StackPanel ToolTip="Q3 üçüncü çeyrektir. Puanlar küçükten büyüğe sıralandığında öğrencilerin yaklaşık yüzde 75'i bu değerin altında, yüzde 25'i üstünde kalır.">
                                        <TextBlock Text="{Binding Statistics.Q3, StringFormat={}{0:N2}, FallbackValue='—'}"
                                                   Style="{StaticResource StatValueStyle}"/>
                                        <TextBlock Text="Q3" Style="{StaticResource StatCaptionStyle}"/>
                                    </StackPanel>
                                    <StackPanel ToolTip="IQR, Q3 ile Q1 arasındaki farktır. En düşük ve en yüksek uçları dışarıda bırakarak sınıfın ortadaki yüzde 50'lik bölümünün ne kadar yayıldığını gösterir.">
                                        <TextBlock Text="{Binding Statistics.InterquartileRange, StringFormat={}{0:N2}, FallbackValue='—'}"
                                                   Style="{StaticResource StatValueStyle}"/>
                                        <TextBlock Text="IQR (Q3−Q1)" Style="{StaticResource StatCaptionStyle}"/>
                                    </StackPanel>
                                    <StackPanel ToolTip="Çeyrek kayma, IQR değerinin ikiye bölünmesiyle hesaplanır. Orta gruptaki puanların ortanca çevresinde yaklaşık ne kadar dağıldığını daha okunabilir bir ölçüye indirger.">
                                        <TextBlock Text="{Binding Statistics.SemiInterquartileRange, StringFormat={}{0:N2}, FallbackValue='—'}"
                                                   Style="{StaticResource StatValueStyle}"/>
                                        <TextBlock Text="Çeyrek Kayma" Style="{StaticResource StatCaptionStyle}"/>
                                    </StackPanel>
                                    <StackPanel ToolTip="ÇKDK, çeyrekler arası göreli değişkenlik katsayısıdır: (Q3 - Q1) / (Q3 + Q1). Puan ölçeği veya toplam puan farklı olsa bile sınavlar arasında orta grubun göreli yayılımını karşılaştırmayı kolaylaştırır.">
                                        <TextBlock Text="{Binding Statistics.QuartileCoefficient, StringFormat={}{0:N3}, FallbackValue='—'}"
                                                   Style="{StaticResource StatValueStyle}"/>
                                        <TextBlock Text="ÇKDK" Style="{StaticResource StatCaptionStyle}"/>
                                    </StackPanel>
                                </UniformGrid>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <TextBlock Text="Dağılım (Yayılım) Ölçüleri"
                                           Style="{StaticResource SubheadingStyle}"/>
                                <UniformGrid Rows="1" Columns="5" Margin="0,8,0,0">
                                    <StackPanel ToolTip="Standart sapma, puanların aritmetik ortalamadan ne kadar uzaklaştığını gösterir. Büyük değer, öğrenciler arasındaki başarı farkının arttığını ve sınıfın homojen olmadığını anlatır.">
                                        <TextBlock Text="{Binding Statistics.StandardDeviation, StringFormat={}{0:N2}, FallbackValue='—'}"
                                                   Style="{StaticResource StatValueStyle}"/>
                                        <TextBlock Text="Standart Sapma (σ)" Style="{StaticResource StatCaptionStyle}"/>
                                    </StackPanel>
                                    <StackPanel ToolTip="MAD, her öğrencinin puanının ortalamadan mutlak uzaklığının ortalamasıdır.">
                                        <TextBlock Text="{Binding Statistics.MeanAbsoluteDeviation, StringFormat={}{0:N2}, FallbackValue='—'}"
                                                   Style="{StaticResource StatValueStyle}"/>
                                        <TextBlock Text="MAD" Style="{StaticResource StatCaptionStyle}"/>
                                    </StackPanel>
                                    <StackPanel ToolTip="MedAD, puanların ortancadan ortalama mutlak uzaklığını gösterir.">
                                        <TextBlock Text="{Binding Statistics.MedianAbsoluteDeviation, StringFormat={}{0:N2}, FallbackValue='—'}"
                                                   Style="{StaticResource StatValueStyle}"/>
                                        <TextBlock Text="MedAD" Style="{StaticResource StatCaptionStyle}"/>
                                    </StackPanel>
                                    <StackPanel ToolTip="Standart hata, hesaplanan ortalamanın örneklemden örnekleme ne kadar değişebileceğini gösterir.">
                                        <TextBlock Text="{Binding Statistics.StandardError, StringFormat={}{0:N2}, FallbackValue='—'}"
                                                   Style="{StaticResource StatValueStyle}"/>
                                        <TextBlock Text="Standart Hata (SE)" Style="{StaticResource StatCaptionStyle}"/>
                                    </StackPanel>
                                    <StackPanel ToolTip="BDK/CV, standart sapmanın ortalamaya oranının yüzde olarak ifade edilmesidir.">
                                        <TextBlock Text="{Binding Statistics.CoefficientOfVariation, StringFormat={}{0:N2}, FallbackValue='—'}"
                                                   Style="{StaticResource StatValueStyle}"/>
                                        <TextBlock Text="BDK (CV %)" Style="{StaticResource StatCaptionStyle}"/>
                                    </StackPanel>
                                </UniformGrid>
                            </StackPanel>
                        </Border>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border Style="{StaticResource CardStyle}" Grid.Column="0" Margin="0,0,4,14">
                                <StackPanel>
                                    <TextBlock Text="Dağılım Şekli"
                                               Style="{StaticResource SubheadingStyle}"/>
                                    <UniformGrid Rows="1" Columns="2" Margin="0,8,0,0">
                                        <StackPanel ToolTip="Çarpıklık, puan dağılımının sağa veya sola kayıp kaymadığını gösterir. 0'a yakın değer daha dengeli bir dağılıma işaret eder.">
                                            <TextBlock Text="{Binding Statistics.Skewness, StringFormat={}{0:N3}, FallbackValue='—'}"
                                                       Style="{StaticResource StatValueStyle}"/>
                                            <TextBlock Text="Çarpıklık" Style="{StaticResource StatCaptionStyle}"/>
                                        </StackPanel>
                                        <StackPanel ToolTip="Basıklık, dağılımın normal dağılıma göre ne kadar sivri veya yayvan olduğunu gösterir.">
                                            <TextBlock Text="{Binding Statistics.Kurtosis, StringFormat={}{0:N3}, FallbackValue='—'}"
                                                       Style="{StaticResource StatValueStyle}"/>
                                            <TextBlock Text="Basıklık" Style="{StaticResource StatCaptionStyle}"/>
                                        </StackPanel>
                                    </UniformGrid>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource CardStyle}" Grid.Column="1" Margin="4,0,0,14">
                                <StackPanel ToolTip="Cronbach alfa, sınavdaki maddelerin aynı genel beceriyi veya kazanım alanını ne kadar tutarlı ölçtüğünü gösterir. 0.80 üzeri çoğu durumda güçlü iç tutarlılık olarak yorumlanır.">
                                    <TextBlock Text="İç Tutarlılık (Cronbach α)"
                                               Style="{StaticResource SubheadingStyle}"/>
                                    <TextBlock Text="{Binding Statistics.CronbachAlpha, StringFormat={}{0:N3}, FallbackValue='—'}"
                                               FontSize="34"
                                               FontWeight="Bold"
                                               HorizontalAlignment="Center"
                                               Foreground="{StaticResource PrimaryBrush}"
                                               Margin="0,8,0,0"/>
                                    <TextBlock Text="{Binding Statistics.CronbachAlphaInterpretation}"
                                               HorizontalAlignment="Center"
                                               FontWeight="Medium"
                                               FontSize="12"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <TextBlock Text="Geçme / Kalma Durumu"
                                           Style="{StaticResource SubheadingStyle}"/>
                                <UniformGrid Rows="1" Columns="3" Margin="0,8,0,0">
                                    <StackPanel ToolTip="Geçen öğrenci sayısı, geçme eşiğini aşan öğrencilerin toplamıdır.">
                                        <TextBlock Text="{Binding Statistics.PassedStudentCount, FallbackValue='—'}"
                                                   FontSize="28"
                                                   FontWeight="Bold"
                                                   HorizontalAlignment="Center"
                                                   Foreground="{StaticResource SuccessBrush}"/>
                                        <TextBlock Text="GEÇEN" Style="{StaticResource StatCaptionStyle}"/>
                                    </StackPanel>
                                    <StackPanel ToolTip="Kalan öğrenci sayısı, geçme eşiğinin altında kalan öğrencilerin toplamıdır.">
                                        <TextBlock Text="{Binding Statistics.FailedStudentCount, FallbackValue='—'}"
                                                   FontSize="28"
                                                   FontWeight="Bold"
                                                   HorizontalAlignment="Center"
                                                   Foreground="{StaticResource DangerBrush}"/>
                                        <TextBlock Text="KALAN" Style="{StaticResource StatCaptionStyle}"/>
                                    </StackPanel>
                                    <StackPanel ToolTip="Geçme oranı = geçen öğrenci sayısı / sınava giren öğrenci sayısı x 100.">
                                        <TextBlock HorizontalAlignment="Center"
                                                   FontSize="28"
                                                   FontWeight="Bold"
                                                   Foreground="{StaticResource PrimaryBrush}">
                                            <Run Text="%"/>
                                            <Run Text="{Binding Statistics.PassRate, StringFormat={}{0:N1}, FallbackValue='—'}"/>
                                        </TextBlock>
                                        <TextBlock Text="GEÇME ORANI" Style="{StaticResource StatCaptionStyle}"/>
                                    </StackPanel>
                                </UniformGrid>
                            </StackPanel>
                        </Border>
                        <!-- Madde Analizi alt-bölümü -->
                        <Border BorderBrush="{StaticResource BorderSubtleBrush}"
                                BorderThickness="0,1,0,0"
                                Margin="0,8,0,16"
                                Padding="0,16,0,0">
                            <TextBlock Text="Madde Analizi"
                                       Style="{StaticResource HeadingStyle}"
                                       Margin="0"/>
                        </Border>

                        <Border Style="{StaticResource AlertInfoStyle}" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="Klasik Test Geliştirme — Madde Analizi"
                                           FontWeight="SemiBold"
                                           FontSize="14"
                                           Foreground="{StaticResource PrimaryDarkBrush}"
                                           Margin="0,0,0,8"/>
                                <TextBlock TextWrapping="Wrap"
                                           Foreground="{StaticResource TextPrimaryBrush}"
                                           LineHeight="20">
                                    <Run FontWeight="SemiBold" Text="Güçlük (p):"/><Run Text=" doğru cevaplayan öğrenci sayısının toplam öğrenci sayısına oranıdır. 1'e yaklaştıkça madde kolay, 0'a yaklaştıkça zor."/>
                                    <LineBreak/>
                                    <Run FontWeight="SemiBold" Text="Ayırt edicilik (D):"/><Run Text=" üst %27 başarı grubunun doğru oranından alt %27 grubun oranı çıkarılarak hesaplanır."/>
                                    <LineBreak/>
                                    <Run FontWeight="SemiBold" Text="Madde güvenilirliği:"/><Run Text=" D × √(p·(1−p)) — güçlük ve ayırt ediciliği birlikte değerlendirir."/>
                                    <LineBreak/>
                                    <Run FontWeight="SemiBold" Text="Çeldirici etkinliği:"/><Run Text=" %5 ve üzeri seçilen yanlış şıklar çalışıyor kabul edilir."/>
                                </TextBlock>
                            </StackPanel>
                        </Border>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border Style="{StaticResource CardStyle}" Grid.Column="0" Margin="0,0,4,14">
                                <StackPanel>
                                    <TextBlock Text="Madde Güçlük İndeksleri (p)"
                                               Style="{StaticResource SubheadingStyle}"/>
                                    <lvc:CartesianChart Height="260"
                                                        Series="{Binding DifficultyChartSeries}"
                                                        XAxes="{Binding DifficultyChartXAxes}"
                                                        YAxes="{Binding DifficultyChartYAxes}"/>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource CardStyle}" Grid.Column="1" Margin="4,0,0,14">
                                <StackPanel>
                                    <TextBlock Text="Madde Ayırt Edicilik İndeksleri (D)"
                                               Style="{StaticResource SubheadingStyle}"/>
                                    <lvc:CartesianChart Height="260"
                                                        Series="{Binding DiscriminationChartSeries}"
                                                        XAxes="{Binding DiscriminationChartXAxes}"
                                                        YAxes="{Binding DiscriminationChartYAxes}"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <TextBlock Text="Üst Grup (%27) vs Alt Grup (%27) Doğru Sayıları"
                                           Style="{StaticResource SubheadingStyle}"/>
                                <lvc:CartesianChart Height="280"
                                                    Series="{Binding UpperLowerSeries}"
                                                    XAxes="{Binding UpperLowerXAxes}"
                                                    YAxes="{Binding UpperLowerYAxes}"
                                                    LegendPosition="Top"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <TextBlock Text="Tüm Öğrencilerin Cevap Dağılımı"
                                           Style="{StaticResource SubheadingStyle}"/>
                                <TextBlock Text="Doğru / Yanlış / Boş"
                                           Style="{StaticResource CaptionStyle}"
                                           Margin="0,-8,0,12"/>
                                <lvc:CartesianChart Height="280"
                                                    Series="{Binding AnswerDistributionSeries}"
                                                    XAxes="{Binding AnswerDistributionXAxes}"
                                                    YAxes="{Binding AnswerDistributionYAxes}"
                                                    LegendPosition="Top"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <TextBlock Text="Madde Analizi Listesi"
                                           Style="{StaticResource SubheadingStyle}"/>
                                <DataGrid ItemsSource="{Binding ItemAnalysis}" RowHeight="36">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Soru" Binding="{Binding QuestionNumber}" Width="55"/>
                                        <DataGridTextColumn Header="Doğru Şık" Binding="{Binding CorrectOption}" Width="80"/>
                                        <DataGridTextColumn Header="N" Binding="{Binding TotalStudents}" Width="50"/>
                                        <DataGridTextColumn Header="Doğru" Binding="{Binding CorrectCount}" Width="60"/>
                                        <DataGridTextColumn Header="Yanlış" Binding="{Binding WrongCount}" Width="60"/>
                                        <DataGridTextColumn Header="Boş" Binding="{Binding EmptyCount}" Width="50"/>
                                        <DataGridTextColumn Header="Güçlük (p)" Binding="{Binding DifficultyIndex, StringFormat=N3}" Width="90"/>
                                        <DataGridTextColumn Header="Güçlük Düzeyi" Binding="{Binding DifficultyCategory}" Width="120"/>
                                        <DataGridTextColumn Header="Ayırt Ed. (D)" Binding="{Binding DiscriminationIndex, StringFormat=N3}" Width="100"/>
                                        <DataGridTextColumn Header="Ayırt Ed. Düzeyi" Binding="{Binding DiscriminationCategory}" Width="140"/>
                                        <DataGridTextColumn Header="Madde Güv." Binding="{Binding ItemReliabilityIndex, StringFormat=N3}" Width="100"/>
                                        <DataGridTextColumn Header="Çeldirici Etk." Binding="{Binding DistractorEffectivenessIndex, StringFormat=N2}" Width="110"/>
                                        <DataGridTextColumn Header="Üst (Doğru)" Binding="{Binding UpperGroupCorrect}" Width="90"/>
                                        <DataGridTextColumn Header="Alt (Doğru)" Binding="{Binding LowerGroupCorrect}" Width="90"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ═══ SEKME 8: ÖĞRENCİ SIRALAMASI ═══ -->
            <TabItem Header="Öğrenci Sıralaması">
                <Grid Margin="0,16,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0"
                            Style="{StaticResource CardSubtleStyle}"
                            Margin="0,0,0,12"
                            Padding="14,10">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Sınıf / Bölüm Filtresi"
                                       VerticalAlignment="Center"
                                       FontWeight="SemiBold"/>
                            <ComboBox Width="240"
                                      Margin="14,0,0,0"
                                      ItemsSource="{Binding AvailableClasses}"
                                      SelectedItem="{Binding SelectedClass}"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="1" Style="{StaticResource CardStyle}" Margin="0">
                        <DataGrid ItemsSource="{Binding FilteredStudents}" RowHeight="44">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Sıra" Binding="{Binding ClassRank}" Width="60">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="HorizontalAlignment" Value="Center"/>
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="Öğrenci No" Binding="{Binding StudentNumber}" Width="110"/>
                                <DataGridTextColumn Header="Sınıf / Bölüm" Binding="{Binding ClassName}" Width="160"/>
                                <DataGridTextColumn Header="Ad Soyad" Binding="{Binding FullName}" Width="*"/>
                                <DataGridTextColumn Header="Doğru" Binding="{Binding CorrectAnswers}" Width="70">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="HorizontalAlignment" Value="Center"/>
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="Yanlış" Binding="{Binding WrongAnswers}" Width="70">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="HorizontalAlignment" Value="Center"/>
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="Boş" Binding="{Binding EmptyAnswers}" Width="60">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="HorizontalAlignment" Value="Center"/>
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="Başarı %" Binding="{Binding SuccessRate, StringFormat=N1}" Width="100"/>
                                <DataGridTemplateColumn Header="Zayıf Öğrenim Çıktıları" Width="240">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <ItemsControl ItemsSource="{Binding WeakLearningOutcomes}" VerticalAlignment="Center">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <WrapPanel/>
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Background="#FEF2F2"
                                                                BorderBrush="#FECACA"
                                                                BorderThickness="1"
                                                                CornerRadius="4"
                                                                Padding="8,3"
                                                                Margin="0,2,6,2"
                                                                ToolTip="Bu öğrencinin ilgili öğrenim çıktısındaki başarı oranı %50'nin altında.">
                                                            <TextBlock Text="{Binding}"
                                                                       FontSize="11"
                                                                       FontWeight="Medium"
                                                                       Foreground="#991B1B"
                                                                       TextWrapping="Wrap"/>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                </Grid>
            </TabItem>
        </TabControl>

        <!-- Yükleme overlay -->
        <views:LoadingOverlay Grid.Row="0" Grid.RowSpan="2"
                              Message="Analiz hesaplanıyor..."
                              Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}"/>

        <!-- Hata kartı -->
        <Border Grid.Row="0" Grid.RowSpan="2"
                Style="{StaticResource AlertErrorStyle}"
                MaxWidth="640"
                VerticalAlignment="Center"
                HorizontalAlignment="Center"
                Padding="22,18"
                Visibility="{Binding ErrorMessage, Converter={StaticResource BoolToVisibility}}">
            <StackPanel>
                <TextBlock Text="Analiz Yüklenirken Hata Oluştu"
                           FontSize="15"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource DangerBrush}"
                           Margin="0,0,0,8"/>
                <TextBlock Text="{Binding ErrorMessage}"
                           TextWrapping="Wrap"
                           Foreground="#7F1D1D"
                           FontFamily="Consolas"
                           FontSize="12"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
