<UserControl x:Class="EduAnalytics.UI.Views.ExamAnalysisView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:EduAnalytics.UI.ViewModels"
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
             d:DataContext="{d:DesignInstance Type=vm:ExamAnalysisViewModel}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Başlık + Cevap Girişi butonu -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <StackPanel>
                <TextBlock Text="{Binding Summary.ExamTitle, FallbackValue='Sınav Analizi'}"
                           Style="{StaticResource HeadingStyle}"/>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding Summary.CourseName}"
                               Foreground="{StaticResource TextSecondaryBrush}"/>
                    <TextBlock Text=" · " Foreground="{StaticResource TextSecondaryBrush}"/>
                    <TextBlock Text="{Binding Summary.ExamDate, StringFormat='{}{0:dd.MM.yyyy}'}"
                               Foreground="{StaticResource TextSecondaryBrush}"/>
                </StackPanel>
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                <Button Content="🖨️ Rapor Çıktısı Al (PDF)"
                        Command="{Binding ExportReportCommand}"
                        Background="#F3F4F6"
                        Foreground="{StaticResource TextPrimaryBrush}"
                        Padding="16,10"
                        FontSize="13" FontWeight="SemiBold"
                        BorderThickness="1"
                        BorderBrush="{StaticResource BorderBrush}"
                        Margin="0,0,12,0"
                        Cursor="Hand"/>
                <Button Content="✏ Cevap Girişi"
                        Command="{Binding OpenAnswerEntryCommand}"
                        Background="{StaticResource PrimaryBrush}"
                        Foreground="White"
                        Padding="16,10"
                        FontSize="13" FontWeight="SemiBold"
                        BorderThickness="0"
                        Cursor="Hand"/>
            </StackPanel>
        </Grid>

        <!-- 4 Sekmeli Panel -->
        <TabControl Grid.Row="1" Background="Transparent" BorderThickness="0">

            <!-- ═══ SEKME 1: ÖZET ═══ -->
            <TabItem Header="📊 Özet">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,16,0,0">
                    <StackPanel>
                        <!-- Metrik Kartları -->
                        <UniformGrid Rows="1" Columns="4" Margin="0,0,0,16">
                            <Border Style="{StaticResource CardStyle}" Margin="0,0,8,0">
                                <StackPanel>
                                    <TextBlock Text="{Binding Summary.TotalStudents}"
                                               Style="{StaticResource MetricValueStyle}"/>
                                    <TextBlock Text="ÖĞRENCİ SAYISI"
                                               Style="{StaticResource MetricLabelStyle}"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource CardStyle}" Margin="4,0">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Summary.AverageScore, StringFormat='{}{0:0.00}'}"
                                                   Style="{StaticResource MetricValueStyle}"/>
                                        <TextBlock Text=" / "
                                                   Style="{StaticResource MetricValueStyle}"
                                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                                        <TextBlock Text="{Binding Summary.MaxPossibleScore, StringFormat='{}{0:0.#}'}"
                                                   Style="{StaticResource MetricValueStyle}"
                                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                                    </StackPanel>
                                    <TextBlock Text="ORTALAMA PUAN"
                                               Style="{StaticResource MetricLabelStyle}"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource CardStyle}" Margin="4,0">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource MetricValueStyle}"
                                               Foreground="{StaticResource SuccessBrush}">
                                        <Run Text="%"/>
                                        <Run Text="{Binding Summary.AverageSuccessRate}"/>
                                    </TextBlock>
                                    <TextBlock Text="BAŞARI ORANI"
                                               Style="{StaticResource MetricLabelStyle}"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource CardStyle}" Margin="8,0,0,0">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Summary.HighestScore}"
                                                   Style="{StaticResource MetricValueStyle}"
                                                   Foreground="{StaticResource SuccessBrush}"/>
                                        <TextBlock Text=" / "
                                                   Style="{StaticResource MetricValueStyle}"
                                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                                        <TextBlock Text="{Binding Summary.LowestScore}"
                                                   Style="{StaticResource MetricValueStyle}"
                                                   Foreground="{StaticResource DangerBrush}"/>
                                    </StackPanel>
                                    <TextBlock Text="EN YÜKSEK / EN DÜŞÜK"
                                               Style="{StaticResource MetricLabelStyle}"/>
                                </StackPanel>
                            </Border>
                        </UniformGrid>

                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="1*"/>
                            </Grid.ColumnDefinitions>
                            
                            <!-- Sınıf Puan Dağılımı Histogramı -->
                            <Border Style="{StaticResource CardStyle}" Grid.Column="0" Margin="0,0,8,0">
                                <StackPanel>
                                    <TextBlock Text="Sınıf Puan Dağılımı (Öğrenci Sayısı)"
                                               Style="{StaticResource SubheadingStyle}"/>
                                    <lvc:CartesianChart Height="250"
                                                        Series="{Binding ScoreDistributionSeries}"
                                                        XAxes="{Binding ScoreDistributionXAxes}"/>
                                </StackPanel>
                            </Border>

                            <!-- Genel Başarı Doughnut -->
                            <Border Style="{StaticResource CardStyle}" Grid.Column="1" Margin="8,0,0,0">
                                <StackPanel>
                                    <TextBlock Text="Genel Soruların Doğru Oranı"
                                               Style="{StaticResource SubheadingStyle}"/>
                                    <lvc:PieChart Height="250"
                                                  Series="{Binding SuccessRateDoughnutSeries}"
                                                  LegendPosition="Bottom"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- Soru Başarı Grafiği (Eski grafik kalabilir) -->
                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <TextBlock Text="Soru Bazlı Başarı Oranları"
                                           Style="{StaticResource SubheadingStyle}"/>
                                <lvc:CartesianChart Height="280"
                                                    Series="{Binding QuestionSuccessSeries}"
                                                    XAxes="{Binding QuestionXAxes}"
                                                    YAxes="{Binding QuestionYAxes}"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ═══ SEKME 2: KONU BAZLI ═══ -->
            <TabItem Header="📚 Konu Bazlı">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,16,0,0">
                    <StackPanel>
                        <!-- Grafik Katmanları (Radar ve Bar yanyana) -->
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1*"/>
                                <ColumnDefinition Width="1*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Radar Grafiği -->
                            <Border Style="{StaticResource CardStyle}" Grid.Column="0" Margin="0,0,8,0">
                                <StackPanel>
                                    <TextBlock Text="Konu Başarısı (Kapsam Yüzeyi)"
                                               Style="{StaticResource SubheadingStyle}"/>
                                    <lvc:PolarChart Height="280"
                                                    Series="{Binding RadarSeries}"
                                                    AngleAxes="{Binding RadarAxes}"/>
                                </StackPanel>
                            </Border>

                            <!-- Konu Başarı Çubuk (Eski) -->
                            <Border Style="{StaticResource CardStyle}" Grid.Column="1" Margin="8,0,0,0">
                                <StackPanel>
                                    <TextBlock Text="Konu Başarı Dağılımı (%)"
                                               Style="{StaticResource SubheadingStyle}"/>
                                    <lvc:CartesianChart Height="280"
                                                        Series="{Binding TopicChartSeries}"
                                                        XAxes="{Binding TopicChartXAxes}"
                                                        YAxes="{Binding TopicChartYAxes}"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- Tablo -->
                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <TextBlock Text="Detaylı Konu Performansı"
                                           Style="{StaticResource SubheadingStyle}"/>
                                <DataGrid ItemsSource="{Binding Topics}"
                                          AutoGenerateColumns="False"
                                          IsReadOnly="True"
                                          HeadersVisibility="Column"
                                          GridLinesVisibility="Horizontal"
                                          RowHeight="40"
                                          HorizontalGridLinesBrush="{StaticResource BorderBrush}"
                                          Background="Transparent"
                                          BorderThickness="0">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Hafta" Binding="{Binding WeekNumber}" Width="60"/>
                                        <DataGridTextColumn Header="Konu" Binding="{Binding TopicTitle}" Width="*"/>
                                        <DataGridTextColumn Header="Soru Sayısı" Binding="{Binding RelatedQuestionCount}" Width="100"/>
                                        <DataGridTextColumn Header="Başarı %" Binding="{Binding SuccessRate, StringFormat=N1}" Width="100"/>
                                        <DataGridTemplateColumn Header="Seviye" Width="120">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Border Style="{StaticResource BadgeStyle}"
                                                            Background="{Binding PerformanceLevel, Converter={StaticResource LevelToBrush}}"
                                                            VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding PerformanceLevel}"
                                                                   Foreground="White"
                                                                   FontSize="11" FontWeight="Bold"/>
                                                    </Border>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </StackPanel>
                        </Border>

                        <!-- Öğrenim Çıktısı Tablosu -->
                        <Border Style="{StaticResource CardStyle}" Margin="0,16,0,0">
                            <StackPanel>
                                <TextBlock Text="Detaylı Öğrenim Çıktısı Performansı"
                                           Style="{StaticResource SubheadingStyle}"/>
                                <DataGrid ItemsSource="{Binding LearningOutcomes}"
                                          AutoGenerateColumns="False"
                                          IsReadOnly="True"
                                          HeadersVisibility="Column"
                                          GridLinesVisibility="Horizontal"
                                          RowHeight="40"
                                          HorizontalGridLinesBrush="{StaticResource BorderBrush}"
                                          Background="Transparent"
                                          BorderThickness="0">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Çıktı Adı" Binding="{Binding OutcomeName}" Width="*"/>
                                        <DataGridTextColumn Header="Açıklama" Binding="{Binding Description}" Width="2*"/>
                                        <DataGridTextColumn Header="Soru Sayısı" Binding="{Binding RelatedQuestionCount}" Width="100"/>
                                        <DataGridTextColumn Header="Başarı %" Binding="{Binding SuccessRate, StringFormat=N1}" Width="100"/>
                                        <DataGridTemplateColumn Header="Seviye" Width="120">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Border Style="{StaticResource BadgeStyle}"
                                                            Background="{Binding PerformanceLevel, Converter={StaticResource LevelToBrush}}"
                                                            VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding PerformanceLevel}"
                                                                   Foreground="White"
                                                                   FontSize="11" FontWeight="Bold"/>
                                                    </Border>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ═══ SEKME 3: ÇELDİRİCİ (PROJENİN KALBİ) ═══ -->
            <TabItem Header="🎯 Çeldirici Analizi">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,16,0,0">
                    <StackPanel>
                        <!-- Uyarı Bloğu: Güçlü Çeldiriciler -->
                        <Border Background="#FEF3C7" BorderBrush="{StaticResource WarningBrush}"
                                BorderThickness="2" CornerRadius="8" Padding="16" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="⚠ Güçlü Çeldirici Tespit Edilen Sorular"
                                           FontSize="16" FontWeight="Bold"
                                           Foreground="#92400E" Margin="0,0,0,8"/>
                                <TextBlock Text="Yanlış yapan öğrencilerin %50'sinden fazlasının aynı şıkkı seçtiği sorular:"
                                           Foreground="#78350F" Margin="0,0,0,12"/>
                                <ItemsControl ItemsSource="{Binding StrongDistractors}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="White" CornerRadius="4"
                                                    Padding="12,8" Margin="0,4">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock FontWeight="Bold" Foreground="{StaticResource DangerBrush}">
                                                        <Run Text="Soru "/>
                                                        <Run Text="{Binding QuestionNumber}"/>
                                                    </TextBlock>
                                                    <TextBlock Text=" — "/>
                                                    <TextBlock Text="Doğru: "/>
                                                    <TextBlock Text="{Binding CorrectOption}" FontWeight="Bold"
                                                               Foreground="{StaticResource SuccessBrush}"/>
                                                    <TextBlock Text=" — "/>
                                                    <TextBlock Text="Çeldirici: "/>
                                                    <TextBlock Text="{Binding StrongestDistractorOption}"
                                                               FontWeight="Bold"
                                                               Foreground="{StaticResource DangerBrush}"/>
                                                    <TextBlock Text=" ("/>
                                                    <TextBlock Text="{Binding StrongestDistractorCount}"/>
                                                    <TextBlock Text=" kişi, %"/>
                                                    <TextBlock Text="{Binding StrongestDistractorRate}"/>
                                                    <TextBlock Text=")"/>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <!-- Tüm Sorular Tablosu -->
                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <TextBlock Text="Tüm Soruların Şık Dağılımı"
                                           Style="{StaticResource SubheadingStyle}"/>
                                <DataGrid ItemsSource="{Binding Questions}"
                                          AutoGenerateColumns="False"
                                          IsReadOnly="True"
                                          GridLinesVisibility="Horizontal"
                                          RowHeight="36"
                                          HorizontalGridLinesBrush="{StaticResource BorderBrush}"
                                          Background="Transparent"
                                          BorderThickness="0">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Soru" Binding="{Binding QuestionNumber}" Width="55"/>
                                        <DataGridTextColumn Header="Tür" Binding="{Binding QuestionType}" Width="100"/>
                                        <DataGridTextColumn Header="Puan" Binding="{Binding MaxPoints, StringFormat=N1}" Width="60"/>
                                        <DataGridTextColumn Header="Doğru" Binding="{Binding CorrectOption}" Width="60"/>
                                        <DataGridTextColumn Header="Başarı %" Binding="{Binding SuccessRate, StringFormat=N1}" Width="80"/>
                                        <DataGridTextColumn Header="A" Binding="{Binding OptionACount}" Width="45"/>
                                        <DataGridTextColumn Header="B" Binding="{Binding OptionBCount}" Width="45"/>
                                        <DataGridTextColumn Header="C" Binding="{Binding OptionCCount}" Width="45"/>
                                        <DataGridTextColumn Header="D" Binding="{Binding OptionDCount}" Width="45"/>
                                        <DataGridTextColumn Header="E" Binding="{Binding OptionECount}" Width="45"/>
                                        <DataGridTextColumn Header="Çeldirici" Binding="{Binding StrongestDistractorOption}" Width="80"/>
                                        <DataGridTextColumn Header="Çeld. %" Binding="{Binding StrongestDistractorRate, StringFormat=N1}" Width="70"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ═══ SEKME 4: Sınav Soruları ═══ -->
            <TabItem Header="📝 Sınav Soruları">
                <Grid Margin="0,16,0,0">
                    <Border Style="{StaticResource CardStyle}" Margin="0">
                        <DataGrid ItemsSource="{Binding Questions}"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  GridLinesVisibility="Horizontal"
                                  HeadersVisibility="Column"
                                  RowHeight="56"
                                  ColumnHeaderHeight="40"
                                  HorizontalGridLinesBrush="{StaticResource BorderBrush}"
                                  Background="Transparent"
                                  BorderThickness="0">
                            <DataGrid.Resources>
                                <Style TargetType="DataGridCell">
                                    <Setter Property="Padding" Value="10,8"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                </Style>
                                <Style TargetType="DataGridColumnHeader">
                                    <Setter Property="Padding" Value="10,6"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Setter Property="HorizontalContentAlignment" Value="Left"/>
                                </Style>
                            </DataGrid.Resources>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Soru No" Binding="{Binding QuestionNumber}" Width="80">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="HorizontalAlignment" Value="Center"/>
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTemplateColumn Header="Soru Metni" Width="*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding QuestionText}"
                                                       TextWrapping="Wrap"
                                                       VerticalAlignment="Center"
                                                       Padding="0,4"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Türü" Binding="{Binding QuestionType}" Width="120"/>
                                <DataGridTextColumn Header="Puanı" Binding="{Binding MaxPoints, StringFormat=N1}" Width="80">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="HorizontalAlignment" Value="Center"/>
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="Cevabı" Binding="{Binding CorrectOption}" Width="80">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="HorizontalAlignment" Value="Center"/>
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                            <Setter Property="FontWeight" Value="Bold"/>
                                            <Setter Property="Foreground" Value="{StaticResource SuccessBrush}"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                </Grid>
            </TabItem>

            <!-- ═══ SEKME: SINAV DENGESİ (FAZ 4) ═══ -->
            <TabItem Header="⚖ Sınav Dengesi">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,16,0,0">
                    <StackPanel>
                        <Border Style="{StaticResource CardStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,32,0">
                                    <TextBlock Text="DENGE SKORU" Style="{StaticResource MetricLabelStyle}"/>
                                    <TextBlock Style="{StaticResource MetricValueStyle}"
                                               Foreground="{StaticResource SuccessBrush}">
                                        <Run Text="{Binding BalanceReport.BalanceScore, FallbackValue='—'}"/>
                                        <Run Text="/100"/>
                                    </TextBlock>
                                </StackPanel>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="Soruların konu/ÖÇ dağılımının ne kadar dengeli olduğunu gösterir."
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               TextWrapping="Wrap"/>
                                    <TextBlock Margin="0,4,0,0" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}">
                                        <Run Text="• 80-100: Mükemmel  • 60-80: İyi  • 40-60: Orta  • 0-40: Dengesiz"/>
                                    </TextBlock>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource CardStyle}"
                                Visibility="{Binding BalanceReport.Warnings.Count, Converter={StaticResource BoolToVisibility}}">
                            <StackPanel>
                                <TextBlock Text="⚠ Uyarılar" Style="{StaticResource SubheadingStyle}"
                                           Foreground="{StaticResource WarningBrush}"/>
                                <ItemsControl ItemsSource="{Binding BalanceReport.Warnings}" Margin="0,8,0,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border CornerRadius="4" Padding="12,8" Margin="0,0,0,6">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="#FEF3C7"/>
                                                        <Setter Property="BorderBrush" Value="{StaticResource WarningBrush}"/>
                                                        <Setter Property="BorderThickness" Value="1"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Severity}" Value="Critical">
                                                                <Setter Property="Background" Value="#FEE2E2"/>
                                                                <Setter Property="BorderBrush" Value="{StaticResource DangerBrush}"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Severity}" Value="Info">
                                                                <Setter Property="Background" Value="#DBEAFE"/>
                                                                <Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Severity}" FontWeight="Bold" FontSize="11"/>
                                                    <TextBlock Text="{Binding Message}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardStyle}" Background="#D1FAE5"
                                Visibility="{Binding BalanceReport.Warnings.Count, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}">
                            <StackPanel>
                                <TextBlock Text="✓ Sınav dengeli görünüyor"
                                           FontSize="16" FontWeight="SemiBold"
                                           Foreground="#064E3B"/>
                                <TextBlock Text="Soru dağılımı konular ve ÖÇ'ler arasında makul biçimde yayılmış."
                                           Foreground="#064E3B" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <TextBlock Text="Konu Kapsamı" Style="{StaticResource SubheadingStyle}"/>
                                <DataGrid ItemsSource="{Binding BalanceReport.TopicCoverage}"
                                          AutoGenerateColumns="False" IsReadOnly="True"
                                          GridLinesVisibility="Horizontal"
                                          HorizontalGridLinesBrush="{StaticResource BorderBrush}"
                                          Background="Transparent" BorderThickness="0">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Hafta" Binding="{Binding WeekNumber}" Width="60"/>
                                        <DataGridTextColumn Header="Konu" Binding="{Binding TopicTitle}" Width="*"/>
                                        <DataGridTextColumn Header="Soru" Binding="{Binding QuestionCount}" Width="60"/>
                                        <DataGridTextColumn Header="Yüzde" Binding="{Binding Percentage, StringFormat={}{0:N1}%}" Width="80"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <TextBlock Text="ÖÇ Kapsamı" Style="{StaticResource SubheadingStyle}"/>
                                <DataGrid ItemsSource="{Binding BalanceReport.LearningOutcomeCoverage}"
                                          AutoGenerateColumns="False" IsReadOnly="True"
                                          GridLinesVisibility="Horizontal"
                                          HorizontalGridLinesBrush="{StaticResource BorderBrush}"
                                          Background="Transparent" BorderThickness="0">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Kod" Binding="{Binding Code}" Width="80"/>
                                        <DataGridTextColumn Header="ÖÇ" Binding="{Binding Name}" Width="*"/>
                                        <DataGridTextColumn Header="Soru" Binding="{Binding QuestionCount}" Width="60"/>
                                        <DataGridTextColumn Header="Yüzde" Binding="{Binding Percentage, StringFormat={}{0:N1}%}" Width="80"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ═══ SEKME 5: ÖĞRENCİ SIRALAMASI ═══ -->
            <TabItem Header="👥 Öğrenci Sıralaması">
                <Grid Margin="0,16,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- FİLTRELEME ALANI -->
                    <StackPanel Grid.Row="0" Margin="0,0,0,10" Orientation="Horizontal">
                        <TextBlock Text="Sınıf / Bölüm Filtresi: " VerticalAlignment="Center" FontWeight="SemiBold"/>
                        <ComboBox Width="200" ItemsSource="{Binding AvailableClasses}" SelectedItem="{Binding SelectedClass}" Margin="10,0,0,0"/>
                    </StackPanel>

                    <Border Grid.Row="1" Style="{StaticResource CardStyle}" Margin="0">
                        <DataGrid ItemsSource="{Binding FilteredStudents}" AutoGenerateColumns="False"
                                  IsReadOnly="True" GridLinesVisibility="Horizontal" HeadersVisibility="Column"
                                  BorderThickness="1" BorderBrush="{DynamicResource BorderMuted}" Background="White"
                                  RowHeight="48" ColumnHeaderHeight="42">
                            <DataGrid.Resources>
                                <Style TargetType="DataGridCell">
                                    <Setter Property="Padding" Value="8,6"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                </Style>
                                <Style TargetType="DataGridColumnHeader">
                                    <Setter Property="Padding" Value="10,8"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Setter Property="HorizontalContentAlignment" Value="Left"/>
                                </Style>
                            </DataGrid.Resources>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Sıra" Binding="{Binding ClassRank}" Width="60">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="HorizontalAlignment" Value="Center"/>
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="Öğrenci No" Binding="{Binding StudentNumber}" Width="110"/>
                                <DataGridTextColumn Header="Sınıf / Bölüm" Binding="{Binding ClassName}" Width="180"/>
                                <DataGridTextColumn Header="Ad Soyad" Binding="{Binding FullName}" Width="*" MinWidth="200"/>
                                <DataGridTextColumn Header="Doğru" Binding="{Binding CorrectAnswers}" Width="70">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="HorizontalAlignment" Value="Center"/>
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                            <Setter Property="Foreground" Value="{StaticResource SuccessBrush}"/>
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="Yanlış" Binding="{Binding WrongAnswers}" Width="70">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="HorizontalAlignment" Value="Center"/>
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                            <Setter Property="Foreground" Value="{StaticResource DangerBrush}"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="Boş" Binding="{Binding EmptyAnswers}" Width="60">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="HorizontalAlignment" Value="Center"/>
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="Başarı %" Binding="{Binding SuccessRate, StringFormat=N1}" Width="110">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="HorizontalAlignment" Value="Center"/>
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTemplateColumn Header="Zayıf Konular" Width="2*" MinWidth="200">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <ItemsControl ItemsSource="{Binding WeakTopics}" VerticalAlignment="Center">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <WrapPanel/>
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Background="#FEE2E2" CornerRadius="4"
                                                                Padding="6,2" Margin="0,2,4,2">
                                                            <TextBlock Text="{Binding}" FontSize="11"
                                                                       Foreground="#991B1B"/>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                </Grid>
            </TabItem>
        </TabControl>

        <!-- Yükleme -->
        <Border Grid.Row="0" Grid.RowSpan="2"
                Background="#80FFFFFF"
                Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}">
            <TextBlock Text="Analiz hesaplanıyor..." HorizontalAlignment="Center" VerticalAlignment="Center"
                       FontSize="18" Foreground="{StaticResource PrimaryBrush}"/>
        </Border>

        <!-- Hata Mesajı -->
        <Border Grid.Row="0" Grid.RowSpan="2"
                Background="#FEE2E2" BorderBrush="{StaticResource DangerBrush}" BorderThickness="2"
                CornerRadius="8" Padding="24" Margin="40"
                VerticalAlignment="Center" HorizontalAlignment="Center"
                MaxWidth="600"
                Visibility="{Binding ErrorMessage, Converter={StaticResource BoolToVisibility}}">
            <StackPanel>
                <TextBlock Text="⚠ Analiz Yüklenirken Hata Oluştu"
                           FontSize="18" FontWeight="Bold"
                           Foreground="{StaticResource DangerBrush}"
                           Margin="0,0,0,12"/>
                <TextBlock Text="{Binding ErrorMessage}"
                           TextWrapping="Wrap"
                           Foreground="#7F1D1D"
                           FontFamily="Consolas" FontSize="13"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
