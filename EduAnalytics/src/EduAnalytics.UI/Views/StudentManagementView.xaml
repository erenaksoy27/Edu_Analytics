<UserControl x:Class="EduAnalytics.UI.Views.StudentManagementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:EduAnalytics.UI.ViewModels"
             d:DataContext="{d:DesignInstance Type=vm:StudentManagementViewModel}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Başlık + Excel butonları -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <StackPanel>
                <TextBlock Text="👥 Öğrenci Yönetimi" Style="{StaticResource HeadingStyle}"/>
                <TextBlock TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}">
                    Sistemde kayıtlı öğrencileri görüntüleyin, ekleyin, güncelleyin veya silin.
                    Toplu yükleme için şablonu indirin, doldurun ve sisteme yükleyin.
                </TextBlock>
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                <Button Content="📥 Şablon İndir"
                        Command="{Binding DownloadTemplateCommand}"
                        Background="#F3F4F6"
                        Foreground="{StaticResource TextPrimaryBrush}"
                        Padding="14,8"
                        FontSize="13" FontWeight="SemiBold"
                        BorderThickness="1" BorderBrush="{StaticResource BorderBrush}"
                        Margin="0,0,8,0" Cursor="Hand"
                        ToolTip="Boş Excel şablonunu indir"/>
                <Button Content="📤 Excel'den Yükle"
                        Command="{Binding ImportExcelCommand}"
                        Background="{StaticResource PrimaryBrush}"
                        Foreground="White"
                        Padding="14,8"
                        FontSize="13" FontWeight="SemiBold"
                        BorderThickness="0" Cursor="Hand"
                        ToolTip="Doldurulmuş Excel'i sisteme yükle"/>
            </StackPanel>
        </Grid>

        <!-- Mesajlar -->
        <StackPanel Grid.Row="1" Margin="0,0,0,12">
            <Border Background="#FEE2E2" BorderBrush="{StaticResource DangerBrush}" BorderThickness="1"
                    CornerRadius="4" Padding="12,8" Margin="0,0,0,4"
                    Visibility="{Binding ErrorMessage, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="{Binding ErrorMessage}" Foreground="#991B1B" TextWrapping="Wrap"/>
            </Border>
            <Border Background="#D1FAE5" BorderBrush="{StaticResource SuccessBrush}" BorderThickness="1"
                    CornerRadius="4" Padding="12,8"
                    Visibility="{Binding SuccessMessage, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="{Binding SuccessMessage}" Foreground="#064E3B" TextWrapping="Wrap"/>
            </Border>
        </StackPanel>

        <!-- Form: Yeni öğrenci / düzenle -->
        <Border Grid.Row="2" Style="{StaticResource CardStyle}" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Style="{StaticResource SubheadingStyle}">
                    <Run Text="✏ "/>
                    <Run Text="{Binding EditingStudent.StudentNumber, FallbackValue='Yeni Öğrenci'}"/>
                </TextBlock>

                <Grid Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Öğrenci No" FontWeight="SemiBold" Margin="0,0,0,4"/>
                    <TextBlock Grid.Row="0" Grid.Column="2" Text="Ad Soyad" FontWeight="SemiBold" Margin="0,0,0,4"/>
                    <TextBlock Grid.Row="0" Grid.Column="4" Text="Sınıf / Bölüm" FontWeight="SemiBold" Margin="0,0,0,4"/>

                    <TextBox Grid.Row="1" Grid.Column="0"
                             Text="{Binding FormStudentNumber, UpdateSourceTrigger=PropertyChanged}"
                             Padding="8,6"/>
                    <TextBox Grid.Row="1" Grid.Column="2"
                             Text="{Binding FormFullName, UpdateSourceTrigger=PropertyChanged}"
                             Padding="8,6"/>
                    <TextBox Grid.Row="1" Grid.Column="4"
                             Text="{Binding FormClassName, UpdateSourceTrigger=PropertyChanged}"
                             Padding="8,6"/>

                    <StackPanel Grid.Row="1" Grid.Column="6" Orientation="Horizontal">
                        <Button Content="💾 Kaydet"
                                Command="{Binding SaveCommand}"
                                Background="{StaticResource PrimaryBrush}"
                                Foreground="White"
                                Padding="16,6"
                                BorderThickness="0"
                                Cursor="Hand" FontWeight="SemiBold"
                                Margin="0,0,6,0"/>
                        <Button Content="✕ Temizle"
                                Command="{Binding StartNewCommand}"
                                Background="#F3F4F6"
                                Foreground="{StaticResource TextSecondaryBrush}"
                                Padding="14,6"
                                BorderThickness="1" BorderBrush="{StaticResource BorderBrush}"
                                Cursor="Hand"/>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>

        <!-- Liste + arama -->
        <Border Grid.Row="3" Style="{StaticResource CardStyle}" Margin="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="🔍" FontSize="16" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBox Grid.Column="1"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             Padding="8,6"
                             ToolTip="Numara, ad-soyad veya sınıf adında ara"/>
                    <TextBlock Grid.Column="2" VerticalAlignment="Center" Margin="12,0,0,0"
                               Foreground="{StaticResource TextSecondaryBrush}">
                        <Run Text="Toplam:"/>
                        <Run Text="{Binding FilteredStudents.Count, Mode=OneWay}" FontWeight="Bold"/>
                    </TextBlock>
                </Grid>

                <DataGrid Grid.Row="1"
                          ItemsSource="{Binding FilteredStudents}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          GridLinesVisibility="Horizontal"
                          HeadersVisibility="Column"
                          Background="Transparent"
                          BorderBrush="{StaticResource BorderBrush}"
                          BorderThickness="1"
                          RowHeight="44"
                          ColumnHeaderHeight="40"
                          CanUserAddRows="False" CanUserDeleteRows="False">
                    <DataGrid.Resources>
                        <Style TargetType="DataGridCell">
                            <Setter Property="Padding" Value="10,6"/>
                            <Setter Property="VerticalAlignment" Value="Center"/>
                        </Style>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Padding" Value="10,8"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                        </Style>
                    </DataGrid.Resources>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Numara" Binding="{Binding StudentNumber}" Width="120"/>
                        <DataGridTextColumn Header="Ad Soyad" Binding="{Binding FullName}" Width="*" MinWidth="200"/>
                        <DataGridTextColumn Header="Sınıf / Bölüm" Binding="{Binding ClassName}" Width="220"/>
                        <DataGridTextColumn Header="Kayıtlı Ders" Binding="{Binding EnrolledCourseCount}" Width="120">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTemplateColumn Header="İşlem" Width="160">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Content="✏ Düzenle"
                                                Command="{Binding DataContext.StartEditCommand,
                                                          RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                Background="#E0E7FF"
                                                Foreground="#3730A3"
                                                BorderThickness="0"
                                                Padding="8,4" Margin="0,0,4,0"
                                                Cursor="Hand" FontSize="11"/>
                                        <Button Content="🗑 Sil"
                                                Command="{Binding DataContext.DeleteCommand,
                                                          RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                Background="Transparent"
                                                Foreground="{StaticResource DangerBrush}"
                                                BorderBrush="{StaticResource DangerBrush}"
                                                BorderThickness="1"
                                                Padding="8,4"
                                                Cursor="Hand" FontSize="11"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

        <!-- Loading overlay -->
        <Border Grid.Row="0" Grid.RowSpan="4" Background="#80FFFFFF"
                Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}">
            <TextBlock Text="Yükleniyor..." HorizontalAlignment="Center" VerticalAlignment="Center"
                       FontSize="18" Foreground="{StaticResource PrimaryBrush}"/>
        </Border>
    </Grid>
</UserControl>
