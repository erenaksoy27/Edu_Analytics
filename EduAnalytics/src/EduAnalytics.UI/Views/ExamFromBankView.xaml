<UserControl x:Class="EduAnalytics.UI.Views.ExamFromBankView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:EduAnalytics.UI.ViewModels"
             xmlns:enums="clr-namespace:EduAnalytics.Core.Enums;assembly=EduAnalytics.Core"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             d:DataContext="{d:DesignInstance Type=vm:ExamFromBankViewModel}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006">

    <UserControl.Resources>
        <Style x:Key="ChipStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="6,2"/>
            <Setter Property="Margin" Value="0,0,4,0"/>
            <Setter Property="Background" Value="{StaticResource PageBgBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderSubtleBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style x:Key="ChipTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
        </Style>

        <Style x:Key="MiniButtonStyle" TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Başlık -->
            <StackPanel Grid.Row="0" Margin="0,0,0,16">
                <TextBlock Text="Soru Bankasından Sınav Oluştur" Style="{StaticResource HeadingStyle}"/>
                <TextBlock TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}">
                    Yeni soru üretmek yerine soru bankasındaki aktif soruları seçerek hızlıca sınav kurun. Vize tipinde sadece tarihe kadar olan ÖÇ'ler kullanılabilir.
                </TextBlock>
            </StackPanel>

            <!-- Sınav bilgi paneli -->
            <Border Grid.Row="1" Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock Text="Sınav Bilgileri" Style="{StaticResource SubheadingStyle}"/>

                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="14"/>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="14"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="14"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="14"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Ders" Style="{StaticResource LabelStyle}"/>
                        <TextBlock Grid.Row="0" Grid.Column="2" Text="Sınav Başlığı" Style="{StaticResource LabelStyle}"/>
                        <TextBlock Grid.Row="0" Grid.Column="4" Text="Tarih" Style="{StaticResource LabelStyle}"/>
                        <TextBlock Grid.Row="0" Grid.Column="6" Text="Süre (dk)" Style="{StaticResource LabelStyle}"/>
                        <TextBlock Grid.Row="0" Grid.Column="8" Text="Tip" Style="{StaticResource LabelStyle}"/>

                        <ComboBox Grid.Row="1" Grid.Column="0"
                                  ItemsSource="{Binding Courses}"
                                  SelectedItem="{Binding SelectedCourse}"
                                  DisplayMemberPath="Name"/>
                        <TextBox Grid.Row="1" Grid.Column="2"
                                 Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}"/>
                        <DatePicker Grid.Row="1" Grid.Column="4"
                                    SelectedDate="{Binding ExamDate}"/>
                        <TextBox Grid.Row="1" Grid.Column="6"
                                 Text="{Binding DurationMinutes, UpdateSourceTrigger=PropertyChanged}"
                                 Width="80"/>
                        <ComboBox Grid.Row="1" Grid.Column="8"
                                  SelectedItem="{Binding ExamType}" Width="120">
                            <ComboBox.Items>
                                <x:Static Member="enums:ExamType.Quiz"/>
                                <x:Static Member="enums:ExamType.Midterm"/>
                                <x:Static Member="enums:ExamType.Final"/>
                                <x:Static Member="enums:ExamType.MakeUp"/>
                            </ComboBox.Items>
                        </ComboBox>
                    </Grid>

                    <!-- Kitapçık ayarları -->
                    <Grid Margin="0,16,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="14"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="28"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Text="Kitapçık Sayısı"
                                   VerticalAlignment="Center" FontWeight="SemiBold"/>
                        <ComboBox Grid.Column="2"
                                  SelectedItem="{Binding BookletCount}"
                                  Width="80" VerticalAlignment="Center">
                            <ComboBox.Items>
                                <sys:Int32>1</sys:Int32>
                                <sys:Int32>2</sys:Int32>
                                <sys:Int32>3</sys:Int32>
                                <sys:Int32>4</sys:Int32>
                            </ComboBox.Items>
                        </ComboBox>

                        <CheckBox Grid.Column="4"
                                  IsChecked="{Binding ShuffleOptions}"
                                  Content="Şıkları karıştır"
                                  VerticalAlignment="Center"/>

                        <TextBlock Grid.Column="5" VerticalAlignment="Center" Margin="20,0,0,0"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   FontSize="11"
                                   TextWrapping="Wrap"
                                   Text="Birden fazla kitapçıkta sorular farklı sırayla çıkar. 'Şıkları karıştır' seçilirse B/C/D kitapçıklarında şıklar da permüte edilir."/>
                    </Grid>

                    <!-- Öğrenci seçimi -->
                    <Border BorderBrush="{StaticResource BorderSubtleBrush}"
                            BorderThickness="0,1,0,0"
                            Margin="0,18,0,0"
                            Padding="0,18,0,0">
                        <StackPanel>
                            <TextBlock Text="Sınava Girecek Öğrenciler" Style="{StaticResource SubheadingStyle}"/>
                            <TextBlock Text="Birden fazla bölüm/sınıf seçebilirsiniz (alttan alan, yükseltme veya ortak ders öğrencileri)."
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       FontSize="12" Margin="0,-8,0,12"/>

                            <TextBlock Text="Sınıf / Bölüm Filtresi" Style="{StaticResource LabelStyle}"/>
                            <Border BorderBrush="{StaticResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    MaxHeight="100"
                                    Background="{StaticResource PageBgBrush}"
                                    Margin="0,0,0,10">
                                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="8">
                                    <ItemsControl ItemsSource="{Binding ClassFilters}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <CheckBox Content="{Binding ClassName}"
                                                          IsChecked="{Binding IsSelected}"
                                                          Margin="6,4"/>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Border>

                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <Button Content="Tüm Sınıfları Seç"
                                        Command="{Binding SelectAllClassesCommand}"
                                        Style="{StaticResource MiniButtonStyle}"/>
                                <Button Content="Sınıf Filtresini Temizle"
                                        Command="{Binding ClearClassFilterCommand}"
                                        Style="{StaticResource MiniButtonStyle}"/>
                                <Border Width="1" Background="{StaticResource BorderBrush}" Margin="6,2,12,2"/>
                                <Button Content="Filtredeki Tüm Öğrencileri Seç"
                                        Command="{Binding SelectAllFilteredCommand}"
                                        Style="{StaticResource MiniButtonStyle}"/>
                                <Button Content="Öğrenci Seçimini Temizle"
                                        Command="{Binding DeselectAllFilteredCommand}"
                                        Style="{StaticResource MiniButtonStyle}"/>
                            </StackPanel>

                            <Border BorderBrush="{StaticResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Height="220"
                                    Background="{StaticResource CardBgBrush}">
                                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="6">
                                    <ItemsControl ItemsSource="{Binding FilteredStudents}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <CheckBox IsChecked="{Binding IsSelected}" Margin="8,5">
                                                    <TextBlock FontSize="13">
                                                        <Run Text="{Binding StudentNumber}" FontWeight="SemiBold" Foreground="{StaticResource PrimaryBrush}"/>
                                                        <Run Text="  ·  "/>
                                                        <Run Text="{Binding FullName}"/>
                                                        <Run Text="  ("/><Run Text="{Binding ClassName}" Foreground="{StaticResource TextSecondaryBrush}"/><Run Text=")"/>
                                                    </TextBlock>
                                                </CheckBox>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Border>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <!-- İki kolonlu havuz vs. seçili sorular -->
            <Grid Grid.Row="2" Margin="0,0,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Sol: havuz -->
                <Border Grid.Column="0" Style="{StaticResource CardStyle}" Margin="0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="Soru Havuzu" Style="{StaticResource SubheadingStyle}"/>

                        <Grid Grid.Row="1" Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Text="{Binding BankSearchText, UpdateSourceTrigger=PropertyChanged}"/>
                            <Button Grid.Column="1"
                                    Content="Ara"
                                    Command="{Binding SearchPoolCommand}"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    Margin="8,0,0,0"/>
                        </Grid>

                        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <ItemsControl ItemsSource="{Binding BankPool}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="{StaticResource BorderBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="6"
                                                    Padding="12"
                                                    Margin="0,0,0,8"
                                                    Background="{StaticResource CardBgBrush}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0">
                                                        <TextBlock Text="{Binding QuestionText}"
                                                                   TextWrapping="Wrap"
                                                                   FontSize="13"
                                                                   Foreground="{StaticResource TextPrimaryBrush}"/>
                                                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                                            <Border Style="{StaticResource ChipStyle}">
                                                                <TextBlock Text="{Binding Type}" Style="{StaticResource ChipTextStyle}"/>
                                                            </Border>
                                                            <Border Style="{StaticResource ChipStyle}">
                                                                <TextBlock Style="{StaticResource ChipTextStyle}">
                                                                    <Run Text="{Binding MaxPoints}"/>
                                                                    <Run Text=" puan"/>
                                                                </TextBlock>
                                                            </Border>
                                                        </StackPanel>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                        <Button Content="Detay"
                                                                Command="{Binding DataContext.ShowQuestionDetailCommand,
                                                                          RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                CommandParameter="{Binding}"
                                                                Style="{StaticResource SecondaryButtonStyle}"
                                                                Padding="10,5"
                                                                FontSize="11"
                                                                Margin="6,0,0,0"/>
                                                        <Button Content="Ekle"
                                                                Command="{Binding DataContext.AddToExamCommand,
                                                                          RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                CommandParameter="{Binding}"
                                                                Style="{StaticResource PrimaryButtonStyle}"
                                                                Padding="14,5"
                                                                FontSize="11"
                                                                Margin="6,0,0,0"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <!-- Soru Detay Paneli -->
                                <Border BorderBrush="{StaticResource PrimaryBrush}"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Padding="14"
                                        Margin="0,4,0,0"
                                        Background="{StaticResource PrimaryLightBrush}"
                                        Visibility="{Binding DetailQuestionModel, Converter={StaticResource BoolToVisibility}}">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Soru Detayı"
                                                       FontWeight="SemiBold"
                                                       FontSize="14"
                                                       Foreground="{StaticResource PrimaryDarkBrush}"
                                                       VerticalAlignment="Center"/>
                                            <Button Grid.Column="1"
                                                    Content="Kapat"
                                                    Command="{Binding CloseQuestionDetailCommand}"
                                                    Style="{StaticResource GhostButtonStyle}"
                                                    Padding="8,4"
                                                    FontSize="11"/>
                                        </Grid>

                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                            <Border Style="{StaticResource ChipStyle}" Background="{StaticResource CardBgBrush}">
                                                <TextBlock Text="{Binding DetailQuestionModel.Type}" Style="{StaticResource ChipTextStyle}"/>
                                            </Border>
                                            <Border Style="{StaticResource ChipStyle}" Background="{StaticResource CardBgBrush}">
                                                <TextBlock Style="{StaticResource ChipTextStyle}">
                                                    <Run Text="{Binding DetailQuestionModel.MaxPoints}"/>
                                                    <Run Text=" puan"/>
                                                </TextBlock>
                                            </Border>
                                            <Border Style="{StaticResource ChipStyle}"
                                                    Background="#ECFDF5"
                                                    BorderBrush="{StaticResource SuccessBrush}">
                                                <TextBlock Style="{StaticResource ChipTextStyle}" Foreground="#065F46">
                                                    <Run Text="Doğru: "/>
                                                    <Run Text="{Binding DetailQuestionModel.CorrectOption}"/>
                                                </TextBlock>
                                            </Border>
                                        </StackPanel>

                                        <TextBlock Text="{Binding DetailQuestionModel.QuestionText}"
                                                   TextWrapping="Wrap"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextPrimaryBrush}"
                                                   Margin="0,0,0,10"/>

                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="22"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <TextBlock Grid.Row="0" Grid.Column="0" Text="A" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}"/>
                                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding DetailQuestionModel.OptionA}" TextWrapping="Wrap" Margin="0,0,0,3"/>
                                            <TextBlock Grid.Row="1" Grid.Column="0" Text="B" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}"/>
                                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding DetailQuestionModel.OptionB}" TextWrapping="Wrap" Margin="0,0,0,3"/>
                                            <TextBlock Grid.Row="2" Grid.Column="0" Text="C" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}"/>
                                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding DetailQuestionModel.OptionC}" TextWrapping="Wrap" Margin="0,0,0,3"/>
                                            <TextBlock Grid.Row="3" Grid.Column="0" Text="D" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}"/>
                                            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding DetailQuestionModel.OptionD}" TextWrapping="Wrap" Margin="0,0,0,3"/>
                                            <TextBlock Grid.Row="4" Grid.Column="0" Text="E" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}"/>
                                            <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding DetailQuestionModel.OptionE}" TextWrapping="Wrap"/>
                                        </Grid>

                                        <ItemsControl ItemsSource="{Binding DetailQuestion.LearningOutcomeCodes}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="{StaticResource CardBgBrush}"
                                                            BorderBrush="{StaticResource PrimaryBrush}"
                                                            BorderThickness="1"
                                                            CornerRadius="4"
                                                            Padding="6,2"
                                                            Margin="0,0,4,4">
                                                        <TextBlock Text="{Binding}"
                                                                   Foreground="{StaticResource PrimaryDarkBrush}"
                                                                   FontSize="10"
                                                                   FontWeight="SemiBold"/>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Border>

                <!-- Sağ: seçili sorular -->
                <Border Grid.Column="2" Style="{StaticResource CardStyle}" Margin="0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Style="{StaticResource SubheadingStyle}" Margin="0">
                                <Run Text="Seçilen Sorular ("/>
                                <Run Text="{Binding SelectedQuestions.Count, Mode=OneWay}"/>
                                <Run Text=")"/>
                            </TextBlock>

                            <Button Grid.Column="1"
                                    Content="100 Puana Eşitle"
                                    Command="{Binding DistributePointsTo100Command}"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Padding="10,5"
                                    FontSize="11"
                                    ToolTip="Toplam puanı 100 olacak şekilde tüm seçili sorulara eşit dağıtır."/>
                        </Grid>

                        <Border Grid.Row="1"
                                Style="{StaticResource AlertInfoStyle}"
                                Margin="0,0,0,10"
                                Visibility="{Binding BalancePreview, Converter={StaticResource BoolToVisibility}}">
                            <StackPanel>
                                <TextBlock Foreground="{StaticResource PrimaryDarkBrush}" FontSize="12">
                                    <Run Text="Denge Skoru: "/>
                                    <Run Text="{Binding BalancePreview.BalanceScore, FallbackValue='—'}" FontWeight="Bold"/>
                                    <Run Text=" / 100"/>
                                </TextBlock>
                                <TextBlock FontSize="11"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           Visibility="{Binding BalancePreview.Warnings.Count, Converter={StaticResource BoolToVisibility}}">
                                    <Run Text="{Binding BalancePreview.Warnings.Count}"/>
                                    <Run Text=" uyarı var — Sınav Dengesi sekmesinden inceleyin."/>
                                </TextBlock>
                            </StackPanel>
                        </Border>

                        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding SelectedQuestions}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="{StaticResource PrimaryBrush}"
                                                BorderThickness="1"
                                                CornerRadius="6"
                                                Padding="12"
                                                Margin="0,0,0,8"
                                                Background="{StaticResource PrimaryLightBrush}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0">
                                                    <TextBlock Text="{Binding QuestionText}"
                                                               TextWrapping="Wrap"
                                                               FontSize="13"
                                                               Foreground="{StaticResource TextPrimaryBrush}"/>
                                                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                                        <Border Style="{StaticResource ChipStyle}" Background="{StaticResource CardBgBrush}">
                                                            <TextBlock Text="{Binding Type}" Style="{StaticResource ChipTextStyle}"/>
                                                        </Border>
                                                        <Border Style="{StaticResource ChipStyle}" Background="{StaticResource CardBgBrush}">
                                                            <TextBlock Style="{StaticResource ChipTextStyle}">
                                                                <Run Text="{Binding MaxPoints}"/>
                                                                <Run Text=" puan"/>
                                                            </TextBlock>
                                                        </Border>
                                                    </StackPanel>
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Button Content="↑"
                                                            Command="{Binding DataContext.MoveUpCommand,
                                                                      RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}"
                                                            Style="{StaticResource SecondaryButtonStyle}"
                                                            Padding="8,4"
                                                            FontSize="12"
                                                            Margin="0,0,4,0"/>
                                                    <Button Content="↓"
                                                            Command="{Binding DataContext.MoveDownCommand,
                                                                      RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}"
                                                            Style="{StaticResource SecondaryButtonStyle}"
                                                            Padding="8,4"
                                                            FontSize="12"
                                                            Margin="0,0,4,0"/>
                                                    <Button Content="Çıkar"
                                                            Command="{Binding DataContext.RemoveFromExamCommand,
                                                                      RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}"
                                                            Style="{StaticResource DangerButtonStyle}"
                                                            Padding="10,4"
                                                            FontSize="11"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>

            <!-- Alt bar -->
            <Border Grid.Row="3"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0,1,0,0"
                    Padding="0,14,0,0"
                    Margin="0,14,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <Border Style="{StaticResource AlertErrorStyle}"
                                Visibility="{Binding ErrorMessage, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="{Binding ErrorMessage}"
                                       Foreground="#991B1B"
                                       TextWrapping="Wrap"/>
                        </Border>
                        <Border Style="{StaticResource AlertSuccessStyle}"
                                Visibility="{Binding SuccessMessage, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="{Binding SuccessMessage}"
                                       Foreground="#065F46"
                                       TextWrapping="Wrap"/>
                        </Border>
                    </StackPanel>

                    <Button Grid.Column="1"
                            Content="Sınavı Oluştur"
                            Command="{Binding SaveCommand}"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Padding="28,12"
                            FontSize="14"
                            Margin="20,0,0,0"/>
                </Grid>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>
