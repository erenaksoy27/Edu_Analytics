<UserControl x:Class="EduAnalytics.UI.Views.ExamFromBankView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:EduAnalytics.UI.ViewModels"
             xmlns:enums="clr-namespace:EduAnalytics.Core.Enums;assembly=EduAnalytics.Core"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             d:DataContext="{d:DesignInstance Type=vm:ExamFromBankViewModel}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006">

    <!-- Wrap the entire page content in a ScrollViewer so it can scroll when window is small -->
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Başlık -->
            <StackPanel Grid.Row="0" Margin="0,0,0,12">
                <TextBlock Text="📚 Soru Bankasından Sınav Oluştur" Style="{StaticResource HeadingStyle}"/>
                <TextBlock TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}">
                    Yeni soru üretmek yerine soru bankasındaki aktif soruları seçerek hızlıca sınav kurun.
                    Vize tipinde sadece tarihe kadar olan ÖÇ'ler kullanılabilir.
                </TextBlock>
            </StackPanel>

            <!-- Sınav bilgi paneli -->
            <Border Grid.Row="1" Style="{StaticResource CardStyle}">
                <StackPanel>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Satır 1 -->
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Ders" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <TextBlock Grid.Row="0" Grid.Column="2" Text="Sınav Başlığı" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <TextBlock Grid.Row="0" Grid.Column="4" Text="Tarih" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <TextBlock Grid.Row="0" Grid.Column="6" Text="Süre (dk)" FontWeight="SemiBold" Margin="0,0,0,4"/>

                        <ComboBox Grid.Row="1" Grid.Column="0"
                                  ItemsSource="{Binding Courses}" SelectedItem="{Binding SelectedCourse}"
                                  DisplayMemberPath="Name" Padding="8,6"/>
                        <TextBox Grid.Row="1" Grid.Column="2"
                                 Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}" Padding="8,6"/>
                        <DatePicker Grid.Row="1" Grid.Column="4"
                                    SelectedDate="{Binding ExamDate}" Padding="8,4"/>
                        <TextBox Grid.Row="1" Grid.Column="6"
                                 Text="{Binding DurationMinutes, UpdateSourceTrigger=PropertyChanged}"
                                 Padding="8,6" Width="70"/>

                        <StackPanel Grid.Row="1" Grid.Column="8" Orientation="Horizontal">
                            <TextBlock Text="Tip:" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,4,0"/>
                            <ComboBox SelectedItem="{Binding ExamType}" Padding="8,6" Width="110">
                                <ComboBox.Items>
                                    <x:Static Member="enums:ExamType.Quiz"/>
                                    <x:Static Member="enums:ExamType.Midterm"/>
                                    <x:Static Member="enums:ExamType.Final"/>
                                    <x:Static Member="enums:ExamType.MakeUp"/>
                                </ComboBox.Items>
                            </ComboBox>
                        </StackPanel>
                    </Grid>

				<Border Style="{StaticResource CardStyle}" Margin="0,16,0,0">
					<StackPanel>
						<TextBlock Text="Sınava Girecek Öğrencileri Seçin" Style="{StaticResource SubheadingStyle}"/>
						<TextBlock Text="ℹ Birden fazla bölüm/sınıf seçebilirsiniz (alttan alan / yükseltme / ortak ders öğrencileri)."
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   FontSize="11" Margin="0,0,0,8"/>

						<!-- ÇOKLU SINIF/BÖLÜM FİLTRESİ (CheckBox listesi) -->
						<TextBlock Text="Sınıf/Bölüm Filtresi (çoklu seçim)" FontWeight="SemiBold" Margin="0,4,0,4"/>
						<Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6"
                                MaxHeight="100" Background="#F9FAFB" Margin="0,0,0,8">
							<ScrollViewer VerticalScrollBarVisibility="Auto" Padding="6">
								<ItemsControl ItemsSource="{Binding ClassFilters}">
									<ItemsControl.ItemsPanel>
										<ItemsPanelTemplate>
											<WrapPanel/>
										</ItemsPanelTemplate>
									</ItemsControl.ItemsPanel>
									<ItemsControl.ItemTemplate>
										<DataTemplate>
											<CheckBox Content="{Binding ClassName}"
                                                      IsChecked="{Binding IsSelected}"
                                                      Margin="6,4" Padding="4,0"
                                                      Cursor="Hand"/>
										</DataTemplate>
									</ItemsControl.ItemTemplate>
								</ItemsControl>
							</ScrollViewer>
						</Border>

						<StackPanel Orientation="Horizontal" Margin="0,0,0,8">
							<Button Content="✓ Tüm Sınıfları Seç"
                                    Command="{Binding SelectAllClassesCommand}"
                                    Padding="10,4" Margin="0,0,8,0"
                                    Background="#E0E7FF" Foreground="#3730A3"
                                    BorderThickness="0" Cursor="Hand" FontSize="11"/>
							<Button Content="✕ Sınıf Filtresini Temizle"
                                    Command="{Binding ClearClassFilterCommand}"
                                    Padding="10,4" Margin="0,0,16,0"
                                    Background="#FEE2E2" Foreground="#991B1B"
                                    BorderThickness="0" Cursor="Hand" FontSize="11"/>

							<Button Content="✓ Filtredeki Tüm Öğrencileri Seç"
                                    Command="{Binding SelectAllFilteredCommand}"
                                    Padding="10,4" Margin="0,0,8,0"
                                    Background="#D1FAE5" Foreground="#064E3B"
                                    BorderThickness="0" Cursor="Hand" FontSize="11" FontWeight="SemiBold"/>
							<Button Content="✕ Öğrenci Seçimini Temizle"
                                    Command="{Binding DeselectAllFilteredCommand}"
                                    Padding="10,4"
                                    Background="#FEE2E2" Foreground="#991B1B"
                                    BorderThickness="0" Cursor="Hand" FontSize="11" FontWeight="SemiBold"/>
						</StackPanel>

						<Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6" Height="220">
							<ScrollViewer VerticalScrollBarVisibility="Auto" Padding="4">
								<ItemsControl ItemsSource="{Binding FilteredStudents}">
									<ItemsControl.ItemTemplate>
										<DataTemplate>
											<CheckBox IsChecked="{Binding IsSelected}" Margin="8,6" Cursor="Hand">
												<TextBlock FontSize="14">
													<Run Text="{Binding StudentNumber}" FontWeight="SemiBold" Foreground="{StaticResource PrimaryBrush}"/>
													<Run Text=" - "/>
													<Run Text="{Binding FullName}"/>
													<Run Text=" (" Foreground="{StaticResource TextSecondaryBrush}"/>
													<Run Text="{Binding ClassName}" Foreground="{StaticResource TextSecondaryBrush}"/>
													<Run Text=")" Foreground="{StaticResource TextSecondaryBrush}"/>
												</TextBlock>
											</CheckBox>
										</DataTemplate>
									</ItemsControl.ItemTemplate>
								</ItemsControl>
							</ScrollViewer>
						</Border>
					</StackPanel>
				</Border>

                    <!-- Satır 2: Kitapçık ayarları -->
                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="24"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Text="Kitapçık Sayısı:" VerticalAlignment="Center" FontWeight="SemiBold"/>
                        <ComboBox Grid.Column="2"
                                  SelectedItem="{Binding BookletCount}"
                                  Padding="8,6" Width="80" VerticalAlignment="Center">
                            <ComboBox.Items>
                                <sys:Int32>1</sys:Int32>
                                <sys:Int32>2</sys:Int32>
                                <sys:Int32>3</sys:Int32>
                                <sys:Int32>4</sys:Int32>
                            </ComboBox.Items>
                        </ComboBox>

                        <CheckBox Grid.Column="4"
                                  IsChecked="{Binding ShuffleOptions}"
                                  Content="Şıkları karıştır"
                                  VerticalAlignment="Center"
                                  FontWeight="SemiBold"/>

                        <TextBlock Grid.Column="5" VerticalAlignment="Center" Margin="16,0,0,0"
                                   Foreground="{StaticResource TextSecondaryBrush}" FontSize="11"
                                   TextWrapping="Wrap">
                            ℹ Birden fazla kitapçıkta sorular farklı sırayla çıkar. "Şıkları karıştır" seçilirse B/C/D kitapçıklarında şıklar da permüte edilir.
                        </TextBlock>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- İki kolonlu havuz vs. seçili sorular -->
            <Grid Grid.Row="2" Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Sol: havuz -->
                <Border Grid.Column="0" Style="{StaticResource CardStyle}" Margin="0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="🔍 Soru Havuzu" Style="{StaticResource SubheadingStyle}"/>

                        <Grid Grid.Row="1" Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Text="{Binding BankSearchText, UpdateSourceTrigger=PropertyChanged}"
                                     Padding="8,6"/>
                            <Button Grid.Column="1" Content="Ara"
                                    Command="{Binding SearchPoolCommand}"
                                    Background="{StaticResource PrimaryBrush}"
                                    Foreground="White"
                                    Padding="14,6" Margin="6,0,0,0"
                                    BorderThickness="0" Cursor="Hand"/>
                        </Grid>

                        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding BankPool}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                                CornerRadius="4" Padding="10" Margin="0,0,0,6"
                                                Background="#FAFAFA">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0">
                                                    <TextBlock Text="{Binding QuestionText}"
                                                               TextWrapping="Wrap" FontSize="12"/>
                                                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                                        <Border Background="#DBEAFE" CornerRadius="3" Padding="4,1" Margin="0,0,4,0">
                                                            <TextBlock Text="{Binding Type}" Foreground="#1E3A8A" FontSize="10"/>
                                                        </Border>
                                                        <Border Background="#F3F4F6" CornerRadius="3" Padding="4,1">
                                                            <TextBlock FontSize="10" Foreground="{StaticResource TextSecondaryBrush}">
                                                                <Run Text="{Binding MaxPoints}"/>
                                                                <Run Text="p"/>
                                                            </TextBlock>
                                                        </Border>
                                                    </StackPanel>
                                                </StackPanel>
                                                <Button Grid.Column="1"
                                                        Content="+"
                                                        Command="{Binding DataContext.AddToExamCommand,
                                                                  RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"
                                                        Background="{StaticResource SuccessBrush}"
                                                        Foreground="White"
                                                        Padding="10,4"
                                                        BorderThickness="0"
                                                        Cursor="Hand"
                                                        FontWeight="Bold" FontSize="14"
                                                        Margin="6,0,0,0"
                                                        VerticalAlignment="Center"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Border>

                <!-- Sağ: seçili sorular -->
                <Border Grid.Column="2" Style="{StaticResource CardStyle}" Margin="0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Style="{StaticResource SubheadingStyle}">
                            <Run Text="✓ Seçilen Sorular ("/>
                            <Run Text="{Binding SelectedQuestions.Count, Mode=OneWay}"/>
                            <Run Text=")"/>
                        </TextBlock>

                        <!-- Denge önizlemesi -->
                        <Border Grid.Row="1" Background="#F0F9FF" CornerRadius="4" Padding="10" Margin="0,0,0,8"
                                Visibility="{Binding BalancePreview, Converter={StaticResource BoolToVisibility}}">
                            <StackPanel>
                                <TextBlock FontSize="11" Foreground="#0C4A6E">
                                    <Run Text="⚖ Denge Skoru:"/>
                                    <Run Text="{Binding BalancePreview.BalanceScore, FallbackValue='—'}" FontWeight="Bold"/>
                                    <Run Text="/100"/>
                                </TextBlock>
                                <TextBlock FontSize="10" Foreground="#0C4A6E"
                                           Visibility="{Binding BalancePreview.Warnings.Count, Converter={StaticResource BoolToVisibility}}">
                                    <Run Text="⚠"/>
                                    <Run Text="{Binding BalancePreview.Warnings.Count}"/>
                                    <Run Text="uyarı var (Sınav Dengesi sekmesinden inceleyin)"/>
                                </TextBlock>
                            </StackPanel>
                        </Border>

                        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding SelectedQuestions}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="{StaticResource PrimaryBrush}" BorderThickness="1"
                                                CornerRadius="4" Padding="10" Margin="0,0,0,6"
                                                Background="#EFF6FF">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0">
                                                    <TextBlock Text="{Binding QuestionText}"
                                                               TextWrapping="Wrap" FontSize="12"/>
                                                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                                        <Border Background="#DBEAFE" CornerRadius="3" Padding="4,1" Margin="0,0,4,0">
                                                            <TextBlock Text="{Binding Type}" Foreground="#1E3A8A" FontSize="10"/>
                                                        </Border>
                                                        <Border Background="#F3F4F6" CornerRadius="3" Padding="4,1">
                                                            <TextBlock FontSize="10" Foreground="{StaticResource TextSecondaryBrush}">
                                                                <Run Text="{Binding MaxPoints}"/>
                                                                <Run Text="p"/>
                                                            </TextBlock>
                                                        </Border>
                                                    </StackPanel>
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Button Content="↑"
                                                            Command="{Binding DataContext.MoveUpCommand,
                                                                      RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}"
                                                            Background="#F3F4F6"
                                                            BorderThickness="0"
                                                            Padding="6,2" Margin="2,0"
                                                            Cursor="Hand" FontSize="12"/>
                                                    <Button Content="↓"
                                                            Command="{Binding DataContext.MoveDownCommand,
                                                                      RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}"
                                                            Background="#F3F4F6"
                                                            BorderThickness="0"
                                                            Padding="6,2" Margin="2,0"
                                                            Cursor="Hand" FontSize="12"/>
                                                    <Button Content="✕"
                                                            Command="{Binding DataContext.RemoveFromExamCommand,
                                                                      RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}"
                                                            Background="Transparent"
                                                            Foreground="{StaticResource DangerBrush}"
                                                            BorderBrush="{StaticResource DangerBrush}"
                                                            BorderThickness="1"
                                                            Padding="6,2" Margin="4,0,0,0"
                                                            Cursor="Hand" FontSize="11"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>

            <!-- Alt bar -->
            <Border Grid.Row="3" Background="White" BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0,1,0,0" Padding="0,12,0,0" Margin="0,12,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <Border Background="#FEE2E2" BorderBrush="{StaticResource DangerBrush}" BorderThickness="1"
                                CornerRadius="4" Padding="12,6"
                                Visibility="{Binding ErrorMessage, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="{Binding ErrorMessage}" Foreground="#991B1B" TextWrapping="Wrap"/>
                        </Border>
                        <Border Background="#D1FAE5" BorderBrush="{StaticResource SuccessBrush}" BorderThickness="1"
                                CornerRadius="4" Padding="12,6"
                                Visibility="{Binding SuccessMessage, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="{Binding SuccessMessage}" Foreground="#064E3B" TextWrapping="Wrap"/>
                        </Border>
                    </StackPanel>

                    <Button Grid.Column="1"
                            Content="💾 Sınavı Oluştur"
                            Command="{Binding SaveCommand}"
                            Background="{StaticResource PrimaryBrush}"
                            Foreground="White"
                            Padding="24,12"
                            FontSize="14" FontWeight="SemiBold"
                            BorderThickness="0"
                            Cursor="Hand"
                            Margin="16,0,0,0"/>
                </Grid>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>
