<UserControl x:Class="EduAnalytics.UI.Views.AcademicStructureView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:EduAnalytics.UI.ViewModels"
             d:DataContext="{d:DesignInstance Type=vm:AcademicStructureViewModel}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Başlık -->
        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="🏛 Akademik Yapı Yönetimi" Style="{StaticResource HeadingStyle}"/>
            <TextBlock TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}">
                Programları, dersleri ve haftalık konuları buradan yönetin. Hiyerarşi: Program → Ders → Konu.
                Bağımlı kayıt (PÇ, ÖÇ, soru, sınav) varsa silme engellenir.
            </TextBlock>
        </StackPanel>

        <!-- Mesajlar -->
        <StackPanel Grid.Row="1" Margin="0,0,0,12">
            <Border Background="#FEE2E2" BorderBrush="{StaticResource DangerBrush}" BorderThickness="1"
                    CornerRadius="4" Padding="12,8" Margin="0,0,0,4"
                    Visibility="{Binding ErrorMessage, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="{Binding ErrorMessage}" Foreground="#991B1B" TextWrapping="Wrap"/>
            </Border>
            <Border Background="#D1FAE5" BorderBrush="{StaticResource SuccessBrush}" BorderThickness="1"
                    CornerRadius="4" Padding="12,8"
                    Visibility="{Binding SuccessMessage, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="{Binding SuccessMessage}" Foreground="#064E3B" TextWrapping="Wrap"/>
            </Border>
        </StackPanel>

        <!-- 3 KOLONLU LAYOUT -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ═══ KOLON 1: PROGRAMLAR ═══ -->
            <Border Grid.Column="0" Style="{StaticResource CardStyle}" Margin="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="🎓 Programlar" Style="{StaticResource SubheadingStyle}"/>

                    <!-- Form -->
                    <Border Grid.Row="1" Background="#F9FAFB" BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,8,0,8">
                        <StackPanel>
                            <TextBlock FontSize="11" FontWeight="SemiBold" Margin="0,0,0,4">
                                <Run Text="✏ "/>
                                <Run Text="{Binding EditingProgram.Code, FallbackValue='Yeni Program'}"/>
                            </TextBlock>
                            <TextBlock Text="Kod" FontSize="10" FontWeight="SemiBold" Margin="0,4,0,2"/>
                            <TextBox Text="{Binding ProgramFormCode, UpdateSourceTrigger=PropertyChanged}" Padding="6,4"/>

                            <TextBlock Text="Ad" FontSize="10" FontWeight="SemiBold" Margin="0,6,0,2"/>
                            <TextBox Text="{Binding ProgramFormName, UpdateSourceTrigger=PropertyChanged}" Padding="6,4"/>

                            <TextBlock Text="Açıklama" FontSize="10" FontWeight="SemiBold" Margin="0,6,0,2"/>
                            <TextBox Text="{Binding ProgramFormDescription, UpdateSourceTrigger=PropertyChanged}"
                                     AcceptsReturn="True" TextWrapping="Wrap" MinHeight="40" Padding="6,4"/>

                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <Button Content="💾 Kaydet"
                                        Command="{Binding SaveProgramCommand}"
                                        Background="{StaticResource PrimaryBrush}"
                                        Foreground="White" Padding="12,5"
                                        BorderThickness="0" Cursor="Hand"
                                        FontSize="11" FontWeight="SemiBold" Margin="0,0,4,0"/>
                                <Button Content="✕ Temizle"
                                        Command="{Binding StartNewProgramCommand}"
                                        Background="#F3F4F6"
                                        Foreground="{StaticResource TextSecondaryBrush}" Padding="10,5"
                                        BorderThickness="1" BorderBrush="{StaticResource BorderBrush}"
                                        Cursor="Hand" FontSize="11"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Liste -->
                    <ListBox Grid.Row="2"
                             ItemsSource="{Binding Programs}"
                             SelectedItem="{Binding SelectedProgram}"
                             Background="Transparent"
                             BorderBrush="{StaticResource BorderBrush}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="6,4" Margin="0,2">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <StackPanel Orientation="Horizontal">
                                                <Border Background="{StaticResource PrimaryBrush}" CornerRadius="3"
                                                        Padding="4,1" Margin="0,0,4,0">
                                                    <TextBlock Text="{Binding Code}" Foreground="White"
                                                               FontWeight="Bold" FontSize="10"/>
                                                </Border>
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="12"/>
                                            </StackPanel>
                                            <TextBlock FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0">
                                                <Run Text="{Binding CourseCount}"/>
                                                <Run Text="ders ·"/>
                                                <Run Text="{Binding OutcomeCount}"/>
                                                <Run Text="PÇ"/>
                                            </TextBlock>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button Content="✏"
                                                    Command="{Binding DataContext.StartEditProgramCommand,
                                                              RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    Background="Transparent" BorderThickness="0"
                                                    Padding="4,2" Cursor="Hand" FontSize="11"
                                                    ToolTip="Düzenle"/>
                                            <Button Content="🗑"
                                                    Command="{Binding DataContext.DeleteProgramCommand,
                                                              RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    Background="Transparent" BorderThickness="0"
                                                    Foreground="{StaticResource DangerBrush}"
                                                    Padding="4,2" Cursor="Hand" FontSize="11"
                                                    ToolTip="Sil"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <!-- ═══ KOLON 2: DERSLER ═══ -->
            <Border Grid.Column="2" Style="{StaticResource CardStyle}" Margin="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Style="{StaticResource SubheadingStyle}">
                        <Run Text="📘 Dersler:"/>
                        <Run Text="{Binding SelectedProgram.Name, FallbackValue='— program seçin —'}"
                             Foreground="{StaticResource PrimaryBrush}"/>
                    </TextBlock>

                    <!-- Form -->
                    <Border Grid.Row="1" Background="#F9FAFB" BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,8,0,8"
                            IsEnabled="{Binding SelectedProgram, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel>
                            <TextBlock FontSize="11" FontWeight="SemiBold" Margin="0,0,0,4">
                                <Run Text="✏ "/>
                                <Run Text="{Binding EditingCourse.Code, FallbackValue='Yeni Ders'}"/>
                            </TextBlock>
                            <TextBlock Text="Kod" FontSize="10" FontWeight="SemiBold" Margin="0,4,0,2"/>
                            <TextBox Text="{Binding CourseFormCode, UpdateSourceTrigger=PropertyChanged}" Padding="6,4"/>

                            <TextBlock Text="Ad" FontSize="10" FontWeight="SemiBold" Margin="0,6,0,2"/>
                            <TextBox Text="{Binding CourseFormName, UpdateSourceTrigger=PropertyChanged}" Padding="6,4"/>

                            <TextBlock Text="Açıklama" FontSize="10" FontWeight="SemiBold" Margin="0,6,0,2"/>
                            <TextBox Text="{Binding CourseFormDescription, UpdateSourceTrigger=PropertyChanged}"
                                     AcceptsReturn="True" TextWrapping="Wrap" MinHeight="40" Padding="6,4"/>

                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <Button Content="💾 Kaydet"
                                        Command="{Binding SaveCourseCommand}"
                                        Background="{StaticResource PrimaryBrush}"
                                        Foreground="White" Padding="12,5"
                                        BorderThickness="0" Cursor="Hand"
                                        FontSize="11" FontWeight="SemiBold" Margin="0,0,4,0"/>
                                <Button Content="✕ Temizle"
                                        Command="{Binding StartNewCourseCommand}"
                                        Background="#F3F4F6"
                                        Foreground="{StaticResource TextSecondaryBrush}" Padding="10,5"
                                        BorderThickness="1" BorderBrush="{StaticResource BorderBrush}"
                                        Cursor="Hand" FontSize="11"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Liste -->
                    <ListBox Grid.Row="2"
                             ItemsSource="{Binding Courses}"
                             SelectedItem="{Binding SelectedCourse}"
                             Background="Transparent"
                             BorderBrush="{StaticResource BorderBrush}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="6,4" Margin="0,2">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <StackPanel Orientation="Horizontal">
                                                <Border Background="#10B981" CornerRadius="3"
                                                        Padding="4,1" Margin="0,0,4,0">
                                                    <TextBlock Text="{Binding Code}" Foreground="White"
                                                               FontWeight="Bold" FontSize="10"/>
                                                </Border>
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="12"/>
                                            </StackPanel>
                                            <TextBlock FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0">
                                                <Run Text="{Binding TopicCount}"/>
                                                <Run Text="konu ·"/>
                                                <Run Text="{Binding LearningOutcomeCount}"/>
                                                <Run Text="ÖÇ ·"/>
                                                <Run Text="{Binding QuestionCount}"/>
                                                <Run Text="soru ·"/>
                                                <Run Text="{Binding ExamCount}"/>
                                                <Run Text="sınav"/>
                                            </TextBlock>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button Content="✏"
                                                    Command="{Binding DataContext.StartEditCourseCommand,
                                                              RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    Background="Transparent" BorderThickness="0"
                                                    Padding="4,2" Cursor="Hand" FontSize="11"
                                                    ToolTip="Düzenle"/>
                                            <Button Content="🗑"
                                                    Command="{Binding DataContext.DeleteCourseCommand,
                                                              RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    Background="Transparent" BorderThickness="0"
                                                    Foreground="{StaticResource DangerBrush}"
                                                    Padding="4,2" Cursor="Hand" FontSize="11"
                                                    ToolTip="Sil"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <!-- ═══ KOLON 3: KONULAR ═══ -->
            <Border Grid.Column="4" Style="{StaticResource CardStyle}" Margin="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Style="{StaticResource SubheadingStyle}">
                        <Run Text="📅 Konular:"/>
                        <Run Text="{Binding SelectedCourse.Name, FallbackValue='— ders seçin —'}"
                             Foreground="{StaticResource PrimaryBrush}"/>
                    </TextBlock>

                    <!-- Form -->
                    <Border Grid.Row="1" Background="#F9FAFB" BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,8,0,8"
                            IsEnabled="{Binding SelectedCourse, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel>
                            <TextBlock FontSize="11" FontWeight="SemiBold" Margin="0,0,0,4">
                                <Run Text="✏ Hafta "/>
                                <Run Text="{Binding TopicFormWeek}"/>
                            </TextBlock>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Hafta" FontSize="10" FontWeight="SemiBold"
                                           Margin="0,4,8,2" VerticalAlignment="Center"/>
                                <TextBox Grid.Column="1"
                                         Text="{Binding TopicFormWeek, UpdateSourceTrigger=PropertyChanged}"
                                         Padding="6,4" Width="60" HorizontalAlignment="Left"/>
                            </Grid>

                            <TextBlock Text="Başlık" FontSize="10" FontWeight="SemiBold" Margin="0,6,0,2"/>
                            <TextBox Text="{Binding TopicFormTitle, UpdateSourceTrigger=PropertyChanged}" Padding="6,4"/>

                            <TextBlock Text="Açıklama" FontSize="10" FontWeight="SemiBold" Margin="0,6,0,2"/>
                            <TextBox Text="{Binding TopicFormDescription, UpdateSourceTrigger=PropertyChanged}"
                                     AcceptsReturn="True" TextWrapping="Wrap" MinHeight="40" Padding="6,4"/>

                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <Button Content="💾 Kaydet"
                                        Command="{Binding SaveTopicCommand}"
                                        Background="{StaticResource PrimaryBrush}"
                                        Foreground="White" Padding="12,5"
                                        BorderThickness="0" Cursor="Hand"
                                        FontSize="11" FontWeight="SemiBold" Margin="0,0,4,0"/>
                                <Button Content="✕ Temizle"
                                        Command="{Binding StartNewTopicCommand}"
                                        Background="#F3F4F6"
                                        Foreground="{StaticResource TextSecondaryBrush}" Padding="10,5"
                                        BorderThickness="1" BorderBrush="{StaticResource BorderBrush}"
                                        Cursor="Hand" FontSize="11"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Liste -->
                    <ListBox Grid.Row="2"
                             ItemsSource="{Binding Topics}"
                             SelectedItem="{Binding SelectedTopic}"
                             Background="Transparent"
                             BorderBrush="{StaticResource BorderBrush}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="6,4" Margin="0,2">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <StackPanel Orientation="Horizontal">
                                                <Border Background="#F59E0B" CornerRadius="3"
                                                        Padding="4,1" Margin="0,0,4,0">
                                                    <TextBlock Foreground="White" FontWeight="Bold" FontSize="10">
                                                        <Run Text="H"/>
                                                        <Run Text="{Binding WeekNumber}"/>
                                                    </TextBlock>
                                                </Border>
                                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="12"/>
                                            </StackPanel>
                                            <TextBlock FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0">
                                                <Run Text="{Binding LearningOutcomeCount}"/>
                                                <Run Text="ÖÇ ·"/>
                                                <Run Text="{Binding QuestionCount}"/>
                                                <Run Text="soru"/>
                                            </TextBlock>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button Content="✏"
                                                    Command="{Binding DataContext.StartEditTopicCommand,
                                                              RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    Background="Transparent" BorderThickness="0"
                                                    Padding="4,2" Cursor="Hand" FontSize="11"
                                                    ToolTip="Düzenle"/>
                                            <Button Content="🗑"
                                                    Command="{Binding DataContext.DeleteTopicCommand,
                                                              RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    Background="Transparent" BorderThickness="0"
                                                    Foreground="{StaticResource DangerBrush}"
                                                    Padding="4,2" Cursor="Hand" FontSize="11"
                                                    ToolTip="Sil"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>
        </Grid>

        <!-- Loading overlay -->
        <Border Grid.Row="0" Grid.RowSpan="3" Background="#80FFFFFF"
                Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}">
            <TextBlock Text="Yükleniyor..." HorizontalAlignment="Center" VerticalAlignment="Center"
                       FontSize="18" Foreground="{StaticResource PrimaryBrush}"/>
        </Border>
    </Grid>
</UserControl>
