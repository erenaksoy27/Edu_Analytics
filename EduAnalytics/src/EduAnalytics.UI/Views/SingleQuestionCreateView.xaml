<UserControl x:Class="EduAnalytics.UI.Views.SingleQuestionCreateView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:vm="clr-namespace:EduAnalytics.UI.ViewModels"
             xmlns:enums="clr-namespace:EduAnalytics.Core.Enums;assembly=EduAnalytics.Core"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             mc:Ignorable="d" 
             d:DesignHeight="900" d:DesignWidth="1000"
             Background="{StaticResource PageBgBrush}">

    <UserControl.Resources>
		<ObjectDataProvider x:Key="QuestionTypeValues"
                            MethodName="GetValues" ObjectType="{x:Type sys:Enum}">
			<ObjectDataProvider.MethodParameters>
				<x:Type TypeName="enums:QuestionType"/>
			</ObjectDataProvider.MethodParameters>
		</ObjectDataProvider>
	</UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="Yeni Soru Olustur" Style="{StaticResource HeadingStyle}"/>
            <TextBlock Text="Soru Bankasina yeni bir test veya klasik soru ekleyebilirsiniz." Foreground="{StaticResource TextSecondaryBrush}"/>
        </StackPanel>
        
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,0,8,0">
            <StackPanel Margin="0,0,0,20">
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="Temel Bilgiler" Style="{StaticResource SubheadingStyle}"/>

                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Ders Secimi" FontWeight="SemiBold" Margin="0,0,0,4"/>
                            <ComboBox Grid.Row="1" Grid.Column="0"
                                      ItemsSource="{Binding Courses}"
                                      SelectedItem="{Binding SelectedCourse}"
                                      DisplayMemberPath="Name"
                                      Padding="8,6" FontSize="14"
                                      Margin="0,0,0,16"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Question Editor Section -->
                <Border Style="{StaticResource CardStyle}" Padding="16" Margin="0,16,0,0" DataContext="{Binding Question}">
                    <StackPanel>
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="140"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" VerticalAlignment="Center" FontSize="16" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" Text="Soru Detayi" />

                            <ComboBox Grid.Column="2" ItemsSource="{Binding Source={StaticResource QuestionTypeValues}}" SelectedItem="{Binding Type}" Padding="8,4" VerticalAlignment="Center">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock>
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="{Binding}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding}" Value="MultipleChoice">
                                                            <Setter Property="Text" Value="Test"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding}" Value="OpenEnded">
                                                            <Setter Property="Text" Value="Klasik"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>

                            <TextBlock Grid.Column="4" Text="Puan:" VerticalAlignment="Center" FontWeight="SemiBold"/>
                            <TextBox Grid.Column="5" Text="{Binding MaxPoints, UpdateSourceTrigger=PropertyChanged}" Width="60" Padding="6,4" VerticalAlignment="Center" Margin="6,0,0,0" HorizontalAlignment="Left"/>
                        </Grid>

                        <TextBlock Text="Soru Metni" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding QuestionText, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="60" Padding="8,6" Margin="0,0,0,12"/>

                        <StackPanel Visibility="{Binding IsMultipleChoice, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="Siklar" FontWeight="SemiBold" Margin="0,0,0,6"/>

                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="30"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="30"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="A)" VerticalAlignment="Center" FontWeight="Bold"/>
                                <TextBox Grid.Column="1" Text="{Binding OptionA, UpdateSourceTrigger=PropertyChanged}" Padding="6,4"/>
                                <TextBlock Grid.Column="3" Text="B)" VerticalAlignment="Center" FontWeight="Bold"/>
                                <TextBox Grid.Column="4" Text="{Binding OptionB, UpdateSourceTrigger=PropertyChanged}" Padding="6,4"/>
                            </Grid>

                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="30"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="30"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="C)" VerticalAlignment="Center" FontWeight="Bold"/>
                                <TextBox Grid.Column="1" Text="{Binding OptionC, UpdateSourceTrigger=PropertyChanged}" Padding="6,4"/>
                                <TextBlock Grid.Column="3" Text="D)" VerticalAlignment="Center" FontWeight="Bold"/>
                                <TextBox Grid.Column="4" Text="{Binding OptionD, UpdateSourceTrigger=PropertyChanged}" Padding="6,4"/>
                            </Grid>

                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="30"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="30"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="E)" VerticalAlignment="Center" FontWeight="Bold"/>
                                <TextBox Grid.Column="1" Text="{Binding OptionE, UpdateSourceTrigger=PropertyChanged}" Padding="6,4"/>
                            </Grid>

                            <TextBlock Text="Dogru Sik" FontWeight="SemiBold" Margin="0,0,0,4"/>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                <RadioButton Content="A" Margin="0,0,16,0" FontWeight="Bold" IsChecked="{Binding CorrectOption, Converter={StaticResource EnumEquals}, ConverterParameter=A}"/>
                                <RadioButton Content="B" Margin="0,0,16,0" FontWeight="Bold" IsChecked="{Binding CorrectOption, Converter={StaticResource EnumEquals}, ConverterParameter=B}"/>
                                <RadioButton Content="C" Margin="0,0,16,0" FontWeight="Bold" IsChecked="{Binding CorrectOption, Converter={StaticResource EnumEquals}, ConverterParameter=C}"/>
                                <RadioButton Content="D" Margin="0,0,16,0" FontWeight="Bold" IsChecked="{Binding CorrectOption, Converter={StaticResource EnumEquals}, ConverterParameter=D}"/>
                                <RadioButton Content="E" Margin="0,0,16,0" FontWeight="Bold" IsChecked="{Binding CorrectOption, Converter={StaticResource EnumEquals}, ConverterParameter=E}"/>
                            </StackPanel>
                        </StackPanel>

                        <StackPanel Visibility="{Binding IsOpenEnded, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="Cevap Anahtari / Notlandirma Rehberi" FontWeight="SemiBold" Margin="0,0,0,4"/>
                            <TextBox Text="{Binding AnswerKey, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="60" Padding="8,6" Margin="0,0,0,12"/>
                        </StackPanel>

                        <TextBlock Text="Konular (Bologna Ciktilari)" FontWeight="SemiBold" Margin="0,0,0,4"/>

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ComboBox Grid.Column="0" ItemsSource="{Binding AvailableTopics}" SelectedItem="{Binding TopicToAdd}" Padding="8,4" VerticalAlignment="Center">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="H" Foreground="{StaticResource TextSecondaryBrush}"/>
                                            <TextBlock Text="{Binding WeekNumber}" Foreground="{StaticResource TextSecondaryBrush}"/>
                                            <TextBlock Text=" - "/>
                                            <TextBlock Text="{Binding Title}"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <Button Grid.Column="1" Content="+ Ekle" Command="{Binding AddTopicCommand}" Background="{StaticResource SuccessBrush}" Foreground="White" Padding="12,6" BorderThickness="0" Margin="8,0,0,0" Cursor="Hand"/>
                        </Grid>

                        <ItemsControl ItemsSource="{Binding SelectedTopics}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#DBEAFE" CornerRadius="4" Padding="8,4" Margin="0,0,6,6">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Foreground="#1E3A8A" FontSize="12" VerticalAlignment="Center">
                                                <Run Text="H"/>
                                                <Run Text="{Binding WeekNumber}"/>
                                                <Run Text=" - "/>
                                                <Run Text="{Binding Title}"/>
                                            </TextBlock>
                                            <Button Content="x" Command="{Binding DataContext.RemoveTopicCommand, RelativeSource={RelativeSource AncestorType=Border, AncestorLevel=2}}" CommandParameter="{Binding}" Background="Transparent" BorderThickness="0" Foreground="#1E3A8A" Margin="6,0,0,0" Padding="2,0" Cursor="Hand" FontWeight="Bold"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Footer With Save -->
        <Border Grid.Row="2" Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="0,12,0,0" Margin="0,12,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <Border Background="#FEE2E2" BorderBrush="{StaticResource DangerBrush}" BorderThickness="1" CornerRadius="4" Padding="12,8" Visibility="{Binding ErrorMessage, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="{Binding ErrorMessage}" Foreground="#991B1B" TextWrapping="Wrap"/>
                    </Border>
                    <Border Background="#D1FAE5" BorderBrush="{StaticResource SuccessBrush}" BorderThickness="1" CornerRadius="4" Padding="12,8" Visibility="{Binding SuccessMessage, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="{Binding SuccessMessage}" Foreground="#064E3B" TextWrapping="Wrap"/>
                    </Border>
                </StackPanel>

                <Button Grid.Column="1" Content="Kaydet" Command="{Binding SaveCommand}" IsEnabled="{Binding IsSaving, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}" Background="{StaticResource PrimaryBrush}" Foreground="White" Padding="24,12" FontSize="14" FontWeight="SemiBold" BorderThickness="0" Cursor="Hand" Margin="16,0,0,0"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>