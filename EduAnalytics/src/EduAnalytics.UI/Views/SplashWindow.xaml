<Window x:Class="EduAnalytics.UI.Views.SplashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mi="clr-namespace:Material.Icons.WPF;assembly=Material.Icons.WPF"
        Title="EduAnalytics"
        Width="340" Height="220"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="Transparent">

    <Border Background="#111827"
            CornerRadius="12">
        <Border.Effect>
            <DropShadowEffect Color="#000000" Direction="270"
                              ShadowDepth="8" BlurRadius="24" Opacity="0.45"/>
        </Border.Effect>

        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
            <mi:MaterialIcon Kind="School"
                             Width="64" Height="64"
                             Foreground="#4F46E5"
                             HorizontalAlignment="Center"/>
            <TextBlock Text="EduAnalytics"
                       Foreground="#F8FAFC"
                       FontFamily="Segoe UI, Inter, system-ui"
                       FontSize="22"
                       FontWeight="SemiBold"
                       HorizontalAlignment="Center"
                       Margin="0,14,0,0"/>
            <TextBlock Text="Ölçme değerlendirme paneli"
                       Foreground="#9CA3AF"
                       FontFamily="Segoe UI, Inter, system-ui"
                       FontSize="12"
                       HorizontalAlignment="Center"
                       Margin="0,6,0,0"/>
        </StackPanel>
    </Border>
</Window>
