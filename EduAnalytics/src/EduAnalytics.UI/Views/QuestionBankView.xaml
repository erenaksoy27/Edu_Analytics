<UserControl x:Class="EduAnalytics.UI.Views.QuestionBankView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:EduAnalytics.UI.ViewModels"
             d:DataContext="{d:DesignInstance Type=vm:QuestionBankViewModel}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Başlık -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="Soru Bankası" Style="{StaticResource HeadingStyle}"/>
            <TextBlock Text="Ders bazlı soru havuzu. Aktif ettiğiniz sorular sınavlarda kullanılabilir."
                       Foreground="{StaticResource TextSecondaryBrush}"/>
        </StackPanel>

        <!-- Soru Ekle Butonu -->
        <Button Grid.Row="0"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Content="+ Soru Ekle"
                Command="{Binding NavigateToCreateQuestionCommand}"
                Style="{StaticResource PrimaryButtonStyle}"
                Padding="16,8"
                Margin="0,0,0,16"/>

        <!-- Filtre paneli -->
        <Border Grid.Row="1" Style="{StaticResource CardStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Ders -->
                <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,12,8">
                    <TextBlock Text="Ders" FontWeight="SemiBold" Margin="0,0,0,4"/>
                    <ComboBox ItemsSource="{Binding Courses}"
                              SelectedItem="{Binding SelectedCourse}"
                              DisplayMemberPath="Name"
                              Padding="8,6"/>
                </StackPanel>

                <!-- Arama (otomatik / debounce) -->
                <StackPanel Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,0,0,8">
                    <TextBlock Text="🔍 Soru metninde ara" FontWeight="SemiBold" Margin="0,0,0,4"/>
                    <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             Padding="8,6"/>
                </StackPanel>

                <!-- Filtre satırı -->
                <StackPanel Grid.Row="1" Grid.ColumnSpan="3" Orientation="Horizontal" Margin="0,8,0,0">
                    <TextBlock Text="Tip:" VerticalAlignment="Center" Margin="0,0,8,0" FontWeight="SemiBold"/>
                    <ComboBox SelectedItem="{Binding TypeFilter}" Width="100" Padding="6,4" Margin="0,0,16,0">
                        <sys:String xmlns:sys="clr-namespace:System;assembly=mscorlib">Tümü</sys:String>
                        <sys:String xmlns:sys="clr-namespace:System;assembly=mscorlib">Test</sys:String>
                        <sys:String xmlns:sys="clr-namespace:System;assembly=mscorlib">Klasik</sys:String>
                    </ComboBox>

                    <CheckBox Content="Sadece favoriler"
                              IsChecked="{Binding FilterFavoriteOnly}"
                              VerticalAlignment="Center" Margin="0,0,16,0"/>

                    <TextBlock Text="Durum:" VerticalAlignment="Center" Margin="0,0,8,0" FontWeight="SemiBold"/>
                    <ComboBox SelectedItem="{Binding FilterStatus}" Width="100" Padding="6,4" VerticalAlignment="Center">
                        <sys:String xmlns:sys="clr-namespace:System;assembly=mscorlib">Tümü</sys:String>
                        <sys:String xmlns:sys="clr-namespace:System;assembly=mscorlib">Aktif</sys:String>
                        <sys:String xmlns:sys="clr-namespace:System;assembly=mscorlib">Pasif</sys:String>
                    </ComboBox>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Soru listesi -->
        <Grid Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Hata / Başarı mesajı -->
            <StackPanel Grid.Row="0">
                <Border Background="#FEE2E2" BorderBrush="{StaticResource DangerBrush}" BorderThickness="1"
                        CornerRadius="4" Padding="12,8" Margin="0,0,0,8"
                        Visibility="{Binding ErrorMessage, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="{Binding ErrorMessage}" Foreground="#991B1B" TextWrapping="Wrap"/>
                </Border>
                <Border Background="#D1FAE5" BorderBrush="{StaticResource SuccessBrush}" BorderThickness="1"
                        CornerRadius="4" Padding="12,8" Margin="0,0,0,8"
                        Visibility="{Binding SuccessMessage, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="{Binding SuccessMessage}" Foreground="#064E3B" TextWrapping="Wrap"/>
                </Border>
            </StackPanel>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Questions}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource CardStyle}" Padding="16">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="40"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Sol: favori yıldızı -->
                                    <Button Grid.Column="0"
                                            Command="{Binding DataContext.ToggleFavoriteCommand,
                                                      RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Cursor="Hand"
                                            VerticalAlignment="Top">
                                        <TextBlock FontSize="20">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="☆"/>
                                                    <Setter Property="Foreground" Value="#9CA3AF"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsFavorite}" Value="True">
                                                            <Setter Property="Text" Value="★"/>
                                                            <Setter Property="Foreground" Value="#F59E0B"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Button>

                                    <!-- Orta: soru içeriği -->
                                    <StackPanel Grid.Column="1">
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                            <Border Background="#DBEAFE" CornerRadius="4" Padding="6,2" Margin="0,0,6,0">
                                                <TextBlock Text="{Binding Type}" Foreground="#1E3A8A" FontSize="11" FontWeight="SemiBold"/>
                                            </Border>
                                            <Border Background="#F3F4F6" CornerRadius="4" Padding="6,2" Margin="0,0,6,0">
                                                <TextBlock FontSize="11" Foreground="{StaticResource TextSecondaryBrush}">
                                                    <Run Text="{Binding MaxPoints}"/>
                                                    <Run Text="puan"/>
                                                </TextBlock>
                                            </Border>
                                            <Border Background="#FEF3C7" CornerRadius="4" Padding="6,2" Margin="0,0,6,0"
                                                    Visibility="{Binding UsedInExamCount, Converter={StaticResource BoolToVisibility}}">
                                                <TextBlock FontSize="11" Foreground="#92400E">
                                                    <Run Text="{Binding UsedInExamCount}"/>
                                                    <Run Text="sınavda kullanıldı"/>
                                                </TextBlock>
                                            </Border>
                                        </StackPanel>

                                        <TextBlock Text="{Binding QuestionText}"
                                                   TextWrapping="Wrap"
                                                   Foreground="{StaticResource TextPrimaryBrush}"
                                                   Margin="0,0,0,6"/>

                                        <!-- ÖÇ ve hafta etiketleri -->
                                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                            <ItemsControl ItemsSource="{Binding LearningOutcomeCodes}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <WrapPanel/>
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Background="#E0E7FF" CornerRadius="3" Padding="5,2" Margin="0,0,4,2">
                                                            <TextBlock Text="{Binding}" Foreground="#3730A3" FontSize="10" FontWeight="SemiBold"/>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </StackPanel>

                                    <!-- Sağ: aksiyon butonları -->
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top">
                                        <!-- Aktif/Pasif toggle -->
                                        <Button Command="{Binding DataContext.ToggleActiveCommand,
                                                          RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                Padding="10,4"
                                                BorderThickness="1"
                                                Cursor="Hand"
                                                Margin="0,0,6,0"
                                                FontSize="12"
                                                FontWeight="SemiBold">
                                            <Button.Style>
                                                <Style TargetType="Button">
                                                    <Setter Property="Content" Value="○ Pasif"/>
                                                    <Setter Property="Background" Value="#F3F4F6"/>
                                                    <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                                                    <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                            <Setter Property="Content" Value="● Aktif"/>
                                                            <Setter Property="Background" Value="#D1FAE5"/>
                                                            <Setter Property="Foreground" Value="#064E3B"/>
                                                            <Setter Property="BorderBrush" Value="{StaticResource SuccessBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>

                                        <Button Content="🗑"
                                                Command="{Binding DataContext.DeleteCommand,
                                                          RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                Background="Transparent"
                                                BorderBrush="{StaticResource DangerBrush}"
                                                BorderThickness="1"
                                                Foreground="{StaticResource DangerBrush}"
                                                Padding="10,4"
                                                Cursor="Hand"
                                                FontSize="12"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- Boş durum -->
            <Border Grid.Row="1"
                    Visibility="{Binding Questions.Count, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}"
                    VerticalAlignment="Center" HorizontalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="📦" FontSize="48" HorizontalAlignment="Center" Foreground="#D1D5DB"/>
                    <TextBlock Text="Bu derste henüz soru yok"
                               HorizontalAlignment="Center" FontSize="16"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               Margin="0,12,0,0"/>
                    <TextBlock Text="'Sınav Oluştur' ekranından soru ekleyebilirsiniz."
                               HorizontalAlignment="Center" FontSize="12"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               Margin="0,4,0,0"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Yükleniyor overlay -->
        <Border Grid.RowSpan="3" Background="#80FFFFFF"
                Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}">
            <TextBlock Text="Yükleniyor..." HorizontalAlignment="Center" VerticalAlignment="Center"
                       FontSize="18" Foreground="{StaticResource PrimaryBrush}"/>
        </Border>
    </Grid>
</UserControl>
