<UserControl x:Class="EduAnalytics.UI.Views.ExamCreateView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:EduAnalytics.UI.ViewModels"
             xmlns:enums="clr-namespace:EduAnalytics.Core.Enums;assembly=EduAnalytics.Core"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             d:DataContext="{d:DesignInstance Type=vm:ExamCreateViewModel}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             xmlns:conv="clr-namespace:EduAnalytics.UI.Converters"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006">

	<UserControl.Resources>
		<ObjectDataProvider x:Key="QuestionTypeValues"
                            MethodName="GetValues" ObjectType="{x:Type sys:Enum}">
			<ObjectDataProvider.MethodParameters>
				<x:Type TypeName="enums:QuestionType"/>
			</ObjectDataProvider.MethodParameters>
		</ObjectDataProvider>
        <conv:ContainsLearningOutcomeConverter x:Key="ContainsLoConverter"/>
	</UserControl.Resources>

	<Grid>
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="*"/>
			<RowDefinition Height="Auto"/>
		</Grid.RowDefinitions>

		<StackPanel Grid.Row="0" Margin="0,0,0,16">
			<TextBlock Text="Yeni Sınav Oluştur" Style="{StaticResource HeadingStyle}"/>
			<TextBlock Text="Karma sınav yapabilirsiniz: test ve klasik sorular bir arada."
                       Foreground="{StaticResource TextSecondaryBrush}"/>
		</StackPanel>

		<ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,0,8,0">
			<StackPanel>
				<Border Style="{StaticResource CardStyle}">
					<StackPanel>
						<TextBlock Text="Sınav Bilgileri" Style="{StaticResource SubheadingStyle}"/>

						<Grid Margin="0,8,0,0">
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="*"/>
								<ColumnDefinition Width="16"/>
								<ColumnDefinition Width="Auto"/>
							</Grid.ColumnDefinitions>
							<Grid.RowDefinitions>
								<RowDefinition Height="Auto"/>
								<RowDefinition Height="Auto"/>
								<RowDefinition Height="Auto"/>
								<RowDefinition Height="Auto"/>
							</Grid.RowDefinitions>

							<TextBlock Grid.Row="0" Grid.Column="0" Text="Ders"
                                       FontWeight="SemiBold" Margin="0,0,0,4"/>
							<ComboBox Grid.Row="1" Grid.Column="0"
                                      ItemsSource="{Binding Courses}"
                                      SelectedItem="{Binding SelectedCourse}"
                                      DisplayMemberPath="Name"
                                      Padding="8,6" FontSize="14"
                                      Margin="0,0,0,16"/>

							<TextBlock Grid.Row="0" Grid.Column="2" Text="Sınav Tarihi"
                                       FontWeight="SemiBold" Margin="0,0,0,4"/>
							<DatePicker Grid.Row="1" Grid.Column="2"
                                        SelectedDate="{Binding ExamDate}"
                                        Padding="8,6" FontSize="14"
                                        Margin="0,0,0,16"/>

							<TextBlock Grid.Row="2" Grid.ColumnSpan="3" Text="Sınav Başlığı / Konusu"
                                       FontWeight="SemiBold" Margin="0,0,0,4"/>
							<TextBox Grid.Row="3" Grid.ColumnSpan="3"
                                     Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}"
                                     Padding="8,6" FontSize="14"/>
						</Grid>
					</StackPanel>
				</Border>

				<!-- ASOS yenileme: Sınav Ayarları -->
				<Border Style="{StaticResource CardStyle}" Margin="0,16,0,0">
					<StackPanel>
						<TextBlock Text="Sınav Ayarları" Style="{StaticResource SubheadingStyle}"/>

						<Grid Margin="0,8,0,0">
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="*"/>
								<ColumnDefinition Width="16"/>
								<ColumnDefinition Width="*"/>
								<ColumnDefinition Width="16"/>
								<ColumnDefinition Width="Auto"/>
								<ColumnDefinition Width="16"/>
								<ColumnDefinition Width="Auto"/>
							</Grid.ColumnDefinitions>
							<Grid.RowDefinitions>
								<RowDefinition Height="Auto"/>
								<RowDefinition Height="Auto"/>
							</Grid.RowDefinitions>

							<!-- Sınav Tipi -->
							<TextBlock Grid.Row="0" Grid.Column="0" Text="Sınav Tipi"
                                       FontWeight="SemiBold" Margin="0,0,0,4"/>
							<ComboBox Grid.Row="1" Grid.Column="0"
                                      SelectedItem="{Binding ExamType}"
                                      Padding="8,6">
								<ComboBox.Items>
									<x:Static Member="enums:ExamType.Quiz"/>
									<x:Static Member="enums:ExamType.Midterm"/>
									<x:Static Member="enums:ExamType.Final"/>
									<x:Static Member="enums:ExamType.MakeUp"/>
								</ComboBox.Items>
							</ComboBox>

							<!-- Süre -->
							<TextBlock Grid.Row="0" Grid.Column="2" Text="Süre (dakika)"
                                       FontWeight="SemiBold" Margin="0,0,0,4"/>
							<TextBox Grid.Row="1" Grid.Column="2"
                                     Text="{Binding DurationMinutes, UpdateSourceTrigger=PropertyChanged}"
                                     Padding="8,6"/>

							<!-- Kitapçık Sayısı -->
							<TextBlock Grid.Row="0" Grid.Column="4" Text="Kitapçık"
                                       FontWeight="SemiBold" Margin="0,0,0,4"/>
							<ComboBox Grid.Row="1" Grid.Column="4"
                                      SelectedItem="{Binding BookletCount}"
                                      Padding="8,6" Width="80">
								<ComboBox.Items>
									<sys:Int32 xmlns:sys="clr-namespace:System;assembly=mscorlib">1</sys:Int32>
									<sys:Int32 xmlns:sys="clr-namespace:System;assembly=mscorlib">2</sys:Int32>
									<sys:Int32 xmlns:sys="clr-namespace:System;assembly=mscorlib">3</sys:Int32>
									<sys:Int32 xmlns:sys="clr-namespace:System;assembly=mscorlib">4</sys:Int32>
								</ComboBox.Items>
							</ComboBox>

							<!-- Şıkları Karıştır -->
							<CheckBox Grid.Row="1" Grid.Column="6"
                                      IsChecked="{Binding ShuffleOptions}"
                                      Content="Şıkları karıştır"
                                      VerticalAlignment="Center"
                                      FontWeight="SemiBold"/>
						</Grid>

						<TextBlock Margin="0,12,0,0"
                                   Text="ℹ Vize seçilirse soru havuzu Hafta 7'ye kadar olan ÖÇ'lerle sınırlanabilir. Kitapçık sayısı 1'den fazla olunca sorular her kitapçıkta farklı sırayla çıkar."
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   FontSize="11" TextWrapping="Wrap"/>
					</StackPanel>
				</Border>

				<Border Style="{StaticResource CardStyle}" Margin="0,16,0,0">
					<StackPanel>
						<TextBlock Text="Sınava Girecek Öğrencileri Seçin" Style="{StaticResource SubheadingStyle}"/>
						<TextBlock Text="ℹ Birden fazla bölüm/sınıf seçebilirsiniz (alttan alan / yükseltme / ortak ders öğrencileri)."
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   FontSize="11" Margin="0,0,0,8"/>

						<!-- ÇOKLU SINIF/BÖLÜM FİLTRESİ (CheckBox listesi) -->
						<TextBlock Text="Sınıf/Bölüm Filtresi (çoklu seçim)" FontWeight="SemiBold" Margin="0,4,0,4"/>
						<Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6"
                                MaxHeight="100" Background="#F9FAFB" Margin="0,0,0,8">
							<ScrollViewer VerticalScrollBarVisibility="Auto" Padding="6">
								<ItemsControl ItemsSource="{Binding ClassFilters}">
									<ItemsControl.ItemsPanel>
										<ItemsPanelTemplate>
											<WrapPanel/>
										</ItemsPanelTemplate>
									</ItemsControl.ItemsPanel>
									<ItemsControl.ItemTemplate>
										<DataTemplate>
											<CheckBox Content="{Binding ClassName}"
                                                      IsChecked="{Binding IsSelected}"
                                                      Margin="6,4" Padding="4,0"
                                                      Cursor="Hand"/>
										</DataTemplate>
									</ItemsControl.ItemTemplate>
								</ItemsControl>
							</ScrollViewer>
						</Border>

						<StackPanel Orientation="Horizontal" Margin="0,0,0,8">
							<Button Content="✓ Tüm Sınıfları Seç"
                                    Command="{Binding SelectAllClassesCommand}"
                                    Padding="10,4" Margin="0,0,8,0"
                                    Background="#E0E7FF" Foreground="#3730A3"
                                    BorderThickness="0" Cursor="Hand" FontSize="11"/>
							<Button Content="✕ Sınıf Filtresini Temizle"
                                    Command="{Binding ClearClassFilterCommand}"
                                    Padding="10,4" Margin="0,0,16,0"
                                    Background="#FEE2E2" Foreground="#991B1B"
                                    BorderThickness="0" Cursor="Hand" FontSize="11"/>

							<Button Content="✓ Filtredeki Tüm Öğrencileri Seç"
                                    Command="{Binding SelectAllFilteredCommand}"
                                    Padding="10,4" Margin="0,0,8,0"
                                    Background="#D1FAE5" Foreground="#064E3B"
                                    BorderThickness="0" Cursor="Hand" FontSize="11" FontWeight="SemiBold"/>
							<Button Content="✕ Öğrenci Seçimini Temizle"
                                    Command="{Binding DeselectAllFilteredCommand}"
                                    Padding="10,4"
                                    Background="#FEE2E2" Foreground="#991B1B"
                                    BorderThickness="0" Cursor="Hand" FontSize="11" FontWeight="SemiBold"/>
						</StackPanel>

						<Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6" Height="220">
							<ScrollViewer VerticalScrollBarVisibility="Auto" Padding="4">
								<ItemsControl ItemsSource="{Binding FilteredStudents}">
									<ItemsControl.ItemTemplate>
										<DataTemplate>
											<CheckBox IsChecked="{Binding IsSelected}" Margin="8,6" Cursor="Hand">
												<TextBlock FontSize="14">
													<Run Text="{Binding StudentNumber}" FontWeight="SemiBold" Foreground="{StaticResource PrimaryBrush}"/>
													<Run Text=" - "/>
													<Run Text="{Binding FullName}"/>
													<Run Text=" (" Foreground="{StaticResource TextSecondaryBrush}"/>
													<Run Text="{Binding ClassName}" Foreground="{StaticResource TextSecondaryBrush}"/>
													<Run Text=")" Foreground="{StaticResource TextSecondaryBrush}"/>
												</TextBlock>
											</CheckBox>
										</DataTemplate>
									</ItemsControl.ItemTemplate>
								</ItemsControl>
							</ScrollViewer>
						</Border>
					</StackPanel>
				</Border>

				<StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,16,0,0">
					<Button Content="💯 100 Puana Eşitle"
                            Command="{Binding DistributePointsTo100Command}"
                            Background="#F3F4F6"
                            Foreground="{StaticResource PrimaryBrush}"
                            Padding="12,6"
                            BorderThickness="1"
                            BorderBrush="{StaticResource PrimaryBrush}"
                            Cursor="Hand"
                            FontWeight="SemiBold"
                            ToolTip="Toplam puanı 100 olacak şekilde tüm sorulara eşit dağıtır."
                            Width="180">
						<Button.Resources>
							<Style TargetType="Border">
								<Setter Property="CornerRadius" Value="4"/>
							</Style>
						</Button.Resources>
					</Button>
				</StackPanel>

				<ItemsControl ItemsSource="{Binding Questions}">
					<ItemsControl.ItemTemplate>
						<DataTemplate>
							<Border Style="{StaticResource CardStyle}" Padding="16" Margin="0,16,0,0">
								<StackPanel>
									<Grid Margin="0,0,0,12">
										<Grid.ColumnDefinitions>
											<ColumnDefinition Width="Auto"/>
											<ColumnDefinition Width="16"/>
											<ColumnDefinition Width="140"/>
											<ColumnDefinition Width="16"/>
											<ColumnDefinition Width="Auto"/>
											<ColumnDefinition Width="*"/>
											<ColumnDefinition Width="Auto"/>
											<ColumnDefinition Width="Auto"/>
											<ColumnDefinition Width="Auto"/>
										</Grid.ColumnDefinitions>

										<TextBlock Grid.Column="0" VerticalAlignment="Center"
                                                   FontSize="16" FontWeight="Bold"
                                                   Foreground="{StaticResource PrimaryBrush}">
											<Run Text="Soru "/>
											<Run Text="{Binding QuestionNumber}"/>
										</TextBlock>

										<ComboBox Grid.Column="2"
                                                  ItemsSource="{Binding Source={StaticResource QuestionTypeValues}}"
                                                  SelectedItem="{Binding Type}"
                                                  Padding="8,4" VerticalAlignment="Center">
											<ComboBox.ItemTemplate>
												<DataTemplate>
													<TextBlock>
														<TextBlock.Style>
															<Style TargetType="TextBlock">
																<Setter Property="Text" Value="{Binding}"/>
																<Style.Triggers>
																	<DataTrigger Binding="{Binding}" Value="MultipleChoice">
																		<Setter Property="Text" Value="📝 Test"/>
																	</DataTrigger>
																	<DataTrigger Binding="{Binding}" Value="OpenEnded">
																		<Setter Property="Text" Value="✏ Klasik"/>
																	</DataTrigger>
																</Style.Triggers>
															</Style>
														</TextBlock.Style>
													</TextBlock>
												</DataTemplate>
											</ComboBox.ItemTemplate>
										</ComboBox>

										<TextBlock Grid.Column="4" Text="Puan:"
                                                   VerticalAlignment="Center" FontWeight="SemiBold"/>
										<TextBox Grid.Column="5"
                                                 Text="{Binding MaxPoints, UpdateSourceTrigger=PropertyChanged}"
                                                 Width="60" Padding="6,4"
                                                 VerticalAlignment="Center"
                                                 Margin="6,0,0,0"
                                                 HorizontalAlignment="Left"/>

										<StackPanel Grid.Column="6" Orientation="Horizontal" Margin="0,0,8,0">
											<Button Content="↑"
                                                    Command="{Binding DataContext.MoveQuestionUpCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    Background="#F3F4F6"
                                                    Foreground="{StaticResource TextSecondaryBrush}"
                                                    BorderThickness="0"
                                                    Padding="8,4" Margin="0,0,4,0"
                                                    Cursor="Hand" ToolTip="YUKARI TAŞI"/>
											<Button Content="↓"
                                                    Command="{Binding DataContext.MoveQuestionDownCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    Background="#F3F4F6"
                                                    Foreground="{StaticResource TextSecondaryBrush}"
                                                    BorderThickness="0"
                                                    Padding="8,4"
                                                    Cursor="Hand" ToolTip="AŞAĞI TAŞI"/>
										</StackPanel>

										<Button Grid.Column="8"
                                                Content="✕ Sil"
                                                Command="{Binding DataContext.RemoveQuestionCommand,
                                                          RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                Foreground="{StaticResource DangerBrush}"
                                                Background="Transparent"
                                                BorderBrush="{StaticResource DangerBrush}"
                                                BorderThickness="1"
                                                Padding="10,4"
                                                Cursor="Hand"/>
									</Grid>

									<TextBlock Text="Soru Metni" FontWeight="SemiBold" Margin="0,0,0,4"/>
									<TextBox Text="{Binding QuestionText, UpdateSourceTrigger=PropertyChanged}"
                                             AcceptsReturn="True"
                                             TextWrapping="Wrap"
                                             MinHeight="60"
                                             Padding="8,6"
                                             Margin="0,0,0,12"/>

									<StackPanel Visibility="{Binding IsMultipleChoice, Converter={StaticResource BoolToVisibility}}">
										<TextBlock Text="Şıklar" FontWeight="SemiBold" Margin="0,0,0,6"/>

										<Grid Margin="0,0,0,4">
											<Grid.ColumnDefinitions>
												<ColumnDefinition Width="30"/>
												<ColumnDefinition Width="*"/>
												<ColumnDefinition Width="10"/>
												<ColumnDefinition Width="30"/>
												<ColumnDefinition Width="*"/>
											</Grid.ColumnDefinitions>
											<TextBlock Grid.Column="0" Text="A)" VerticalAlignment="Center"
                                                       FontWeight="Bold"/>
											<TextBox Grid.Column="1"
                                                     Text="{Binding OptionA, UpdateSourceTrigger=PropertyChanged}"
                                                     Padding="6,4"/>
											<TextBlock Grid.Column="3" Text="B)" VerticalAlignment="Center"
                                                       FontWeight="Bold"/>
											<TextBox Grid.Column="4"
                                                     Text="{Binding OptionB, UpdateSourceTrigger=PropertyChanged}"
                                                     Padding="6,4"/>
										</Grid>

										<Grid Margin="0,0,0,10">
											<Grid.ColumnDefinitions>
												<ColumnDefinition Width="30"/>
												<ColumnDefinition Width="*"/>
												<ColumnDefinition Width="10"/>
												<ColumnDefinition Width="30"/>
												<ColumnDefinition Width="*"/>
											</Grid.ColumnDefinitions>
											<TextBlock Grid.Column="0" Text="C)" VerticalAlignment="Center"
                                                       FontWeight="Bold"/>
											<TextBox Grid.Column="1"
                                                     Text="{Binding OptionC, UpdateSourceTrigger=PropertyChanged}"
                                                     Padding="6,4"/>
											<TextBlock Grid.Column="3" Text="D)" VerticalAlignment="Center"
                                                       FontWeight="Bold"/>
											<TextBox Grid.Column="4"
                                                     Text="{Binding OptionD, UpdateSourceTrigger=PropertyChanged}"
                                                     Padding="6,4"/>
										</Grid>

										<Grid Margin="0,0,0,10">
											<Grid.ColumnDefinitions>
												<ColumnDefinition Width="30"/>
												<ColumnDefinition Width="*"/>
												<ColumnDefinition Width="10"/>
												<ColumnDefinition Width="30"/>
												<ColumnDefinition Width="*"/>
											</Grid.ColumnDefinitions>
											<TextBlock Grid.Column="0" Text="E)" VerticalAlignment="Center"
                                                       FontWeight="Bold"/>
											<TextBox Grid.Column="1"
                                                     Text="{Binding OptionE, UpdateSourceTrigger=PropertyChanged}"
                                                     Padding="6,4"/>
										</Grid>

										<TextBlock Text="Doğru Şık" FontWeight="SemiBold" Margin="0,0,0,4"/>
										<StackPanel Orientation="Horizontal" Margin="0,0,0,12">
											<RadioButton Content="A" Margin="0,0,16,0" FontWeight="Bold"
                                                         IsChecked="{Binding CorrectOption,
                                                             Converter={StaticResource EnumEquals},
                                                             ConverterParameter=A}"/>
											<RadioButton Content="B" Margin="0,0,16,0" FontWeight="Bold"
                                                         IsChecked="{Binding CorrectOption,
                                                             Converter={StaticResource EnumEquals},
                                                             ConverterParameter=B}"/>
											<RadioButton Content="C" Margin="0,0,16,0" FontWeight="Bold"
                                                         IsChecked="{Binding CorrectOption,
                                                             Converter={StaticResource EnumEquals},
                                                             ConverterParameter=C}"/>
											<RadioButton Content="D" Margin="0,0,16,0" FontWeight="Bold"
                                                         IsChecked="{Binding CorrectOption,
                                                             Converter={StaticResource EnumEquals},
                                                             ConverterParameter=D}"/>
											<RadioButton Content="E" Margin="0,0,16,0" FontWeight="Bold"
                                                         IsChecked="{Binding CorrectOption,
                                                             Converter={StaticResource EnumEquals},
                                                             ConverterParameter=E}"/>
										</StackPanel>
									</StackPanel>

									<StackPanel Visibility="{Binding IsOpenEnded, Converter={StaticResource BoolToVisibility}}">
										<TextBlock Text="Cevap Anahtarı / Notlandırma Rehberi"
                                                   FontWeight="SemiBold" Margin="0,0,0,4"/>
										<TextBox Text="{Binding AnswerKey, UpdateSourceTrigger=PropertyChanged}"
                                                 AcceptsReturn="True"
                                                 TextWrapping="Wrap"
                                                 MinHeight="60"
                                                 Padding="8,6"
                                                 Margin="0,0,0,12"/>
									</StackPanel>

                                    <!-- Yeni: Öğrenim Çıktıları (ÖÇ) seçimi - multi-select with filter and checkboxes -->
                                    <TextBlock Text="Öğrenim Çıktıları (ÖÇ)" FontWeight="SemiBold" Margin="12,12,0,4"/>
									<Grid Margin="0,0,0,8">
										<Grid.RowDefinitions>
											<RowDefinition Height="Auto"/>
											<RowDefinition Height="*"/>
										</Grid.RowDefinitions>

										<TextBox x:Name="LoFilterTextBox" Grid.Row="0" Margin="0,0,0,8" Padding="8,6" TextChanged="LoFilterTextBox_TextChanged" Tag="{Binding ElementName=LoListBox}" />

										<Grid Grid.Row="1">
											<Grid.ColumnDefinitions>
												<ColumnDefinition Width="*"/>
												<ColumnDefinition Width="Auto"/>
											</Grid.ColumnDefinitions>

											<!-- Çoklu seçime izin veren ListBox -->
											<ListBox x:Name="LoListBox" Grid.Column="0" ItemsSource="{Binding AvailableLearningOutcomes}" SelectionMode="Extended" Padding="6" MinHeight="120">
												<ListBox.ItemTemplate>
													<DataTemplate>
														<CheckBox Checked="LoCheckBox_Checked" Unchecked="LoCheckBox_Unchecked" Padding="6">
															<CheckBox.IsChecked>
																<MultiBinding Converter="{StaticResource ContainsLoConverter}" Mode="OneWay">
																	<Binding Path="DataContext.SelectedLearningOutcomes" ElementName="LoListBox" />
																	<Binding />
																</MultiBinding>
															</CheckBox.IsChecked>
															<CheckBox.Content>
																<StackPanel>
																	<TextBlock FontWeight="Bold" Text="{Binding Code}"/>
																	<TextBlock Text="{Binding Name}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/>
																</StackPanel>
															</CheckBox.Content>
														</CheckBox>
													</DataTemplate>
												</ListBox.ItemTemplate>
											</ListBox>

											<StackPanel Grid.Column="1" Orientation="Vertical" VerticalAlignment="Top" Margin="8,0,0,0">
												<Button Content="+ Ekle" Click="AddSelectedLearningOutcomes_Click" Tag="{Binding ElementName=LoListBox}" Background="{StaticResource SuccessBrush}" Foreground="White" Padding="12,6" BorderThickness="0" Cursor="Hand"/>
												<Button Content="Seçiliyi Kaldır" Click="RemoveSelectedLearningOutcomes_Click" Tag="{Binding ElementName=LoListBox}" Background="Transparent" Foreground="{StaticResource DangerBrush}" BorderBrush="{StaticResource DangerBrush}" BorderThickness="1" Padding="8,4" Margin="0,8,0,0" Cursor="Hand"/>
											</StackPanel>
										</Grid>
									</Grid>

									<ItemsControl ItemsSource="{Binding SelectedLearningOutcomes}">
										<ItemsControl.ItemsPanel>
											<ItemsPanelTemplate>
												<WrapPanel/>
											</ItemsPanelTemplate>
										</ItemsControl.ItemsPanel>
										<ItemsControl.ItemTemplate>
											<DataTemplate>
												<Border Background="#DBEAFE" CornerRadius="4"
                                                        Padding="8,4" Margin="0,0,6,6">
													<StackPanel Orientation="Horizontal">
														<TextBlock Foreground="#1E3A8A" FontSize="12"
                                                                   VerticalAlignment="Center">
															<Run Text="{Binding Code}"/>
															<Run Text=" — "/>
															<Run Text="{Binding Name}"/>
														</TextBlock>
														<Button Content="×"
                                                                Command="{Binding DataContext.RemoveLearningOutcomeCommand,
                                                                          RelativeSource={RelativeSource AncestorType=Border, AncestorLevel=2}}"
                                                                CommandParameter="{Binding}"
                                                                Background="Transparent"
                                                                BorderThickness="0"
                                                                Foreground="#1E3A8A"
                                                                Margin="6,0,0,0"
                                                                Padding="2,0"
                                                                Cursor="Hand"
                                                                FontWeight="Bold"/>
													</StackPanel>
												</Border>
											</DataTemplate>
										</ItemsControl.ItemTemplate>
									</ItemsControl>
								</StackPanel>
							</Border>
						</DataTemplate>
					</ItemsControl.ItemTemplate>
				</ItemsControl>

				<Border Style="{StaticResource CardStyle}"
                        Visibility="{Binding Questions.Count, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}" Margin="0,16,0,0">
					<TextBlock Text="Henüz soru eklenmedi. Alt kısımdan '+ Soru Ekle' butonuna tıklayarak başlayın."
                               HorizontalAlignment="Center"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               FontStyle="Italic"
                               Padding="20"/>
				</Border>
			</StackPanel>
		</ScrollViewer>

		<Border Grid.Row="2" Background="White" BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,1,0,0" Padding="0,12,0,0" Margin="0,12,0,0">
			<Grid>
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="Auto"/>
					<ColumnDefinition Width="*"/>
					<ColumnDefinition Width="Auto"/>
				</Grid.ColumnDefinitions>

				<Button Grid.Column="0"
                        Content="+ Soru Ekle"
                        Command="{Binding AddQuestionCommand}"
                        Background="{StaticResource PrimaryBrush}"
                        Foreground="White"
                        Padding="16,8"
                        BorderThickness="0"
                        VerticalAlignment="Center"
                        Cursor="Hand"
                        Margin="0,0,16,0">
					<Button.Resources>
						<Style TargetType="Border">
							<Setter Property="CornerRadius" Value="4"/>
						</Style>
					</Button.Resources>
				</Button>

				<StackPanel Grid.Column="1" VerticalAlignment="Center">
					<Border Background="#FEE2E2"
                            BorderBrush="{StaticResource DangerBrush}" BorderThickness="1"
                            CornerRadius="4" Padding="12,8"
                            Visibility="{Binding ErrorMessage, Converter={StaticResource BoolToVisibility}}">
						<TextBlock Text="{Binding ErrorMessage}"
                                   Foreground="#991B1B" TextWrapping="Wrap"/>
					</Border>
					<Border Background="#D1FAE5"
                            BorderBrush="{StaticResource SuccessBrush}" BorderThickness="1"
                            CornerRadius="4" Padding="12,8"
                            Visibility="{Binding SuccessMessage, Converter={StaticResource BoolToVisibility}}">
						<TextBlock Text="{Binding SuccessMessage}"
                                   Foreground="#064E3B" TextWrapping="Wrap"/>
					</Border>
				</StackPanel>

				<Button Grid.Column="2"
                        Content="💾 Sınavı Kaydet"
                        Command="{Binding SaveCommand}"
                        IsEnabled="{Binding IsSaving, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}"
                        Background="{StaticResource PrimaryBrush}"
                        Foreground="White"
                        Padding="24,12"
                        FontSize="14" FontWeight="SemiBold"
                        BorderThickness="0"
                        Cursor="Hand"
                        Margin="16,0,0,0"/>
			</Grid>
		</Border>
	</Grid>
</UserControl>