<UserControl x:Class="EduAnalytics.UI.Views.ExamCreateView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:EduAnalytics.UI.ViewModels"
             xmlns:enums="clr-namespace:EduAnalytics.Core.Enums;assembly=EduAnalytics.Core"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             d:DataContext="{d:DesignInstance Type=vm:ExamCreateViewModel}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             xmlns:conv="clr-namespace:EduAnalytics.UI.Converters"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006">

    <UserControl.Resources>
        <ObjectDataProvider x:Key="QuestionTypeValues"
                            MethodName="GetValues" ObjectType="{x:Type sys:Enum}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="enums:QuestionType"/>
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>
        <Style x:Key="OptionLabelStyle" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
        </Style>

        <Style x:Key="MiniButtonStyle" TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="Yeni Sınav Oluştur" Style="{StaticResource HeadingStyle}"/>
            <TextBlock Text="Karma sınav yapabilirsiniz: test ve klasik sorular bir arada."
                       Style="{StaticResource PageSubtitleStyle}"/>
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,0,8,0">
            <StackPanel>
                <!-- Sınav Bilgileri -->
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="Sınav Bilgileri" Style="{StaticResource CardHeaderStyle}"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Ders" Style="{StaticResource LabelStyle}"/>
                            <ComboBox Grid.Row="1" Grid.Column="0"
                                      ItemsSource="{Binding Courses}"
                                      SelectedItem="{Binding SelectedCourse}"
                                      DisplayMemberPath="Name"
                                      Margin="0,0,0,16"/>

                            <TextBlock Grid.Row="0" Grid.Column="2" Text="Sınav Tarihi" Style="{StaticResource LabelStyle}"/>
                            <DatePicker Grid.Row="1" Grid.Column="2"
                                        SelectedDate="{Binding ExamDate}"
                                        Margin="0,0,0,16"/>

                            <TextBlock Grid.Row="2" Grid.ColumnSpan="3" Text="Sınav Başlığı / Konusu" Style="{StaticResource LabelStyle}"/>
                            <TextBox Grid.Row="3" Grid.ColumnSpan="3"
                                     Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Sınav Ayarları -->
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="Sınav Ayarları" Style="{StaticResource CardHeaderStyle}"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Sınav Tipi" Style="{StaticResource LabelStyle}"/>
                            <ComboBox Grid.Row="1" Grid.Column="0"
                                      SelectedItem="{Binding ExamType}">
                                <ComboBox.Items>
                                    <x:Static Member="enums:ExamType.Quiz"/>
                                    <x:Static Member="enums:ExamType.Midterm"/>
                                    <x:Static Member="enums:ExamType.Final"/>
                                    <x:Static Member="enums:ExamType.MakeUp"/>
                                </ComboBox.Items>
                            </ComboBox>

                            <TextBlock Grid.Row="0" Grid.Column="2" Text="Süre (dakika)" Style="{StaticResource LabelStyle}"/>
                            <TextBox Grid.Row="1" Grid.Column="2"
                                     Text="{Binding DurationMinutes, UpdateSourceTrigger=PropertyChanged}"/>

                            <TextBlock Grid.Row="0" Grid.Column="4" Text="Kitapçık" Style="{StaticResource LabelStyle}"/>
                            <ComboBox Grid.Row="1" Grid.Column="4"
                                      SelectedItem="{Binding BookletCount}"
                                      Width="80">
                                <ComboBox.Items>
                                    <sys:Int32>1</sys:Int32>
                                    <sys:Int32>2</sys:Int32>
                                    <sys:Int32>3</sys:Int32>
                                    <sys:Int32>4</sys:Int32>
                                </ComboBox.Items>
                            </ComboBox>

                            <CheckBox Grid.Row="1" Grid.Column="6"
                                      IsChecked="{Binding ShuffleOptions}"
                                      Content="Şıkları karıştır"
                                      VerticalAlignment="Center"/>
                        </Grid>

                        <TextBlock Margin="0,14,0,0"
                                   Text="Vize seçilirse soru havuzu Hafta 7'ye kadar olan ÖÇ'lerle sınırlanabilir. Kitapçık sayısı 1'den fazla olunca sorular her kitapçıkta farklı sırayla çıkar."
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   FontSize="11"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <!-- Öğrenci Seçimi -->
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="Sınava Girecek Öğrenciler" Style="{StaticResource CardHeaderStyle}"/>
                        <TextBlock Text="Birden fazla bölüm/sınıf seçebilirsiniz (alttan alan, yükseltme veya ortak ders öğrencileri)."
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   FontSize="12"
                                   Margin="0,-8,0,12"/>

                        <TextBlock Text="Sınıf / Bölüm Filtresi" Style="{StaticResource LabelStyle}"/>
                        <Border BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="6"
                                MaxHeight="100"
                                Background="{StaticResource PageBgBrush}"
                                Margin="0,0,0,10">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="8">
                                <ItemsControl ItemsSource="{Binding ClassFilters}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <CheckBox Content="{Binding ClassName}"
                                                      IsChecked="{Binding IsSelected}"
                                                      Margin="6,4"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Border>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <Button Content="Tüm Sınıfları Seç"
                                    Command="{Binding SelectAllClassesCommand}"
                                    Style="{StaticResource MiniButtonStyle}"/>
                            <Button Content="Sınıf Filtresini Temizle"
                                    Command="{Binding ClearClassFilterCommand}"
                                    Style="{StaticResource MiniButtonStyle}"/>
                            <Border Width="1" Background="{StaticResource BorderBrush}" Margin="6,2,12,2"/>
                            <Button Content="Filtredeki Tüm Öğrencileri Seç"
                                    Command="{Binding SelectAllFilteredCommand}"
                                    Style="{StaticResource MiniButtonStyle}"/>
                            <Button Content="Öğrenci Seçimini Temizle"
                                    Command="{Binding DeselectAllFilteredCommand}"
                                    Style="{StaticResource MiniButtonStyle}"/>
                        </StackPanel>

                        <Border BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Height="220"
                                Background="{StaticResource CardBgBrush}">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="6">
                                <ItemsControl ItemsSource="{Binding FilteredStudents}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <CheckBox IsChecked="{Binding IsSelected}" Margin="8,5">
                                                <TextBlock FontSize="13">
                                                    <Run Text="{Binding StudentNumber}" FontWeight="SemiBold" Foreground="{StaticResource PrimaryBrush}"/>
                                                    <Run Text="  ·  "/>
                                                    <Run Text="{Binding FullName}"/>
                                                    <Run Text="  ("/><Run Text="{Binding ClassName}" Foreground="{StaticResource TextSecondaryBrush}"/><Run Text=")"/>
                                                </TextBlock>
                                            </CheckBox>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- Soru Listesi Aksiyonu -->
                <StackPanel Orientation="Horizontal" Margin="0,4,0,8">
                    <Button Content="100 Puana Eşitle"
                            Command="{Binding DistributePointsTo100Command}"
                            Style="{StaticResource SecondaryButtonStyle}"
                            ToolTip="Toplam puanı 100 olacak şekilde tüm sorulara eşit dağıtır."/>
                </StackPanel>

                <!-- Sorular -->
                <ItemsControl ItemsSource="{Binding Questions}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource CardStyle}">
                                <StackPanel>
                                    <Grid Margin="0,0,0,14">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="16"/>
                                            <ColumnDefinition Width="160"/>
                                            <ColumnDefinition Width="16"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="6"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0"
                                                   VerticalAlignment="Center"
                                                   FontSize="15"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextPrimaryBrush}">
                                            <Run Text="Soru "/>
                                            <Run Text="{Binding QuestionNumber}" Foreground="{StaticResource PrimaryBrush}"/>
                                        </TextBlock>

                                        <ComboBox Grid.Column="2"
                                                  ItemsSource="{Binding Source={StaticResource QuestionTypeValues}}"
                                                  SelectedItem="{Binding Type}"
                                                  VerticalAlignment="Center">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock>
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Text" Value="{Binding}"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding}" Value="MultipleChoice">
                                                                        <Setter Property="Text" Value="Test"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding}" Value="OpenEnded">
                                                                        <Setter Property="Text" Value="Klasik"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>

                                        <TextBlock Grid.Column="4" Text="Puan"
                                                   VerticalAlignment="Center"
                                                   FontWeight="SemiBold"/>
                                        <TextBox Grid.Column="6"
                                                 Text="{Binding MaxPoints, UpdateSourceTrigger=PropertyChanged}"
                                                 Width="80"
                                                 VerticalAlignment="Center"/>

                                        <StackPanel Grid.Column="8" Orientation="Horizontal" Margin="0,0,8,0">
                                            <Button Content="↑"
                                                    Command="{Binding DataContext.MoveQuestionUpCommand,
                                                              RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    Style="{StaticResource SecondaryButtonStyle}"
                                                    Padding="10,4"
                                                    Margin="0,0,4,0"
                                                    ToolTip="Yukarı taşı"/>
                                            <Button Content="↓"
                                                    Command="{Binding DataContext.MoveQuestionDownCommand,
                                                              RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    Style="{StaticResource SecondaryButtonStyle}"
                                                    Padding="10,4"
                                                    ToolTip="Aşağı taşı"/>
                                        </StackPanel>

                                        <Button Grid.Column="9"
                                                Content="Sil"
                                                Command="{Binding DataContext.RemoveQuestionCommand,
                                                          RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource DangerButtonStyle}"
                                                Padding="12,4"
                                                FontSize="12"/>
                                    </Grid>

                                    <TextBlock Text="Soru Metni" Style="{StaticResource LabelStyle}"/>
                                    <TextBox Text="{Binding QuestionText, UpdateSourceTrigger=PropertyChanged}"
                                             AcceptsReturn="True"
                                             TextWrapping="Wrap"
                                             MinHeight="72"
                                             VerticalContentAlignment="Top"
                                             Margin="0,0,0,16"/>

                                    <StackPanel Visibility="{Binding IsMultipleChoice, Converter={StaticResource BoolToVisibility}}">
                                        <TextBlock Text="Şıklar" Style="{StaticResource LabelStyle}"/>

                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="32"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="14"/>
                                                <ColumnDefinition Width="32"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="A" Style="{StaticResource OptionLabelStyle}"/>
                                            <TextBox Grid.Column="1" Text="{Binding OptionA, UpdateSourceTrigger=PropertyChanged}"/>
                                            <TextBlock Grid.Column="3" Text="B" Style="{StaticResource OptionLabelStyle}"/>
                                            <TextBox Grid.Column="4" Text="{Binding OptionB, UpdateSourceTrigger=PropertyChanged}"/>
                                        </Grid>

                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="32"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="14"/>
                                                <ColumnDefinition Width="32"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="C" Style="{StaticResource OptionLabelStyle}"/>
                                            <TextBox Grid.Column="1" Text="{Binding OptionC, UpdateSourceTrigger=PropertyChanged}"/>
                                            <TextBlock Grid.Column="3" Text="D" Style="{StaticResource OptionLabelStyle}"/>
                                            <TextBox Grid.Column="4" Text="{Binding OptionD, UpdateSourceTrigger=PropertyChanged}"/>
                                        </Grid>

                                        <Grid Margin="0,0,0,16">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="32"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="14"/>
                                                <ColumnDefinition Width="32"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="E" Style="{StaticResource OptionLabelStyle}"/>
                                            <TextBox Grid.Column="1" Text="{Binding OptionE, UpdateSourceTrigger=PropertyChanged}"/>
                                        </Grid>

                                        <TextBlock Text="Doğru Şık" Style="{StaticResource LabelStyle}"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                            <RadioButton Content="A" Margin="0,0,20,0" IsChecked="{Binding CorrectOption, Converter={StaticResource EnumEquals}, ConverterParameter=A}"/>
                                            <RadioButton Content="B" Margin="0,0,20,0" IsChecked="{Binding CorrectOption, Converter={StaticResource EnumEquals}, ConverterParameter=B}"/>
                                            <RadioButton Content="C" Margin="0,0,20,0" IsChecked="{Binding CorrectOption, Converter={StaticResource EnumEquals}, ConverterParameter=C}"/>
                                            <RadioButton Content="D" Margin="0,0,20,0" IsChecked="{Binding CorrectOption, Converter={StaticResource EnumEquals}, ConverterParameter=D}"/>
                                            <RadioButton Content="E" IsChecked="{Binding CorrectOption, Converter={StaticResource EnumEquals}, ConverterParameter=E}"/>
                                        </StackPanel>
                                    </StackPanel>

                                    <StackPanel Visibility="{Binding IsOpenEnded, Converter={StaticResource BoolToVisibility}}">
                                        <TextBlock Text="Cevap Anahtarı / Notlandırma Rehberi" Style="{StaticResource LabelStyle}"/>
                                        <TextBox Text="{Binding AnswerKey, UpdateSourceTrigger=PropertyChanged}"
                                                 AcceptsReturn="True"
                                                 TextWrapping="Wrap"
                                                 MinHeight="72"
                                                 VerticalContentAlignment="Top"
                                                 Margin="0,0,0,12"/>
                                    </StackPanel>

                                    <!-- Öğrenim Çıktıları -->
                                    <TextBlock Text="Öğrenim Çıktıları" Style="{StaticResource LabelStyle}" Margin="0,8,0,4"/>

                                    <TextBox Text="{Binding LearningOutcomeFilter, UpdateSourceTrigger=PropertyChanged}"
                                             Margin="0,0,0,8"
                                             ToolTip="Kod veya isim ile filtreleyin"/>

                                    <Border BorderBrush="{StaticResource BorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="6"
                                            MinHeight="120"
                                            Margin="0,0,0,12">
                                        <ListBox ItemsSource="{Binding LearningOutcomesView}"
                                                 Background="Transparent"
                                                 BorderThickness="0"
                                                 Padding="6">
                                            <ListBox.ItemContainerStyle>
                                                <Style TargetType="ListBoxItem">
                                                    <Setter Property="Padding" Value="0"/>
                                                    <Setter Property="Margin" Value="0,2"/>
                                                </Style>
                                            </ListBox.ItemContainerStyle>
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" Padding="6">
                                                        <StackPanel>
                                                            <TextBlock FontWeight="SemiBold"
                                                                       FontSize="12"
                                                                       Foreground="{StaticResource PrimaryBrush}"
                                                                       Text="{Binding Code}"/>
                                                            <TextBlock Text="{Binding Name}"
                                                                       FontSize="12"
                                                                       Foreground="{StaticResource TextPrimaryBrush}"
                                                                       Margin="0,2,0,0"/>
                                                        </StackPanel>
                                                    </CheckBox>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                    </Border>

                                    <ItemsControl ItemsSource="{Binding SelectedLearningOutcomes}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="{StaticResource PrimaryLightBrush}"
                                                        BorderBrush="{StaticResource PrimaryBrush}"
                                                        BorderThickness="1"
                                                        CornerRadius="6"
                                                        Padding="8,5"
                                                        Margin="0,0,6,6">
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <TextBlock Foreground="{StaticResource PrimaryDarkBrush}"
                                                                   FontSize="11"
                                                                   FontWeight="SemiBold">
                                                            <Run Text="{Binding Code}"/>
                                                            <Run Text=" — "/>
                                                            <Run Text="{Binding Name}" FontWeight="Normal" Foreground="{StaticResource TextPrimaryBrush}"/>
                                                        </TextBlock>
                                                        <Button Content="✕"
                                                                Command="{Binding DataContext.RemoveLearningOutcomeCommand,
                                                                          RelativeSource={RelativeSource AncestorType=Border, AncestorLevel=2}}"
                                                                CommandParameter="{Binding}"
                                                                Style="{StaticResource GhostButtonStyle}"
                                                                Foreground="{StaticResource PrimaryDarkBrush}"
                                                                Padding="6,2"
                                                                FontSize="11"
                                                                FontWeight="Bold"
                                                                Margin="8,0,0,0"
                                                                VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Boş durum -->
                <Border Style="{StaticResource CardStyle}"
                        Visibility="{Binding Questions.Count, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}">
                    <TextBlock Text="Henüz soru eklenmedi. Alttaki 'Soru Ekle' butonuna tıklayarak başlayın."
                               HorizontalAlignment="Center"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               Padding="20"/>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,1,0,0"
                Padding="0,14,0,0"
                Margin="0,14,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0"
                        Content="Soru Ekle"
                        Command="{Binding AddQuestionCommand}"
                        Style="{StaticResource SecondaryButtonStyle}"
                        VerticalAlignment="Center"
                        Margin="0,0,16,0"/>

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <Border Style="{StaticResource AlertErrorStyle}"
                            Visibility="{Binding ErrorMessage, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="{Binding ErrorMessage}" Foreground="#991B1B" TextWrapping="Wrap"/>
                    </Border>
                    <Border Style="{StaticResource AlertSuccessStyle}"
                            Visibility="{Binding SuccessMessage, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="{Binding SuccessMessage}" Foreground="#065F46" TextWrapping="Wrap"/>
                    </Border>
                </StackPanel>

                <Button Grid.Column="2"
                        Content="Sınavı Kaydet"
                        Command="{Binding SaveCommand}"
                        IsEnabled="{Binding IsSaving, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Padding="28,12"
                        FontSize="14"
                        Margin="20,0,0,0"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
